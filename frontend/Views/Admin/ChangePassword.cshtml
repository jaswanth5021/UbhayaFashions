@model LadiesDressStore.Web.Models.AdminChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="page-head">
    <div><h1>Change admin password</h1><p>Update the password for your signed-in admin account.</p></div>
</div>

@if (TempData["AdminPasswordSuccess"] is string success)
{
    <div class="alert success">@success</div>
}

<section class="form-card admin-password-panel">
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert error"></div>
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" autocomplete="current-password" required />
        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" autocomplete="new-password" minlength="12" required />
        <label asp-for="ConfirmPassword">Confirm new password</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" minlength="12" required />
        <button class="primary" type="submit">Update password</button>
    </form>
</section>
