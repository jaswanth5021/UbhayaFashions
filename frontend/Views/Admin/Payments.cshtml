@model List<AdminOrderViewModel>
@{ var currentPage = (int)ViewBag.CurrentPage; var pageCount = (int)ViewBag.PageCount; var pageSize = (int)ViewBag.PageSize; var search = ViewBag.Search as string; var selectedStatus = ViewBag.SelectedStatus as string; var selectedPaymentStatus = ViewBag.SelectedPaymentStatus as string; ViewData["Title"] = "Payments"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="page-head"><div><h1>Payments</h1><p>@ViewBag.ItemCount matching payments · Page @currentPage of @pageCount</p></div></div>
<form class="admin-product-filters" asp-action="Payments" method="get">
    <label>Search<input type="search" name="search" value="@search" placeholder="Order number, customer, email" /></label>
    <label>Order status<select name="status"><option value="">All order statuses</option>@foreach (var value in new[] { "Pending", "Confirmed", "Processing", "Packed", "Shipped", "Delivered", "Cancelled" }) { <option value="@value" selected="@(string.Equals(selectedStatus, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
    <label>Payment status<select name="paymentStatus"><option value="">All payment statuses</option>@foreach (var value in new[] { "Pending", "Paid", "Failed", "Refunded" }) { <option value="@value" selected="@(string.Equals(selectedPaymentStatus, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
    <button class="primary" type="submit">Apply filters</button><a class="admin-filter-clear" asp-action="Payments">Clear</a>
</form>
<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Amount</th><th>Payment status</th><th>Order status</th><th>Date</th></tr></thead><tbody>
@foreach(var o in Model)
{
    <tr><td>#@o.Id</td><td>@o.Customer?.Name<small>@o.Customer?.Email</small></td><td>₹@o.TotalAmount.ToString("N0")</td><td><span class="badge">@o.PaymentStatus</span></td><td>@o.Status</td><td>@o.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="6" class="inventory-empty">No payments match these filters.</td></tr> }
</tbody></table></div>
<div class="admin-grid-footer">
    @if (pageCount > 1)
    {
        <nav class="admin-pagination" aria-label="Payment pages">
            @if (currentPage > 1) { <a asp-action="Payments" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus">← Previous</a> } else { <span class="is-disabled" aria-disabled="true">← Previous</span> }
            <div class="admin-page-numbers">@for (var pageNumber = 1; pageNumber <= pageCount; pageNumber++) { if (pageNumber == currentPage) { <span class="is-current" aria-current="page">@pageNumber</span> } else { <a asp-action="Payments" asp-route-page="@pageNumber" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus" aria-label="Page @pageNumber">@pageNumber</a> } }</div>
            @if (currentPage < pageCount) { <a asp-action="Payments" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus">Next →</a> } else { <span class="is-disabled" aria-disabled="true">Next →</span> }
        </nav>
    }
    <form class="admin-page-size" asp-action="Payments" method="get"><input type="hidden" name="search" value="@search"/><input type="hidden" name="status" value="@selectedStatus"/><input type="hidden" name="paymentStatus" value="@selectedPaymentStatus"/><label for="payments-page-size">Rows per page</label><select id="payments-page-size" name="pageSize" onchange="this.form.submit()"><option value="5" selected="@(pageSize == 5)">5</option><option value="10" selected="@(pageSize == 10)">10</option><option value="15" selected="@(pageSize == 15)">15</option><option value="50" selected="@(pageSize == 50)">50</option><option value="100" selected="@(pageSize == 100)">100</option><option value="0" selected="@(pageSize == 0)">All</option></select></form>
</div>
