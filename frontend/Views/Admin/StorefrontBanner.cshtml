@model List<LadiesDressStore.Web.Models.StorefrontBannerViewModel>
@{
    ViewData["Title"] = "Homepage banners";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <div>
        <h1>Homepage banners</h1>
        <p>Upload and manage the images shown in the storefront homepage slider.</p>
    </div>
</div>

@if (TempData["BannerMessage"] is string message)
{
    <p class="alert success" role="status" data-app-notification="success">@message</p>
}
@if (TempData["BannerError"] is string error)
{
    <p class="alert error" role="alert" data-app-notification="warning">@error</p>
}

<section class="admin-card" style="display:block;margin-bottom:24px">
    <h2>Upload banner images</h2>
    <p>Select multiple images at once. JPG, PNG and WEBP are supported; each image must be 10 MB or smaller. Newly uploaded images are active by default.</p>
    <form asp-action="UploadStorefrontBanner" method="post" enctype="multipart/form-data" style="display:grid;gap:16px;margin-top:20px">
        @Html.AntiForgeryToken()
        <label for="banners">Choose banner images</label>
        <input id="banners" name="banners" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple required />
        <button type="submit" class="primary" style="justify-self:start">Upload selected images</button>
    </form>
    <p style="margin-top:14px;font-size:.9rem;color:var(--muted,#666)">The homepage uses active uploaded banners. If none are active, it displays <code>wwwroot/images/dress-banner.jpeg</code>.</p>
</section>

<section class="admin-card" style="display:block">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <div>
            <h2>Uploaded banner gallery</h2>
            <p>Click any thumbnail to preview the full image. Use the checkbox to activate or deactivate a banner.</p>
        </div>
        <span style="font-size:.9rem;color:var(--muted,#666)">@((Model?.Count ?? 0)) image(s)</span>
    </div>

    @if (Model is { Count: > 0 })
    {
        <div class="storefront-banner-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin-top:20px">
            @foreach (var banner in Model.OrderByDescending(item => item.UploadedAtUtc))
            {
                var imageUrl = ImageUrlHelper.Resolve(banner.ImageUrl, Configuration["ApiBaseUrl"]);
                <article style="border:1px solid var(--border,#e5e5e5);border-radius:12px;overflow:hidden;background:var(--card-bg,#fff);opacity:@(banner.IsActive ? "1" : ".78")">
                    <button type="button" class="storefront-banner-preview" data-preview-src="@imageUrl" data-preview-alt="@banner.FileName" aria-label="Preview @banner.FileName" style="display:block;width:100%;padding:0;border:0;background:#f7f5f2;cursor:zoom-in">
                        <img src="@imageUrl" alt="@banner.FileName" loading="lazy" style="display:block;width:100%;height:190px;object-fit:cover" />
                    </button>
                    <div style="padding:14px;display:grid;gap:10px">
                        <strong style="overflow-wrap:anywhere;font-size:.92rem">@banner.FileName</strong>
                        <small style="color:var(--muted,#666)">Uploaded @banner.UploadedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small>
                        <form asp-action="SetStorefrontBannerActive" method="post" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:8px;border-top:1px solid var(--border,#e5e5e5)">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileName" value="@banner.FileName" />
                            <input type="hidden" name="isActive" value="@(!banner.IsActive ? "true" : "false")" />
                            <label for="active-@banner.FileName" style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:600">
                                <input id="active-@banner.FileName" type="checkbox" checked="@banner.IsActive" onchange="this.form.elements['isActive'].value=this.checked?'true':'false';this.form.submit();" />
                                Active
                            </label>
                            <span style="font-size:.8rem;font-weight:700;color:@(banner.IsActive ? "#16803c" : "#8a5a12")">@(banner.IsActive ? "VISIBLE" : "HIDDEN")</span>
                        </form>
                        <form asp-action="DeleteStorefrontBanner" method="post" onsubmit="return confirm('Delete this banner image permanently? This cannot be undone.');" style="margin-top:2px">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileName" value="@banner.FileName" />
                            <button type="submit" class="danger" style="width:100%;padding:9px 12px;border:1px solid #c62828;border-radius:7px;background:#fff;color:#b42318;font-weight:700;cursor:pointer">Delete image</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div style="padding:36px 16px;text-align:center;color:var(--muted,#666)">
            <p style="margin:0 0 8px;font-weight:600">No uploaded banners yet</p>
            <p style="margin:0">The homepage will use the default dress banner until you upload an image.</p>
        </div>
    }
</section>

<dialog id="bannerPreviewDialog" aria-label="Banner image preview" style="border:0;border-radius:14px;padding:12px;max-width:min(94vw,1100px);max-height:92vh;box-shadow:0 18px 70px #0005">
    <div style="display:flex;justify-content:flex-end;margin-bottom:8px">
        <button type="button" id="closeBannerPreview" class="primary" aria-label="Close image preview">Close ✕</button>
    </div>
    <img id="bannerPreviewImage" src="" alt="Banner preview" style="display:block;max-width:88vw;max-height:78vh;object-fit:contain;margin:auto" />
    <p id="bannerPreviewCaption" style="text-align:center;margin:10px 0 0;overflow-wrap:anywhere"></p>
</dialog>

@section Scripts {
    <script>
        (() => {
            const dialog = document.getElementById('bannerPreviewDialog');
            const previewImage = document.getElementById('bannerPreviewImage');
            const caption = document.getElementById('bannerPreviewCaption');
            if (!dialog || !previewImage) return;

            document.querySelectorAll('[data-preview-src]').forEach(button => {
                button.addEventListener('click', () => {
                    previewImage.src = button.dataset.previewSrc;
                    previewImage.alt = button.dataset.previewAlt || 'Banner preview';
                    caption.textContent = previewImage.alt;
                    if (typeof dialog.showModal === 'function') dialog.showModal();
                    else window.open(previewImage.src, '_blank', 'noopener');
                });
            });

            document.getElementById('closeBannerPreview')?.addEventListener('click', () => dialog.close());
            dialog.addEventListener('click', event => {
                if (event.target === dialog) dialog.close();
            });
            dialog.addEventListener('close', () => { previewImage.src = ''; });
        })();
    </script>
}
