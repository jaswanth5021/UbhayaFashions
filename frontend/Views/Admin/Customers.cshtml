@model List<AdminCustomerSummary>
@{ ViewData["Title"] = "Customers"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="page-head"><div><h1>Customers</h1><p>Customer details and order totals, based on customer orders.</p></div></div>
<form class="admin-product-filters" asp-action="Customers" method="get"><label>Search<input type="search" name="search" value="@ViewBag.Search" placeholder="Name, email or phone" /></label><button class="primary" type="submit">Search</button><a class="admin-filter-clear" asp-action="Customers">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Date of birth</th><th>Orders placed</th><th>Last order</th></tr></thead><tbody>
@foreach (var customer in Model) { <tr><td>@customer.Name</td><td>@(string.IsNullOrWhiteSpace(customer.Mobile) ? "—" : customer.Mobile)</td><td>@(string.IsNullOrWhiteSpace(customer.Email) ? "—" : customer.Email)</td><td>@(customer.DateOfBirth?.ToString("dd MMM yyyy") ?? "Not available")</td><td>@customer.OrderCount</td><td>@(customer.LastOrderDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="inventory-empty">No customers with orders were found.</td></tr> }
</tbody></table></div>
<p class="customer-data-note">This list currently includes customers who have placed at least one order. Date of birth appears when present in their profile.</p>
