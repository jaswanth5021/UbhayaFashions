@model List<AdminInventoryItem>
@{ var itemCount = (int)ViewBag.ItemCount; var currentPage = (int)ViewBag.CurrentPage; var pageCount = (int)ViewBag.PageCount; var pageSize = (int)ViewBag.PageSize; var categories = ViewBag.Categories as List<string> ?? []; var sizes = ViewBag.Sizes as List<string> ?? []; var search = ViewBag.Search as string; var selectedCategory = ViewBag.SelectedCategory as string; var selectedSize = ViewBag.SelectedSize as string; var stockStatus = ViewBag.StockStatus as string; ViewData["Title"] = "Inventory"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="page-head"><div><h1>Inventory by size</h1><p>@itemCount matching size entries · Page @currentPage of @pageCount</p></div></div>
<form class="admin-product-filters" asp-action="Inventory" method="get">
    <label>Product
        <input type="search" name="search" value="@search" placeholder="Search product name" />
    </label>
    <label>Category
        <select name="category"><option value="">All categories</option>@foreach (var value in categories) { <option value="@value" selected="@(string.Equals(selectedCategory, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select>
    </label>
    <label>Size
        <select name="size"><option value="">All sizes</option>@foreach (var value in sizes) { <option value="@value" selected="@(string.Equals(selectedSize, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select>
    </label>
    <label>Stock
        <select name="stockStatus">
            <option value="">All stock levels</option>
            <option value="out" selected="@(stockStatus == "out")">Out of stock</option>
            <option value="low" selected="@(stockStatus == "low")">Low stock (1–5)</option>
            <option value="in" selected="@(stockStatus == "in")">In stock (6+)</option>
        </select>
    </label>
    <button class="primary" type="submit">Apply filters</button>
    <a class="admin-filter-clear" asp-action="Inventory">Clear</a>
</form>
<div class="inventory-stock-legend" aria-label="Current stock color key">
    <span><i class="stock-legend-swatch stock-legend-in" aria-hidden="true"></i> Green: In stock (6+)</span>
    <span><i class="stock-legend-swatch stock-legend-low" aria-hidden="true"></i> Red: Low or out of stock (0–5)</span>
</div>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Size</th><th>Price</th><th>Current stock</th><th>Adjustment</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr>
        <td><b>@item.Name</b><small>@item.Category</small></td><td><span class="badge">@item.Size</span></td><td>₹@item.Price.ToString("N0")</td>
        <td><span class="stock @(item.Stock <= 5 ? "danger" : "")">@item.Stock</span></td>
        <td><form class="inline-form" asp-action="AdjustStock" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="size" value="@item.Size" /><input type="hidden" name="page" value="@currentPage" /><input type="hidden" name="pageSize" value="@pageSize" /><input type="hidden" name="search" value="@search" /><input type="hidden" name="category" value="@selectedCategory" /><input type="hidden" name="sizeFilter" value="@selectedSize" /><input type="hidden" name="stockStatus" value="@stockStatus" /><input name="quantity" type="number" placeholder="+10 / -2" required /><select name="type"><option>Stock In</option><option>Adjustment</option><option>Return</option><option>Damage</option></select><input name="note" placeholder="Note" /><button class="secondary" type="submit">Update</button></form></td>
    </tr>
}
@if (Model.Count == 0)
{
    <tr><td colspan="5" class="inventory-empty">No inventory entries match these filters.</td></tr>
}
</tbody></table></div>
<div class="admin-grid-footer">
    @if (pageCount > 1)
    {
        <nav class="admin-pagination" aria-label="Inventory pages">
        @if (currentPage > 1) { <a asp-action="Inventory" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-category="@selectedCategory" asp-route-size="@selectedSize" asp-route-stockStatus="@stockStatus">← Previous</a> }
        else { <span class="is-disabled" aria-disabled="true">← Previous</span> }
        <div class="admin-page-numbers">
            @for (var pageNumber = 1; pageNumber <= pageCount; pageNumber++)
            {
                if (pageNumber == currentPage) { <span class="is-current" aria-current="page">@pageNumber</span> }
                else { <a asp-action="Inventory" asp-route-page="@pageNumber" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-category="@selectedCategory" asp-route-size="@selectedSize" asp-route-stockStatus="@stockStatus" aria-label="Page @pageNumber">@pageNumber</a> }
            }
        </div>
        @if (currentPage < pageCount) { <a asp-action="Inventory" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-category="@selectedCategory" asp-route-size="@selectedSize" asp-route-stockStatus="@stockStatus">Next →</a> }
        else { <span class="is-disabled" aria-disabled="true">Next →</span> }
        </nav>
    }
    <form class="admin-page-size" asp-action="Inventory" method="get">
        <input type="hidden" name="search" value="@search" />
        <input type="hidden" name="category" value="@selectedCategory" />
        <input type="hidden" name="size" value="@selectedSize" />
        <input type="hidden" name="stockStatus" value="@stockStatus" />
        <label for="inventory-page-size">Rows per page</label>
        <select id="inventory-page-size" name="pageSize" onchange="this.form.submit()">
            <option value="5" selected="@(pageSize == 5)">5</option>
            <option value="10" selected="@(pageSize == 10)">10</option>
            <option value="15" selected="@(pageSize == 15)">15</option>
            <option value="50" selected="@(pageSize == 50)">50</option>
            <option value="100" selected="@(pageSize == 100)">100</option>
            <option value="0" selected="@(pageSize == 0)">All</option>
        </select>
    </form>
</div>
