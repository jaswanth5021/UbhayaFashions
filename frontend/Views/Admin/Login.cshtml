@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Admin Login - Ubhaya Fashions</title><link rel="stylesheet" href="~/css/pages/admin/base.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/pages/admin/management.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/pages/admin/app.css" asp-append-version="true"/></head><body class="admin-login-page"><div class="admin-login-card"><div class="login-logo">UBHAYA <span>FASHIONS</span></div><h1>Admin login</h1><p>Manage products, stock and orders.</p>@if(ViewBag.Error is not null){<div class="alert error">@ViewBag.Error</div>}<form asp-controller="Admin" asp-action="Login" method="post">@Html.AntiForgeryToken()<label>Email</label><input name="email" type="email" required autocomplete="username"/><label>Password</label><input name="password" type="password" required autocomplete="current-password"/><button type="submit">SIGN IN →</button></form><a class="back-store" href="/">← Back to store</a></div></body></html>
