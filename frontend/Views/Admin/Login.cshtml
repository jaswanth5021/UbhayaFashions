@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Sign in to manage Ubhaya Fashions store operations."/><title>Admin Login - Ubhaya Fashions</title><link rel="stylesheet" href="~/css/pages/admin/base.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/pages/admin/management.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/pages/admin/app.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/pages/shared/notifications.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/pages/shared/api-loader.css" asp-append-version="true"/></head><body class="admin-login-page"><partial name="_ApiLoader" /><div class="admin-login-card"><div class="login-logo">UBHAYA <span>FASHIONS</span></div><h1>Admin login</h1><p>Manage products, stock and orders.</p>@if(TempData["AdminPasswordSuccess"] is string resetSuccess){<div class="alert success" data-app-notification="success">@resetSuccess</div>}@if(ViewBag.Error is not null){<div class="alert error" data-app-notification="error">@ViewBag.Error</div>}<form asp-controller="Admin" asp-action="Login" method="post">@Html.AntiForgeryToken()<label>Email</label><input name="email" type="email" required autocomplete="section-admin username"/><label>Password</label><input name="password" type="password" required autocomplete="section-admin current-password"/><button type="submit">SIGN IN →</button></form><a class="admin-forgot-password" asp-controller="Admin" asp-action="ForgotPassword">Forgot your password?</a><a class="back-store" href="/">← Back to store</a></div><div class="app-notification-stack" id="appNotificationStack" aria-live="polite" aria-relevant="additions"></div><script src="~/js/app-notifications.js" asp-append-version="true"></script></body></html>
