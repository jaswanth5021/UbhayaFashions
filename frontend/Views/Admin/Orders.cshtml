@model List<AdminOrderViewModel>
@{
    var currentPage = (int)ViewBag.CurrentPage;
    var pageCount = (int)ViewBag.PageCount;
    var pageSize = (int)ViewBag.PageSize;
    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedPaymentStatus = ViewBag.SelectedPaymentStatus as string;
    var dateFrom = ViewBag.DateFrom as string;
    var dateTo = ViewBag.DateTo as string;
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="orders-page">
    <div class="orders-heading">
        <div><h1>Orders</h1><p>Track orders, fulfilment and customer purchases in one place.</p></div>
        <span class="orders-result-count">@ViewBag.ItemCount orders found</span>
    </div>
    @if (TempData["DelhiverySuccess"] is string success) { <div class="admin-alert success">@success</div> }
    @if (TempData["DelhiveryError"] is string error) { <div class="admin-alert error">@error</div> }

    <section class="orders-stats" aria-label="Order summary">
        <article class="orders-stat"><span class="orders-stat-icon blue">▤</span><div><small>Total orders</small><strong>@ViewBag.TotalOrders</strong><em>All orders</em></div></article>
        <article class="orders-stat"><span class="orders-stat-icon amber">◷</span><div><small>Pending</small><strong>@ViewBag.PendingOrders</strong><em>Awaiting processing</em></div></article>
        <article class="orders-stat"><span class="orders-stat-icon violet">↗</span><div><small>Shipped</small><strong>@ViewBag.ShippedOrders</strong><em>In transit</em></div></article>
        <article class="orders-stat"><span class="orders-stat-icon green">✓</span><div><small>Delivered</small><strong>@ViewBag.DeliveredOrders</strong><em>Successfully delivered</em></div></article>
    </section>

    <form class="orders-filter-panel" asp-action="Orders" method="get">
        <div class="orders-filter-title"><div><strong>Filter orders</strong><small>Search and narrow down your order list</small></div><a asp-action="Orders">Reset filters</a></div>
        <div class="orders-filter-fields">
            <label class="orders-search">Search<input type="search" name="search" value="@search" placeholder="Order ID, AWB, customer name or email" /></label>
            <label>Order status<select name="status"><option value="">All statuses</option>@foreach (var value in new[] { "Pending", "Confirmed", "Processing", "Packed", "Shipped", "Delivered", "Cancelled" }) { <option value="@value" selected="@(string.Equals(selectedStatus,value,StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
            <label>Payment<select name="paymentStatus"><option value="">All payments</option>@foreach (var value in new[] { "Pending", "Paid", "Failed", "Refund Initiated", "Refunded", "Refund Pending" }) { <option value="@value" selected="@(string.Equals(selectedPaymentStatus,value,StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
            <label>From date<input type="date" name="dateFrom" value="@dateFrom" /></label>
            <label>To date<input type="date" name="dateTo" value="@dateTo" /></label>
            <button class="primary" type="submit">Apply filters</button>
        </div>
    </form>

    <section class="orders-table-card">
        <div class="orders-table-heading"><div><h2>All orders</h2><p>Latest orders appear first. Select an action to manage an order.</p></div></div>
        <div class="table-wrap orders-table-wrap"><table class="orders-modern-table">
            <thead><tr><th>Order ID</th><th>AWB / Shipment</th><th>Customer</th><th>Order status</th><th>Order date</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var o in Model)
            {
                var canCancel = !string.Equals(o.Status,"Cancelled",StringComparison.OrdinalIgnoreCase) && !string.Equals(o.Status,"Delivered",StringComparison.OrdinalIgnoreCase);
                <tr>
                    <td><a class="orders-id-link" asp-action="OrderDetails" asp-route-id="@o.Id">#@o.Id</a><small class="orders-subline">@o.Items.Sum(i=>i.Quantity) item(s) · ₹@o.TotalAmount.ToString("N0")</small></td>
                    <td>@if (!string.IsNullOrWhiteSpace(o.ShippingWaybill)) { <strong class="awb-value">@o.ShippingWaybill</strong><small class="orders-subline">@(string.IsNullOrWhiteSpace(o.ShippingStatus) ? "Shipment created" : o.ShippingStatus)</small> } else { <span class="awb-missing">Not created</span> }</td>
                    <td><strong>@(string.IsNullOrWhiteSpace(o.Customer?.Name) ? "Customer" : o.Customer.Name)</strong><small class="orders-subline">@o.Customer?.Email</small></td>
                    <td><span class="order-status status-@((o.Status??"").ToLowerInvariant().Replace(" ","-"))">@o.Status</span><small class="orders-subline">Payment: @o.PaymentStatus</small></td>
                    <td><strong>@o.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</strong><small class="orders-subline">@o.CreatedDate.ToLocalTime().ToString("hh:mm tt")</small></td>
                    <td>
                        <button type="button" class="orders-manage-button" onclick="document.getElementById('order-manage-@o.Id').showModal()">Manage order</button>
                        <dialog class="orders-manage-dialog" id="order-manage-@o.Id" aria-labelledby="order-manage-title-@o.Id">
                            <div class="orders-dialog-head"><div><span class="orders-dialog-eyebrow">ORDER MANAGEMENT</span><h2 id="order-manage-title-@o.Id">Order #@o.Id</h2><p>Update order details and manage Delhivery fulfilment.</p></div><button type="button" class="orders-dialog-close" aria-label="Close" onclick="this.closest('dialog').close()">×</button></div>
                            <div class="orders-dialog-body">
                                <section class="orders-dialog-section"><h3>Order and payment status</h3>
                                    <form class="orders-update-form" asp-action="UpdateOrder" method="post">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="page" value="@currentPage"/><input type="hidden" name="pageSize" value="@pageSize"/><input type="hidden" name="search" value="@search"/><input type="hidden" name="filterStatus" value="@selectedStatus"/><input type="hidden" name="filterPaymentStatus" value="@selectedPaymentStatus"/>
                                        <div class="orders-dialog-fields"><label>Order status<select name="status">@foreach(var value in new[]{"Pending","Confirmed","Processing","Packed","Shipped","Delivered","Cancelled"}){<option value="@value" selected="@(string.Equals(o.Status,value,StringComparison.OrdinalIgnoreCase))">@value</option>}</select></label><label>Payment status<select name="paymentStatus">@foreach(var value in new[]{"Pending","Paid","Failed","Refund Initiated","Refunded","Refund Pending"}){<option value="@value" selected="@(string.Equals(o.PaymentStatus,value,StringComparison.OrdinalIgnoreCase))">@value</option>}</select></label></div><button class="primary" type="submit">Save changes</button>
                                    </form>
                                </section>
                                <section class="orders-dialog-section"><h3>Delhivery shipment</h3>
                                    @if (!string.IsNullOrWhiteSpace(o.ShippingWaybill)) { <div class="orders-awb-card"><div><small>AWB NUMBER</small><strong>@o.ShippingWaybill</strong></div><span class="orders-shipment-state">@(string.IsNullOrWhiteSpace(o.ShippingStatus) ? "Shipment created" : o.ShippingStatus)</span></div><a class="orders-tracking-link" href="https://www.delhivery.com/track/package/@Uri.EscapeDataString(o.ShippingWaybill)" target="_blank" rel="noopener noreferrer">Track shipment ↗</a> }
                                    else if (!string.Equals(o.Status,"Cancelled",StringComparison.OrdinalIgnoreCase)) {
                                        <form asp-action="CreateDelhiveryShipment" method="post" class="orders-shipment-form">@Html.AntiForgeryToken()<input type="hidden" name="OrderId" value="@o.Id"/>
                                            <div class="orders-dialog-fields"><label>Recipient<input name="RecipientName" value="@o.Customer?.Name" required maxlength="150"/></label><label>Phone<input name="RecipientPhone" value="@o.Customer?.Mobile" required maxlength="20"/></label><label class="orders-field-wide">Address<input name="Address" value="@o.ShippingAddress" required maxlength="500"/></label><label>City<input name="City" required maxlength="100"/></label><label>State<input name="State" required maxlength="100"/></label><label>PIN code<input name="PostalCode" inputmode="numeric" pattern="[0-9]{6}" required maxlength="6"/></label><label>Weight (grams)<input name="WeightGrams" type="number" min="1" max="100000" value="1000" required/></label></div><input type="hidden" name="Country" value="India"/><button class="secondary" type="submit">Create Delhivery shipment</button>
                                        </form>
                                    } else { <p class="orders-dialog-note">This order is cancelled. No new shipment can be created.</p> }
                                </section>
                                @if (canCancel) {
                                    var canCancelShipment = true;
                                    <section class="orders-dialog-cancel"><div><h3>Cancel order</h3><p>@(canCancelShipment ? "This requests Delhivery cancellation for the AWB and automatically initiates a full Razorpay refund for captured prepaid payments." : $"Shipment status is '{o.ShippingStatus}'. Delhivery may reject cancellation if the parcel is no longer eligible for cancellation.")</p></div>
                                        @if (canCancelShipment) { <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Cancel order #@o.Id and request Delhivery cancellation if an AWB exists? Any prepaid refund must be processed separately in Razorpay.')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="page" value="@currentPage"/><input type="hidden" name="pageSize" value="@pageSize"/><input type="hidden" name="search" value="@search"/><input type="hidden" name="filterStatus" value="@selectedStatus"/><input type="hidden" name="filterPaymentStatus" value="@selectedPaymentStatus"/><button class="orders-cancel-button" type="submit">Cancel order</button></form> }
                                        else { <button type="button" class="orders-cancel-button is-disabled" disabled>Cancellation unavailable</button> }
                                    </section>
                                }
                            </div><div class="orders-dialog-footer"><button type="button" class="orders-dialog-done" onclick="this.closest('dialog').close()">Close</button></div>
                        </dialog>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="inventory-empty">No orders match these filters. Try clearing one or more filters.</td></tr> }
            </tbody>
        </table></div>
        <div class="orders-pagination">
            <span>Showing @((Model.Count==0)?0:((currentPage-1)*pageSize+1))–@((currentPage-1)*pageSize+Model.Count) of @ViewBag.ItemCount orders</span>
            @if (pageCount > 1) {
                <nav class="admin-pagination" aria-label="Order pages">
                    @if(currentPage>1){<a asp-action="Orders" asp-route-page="@(currentPage-1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo">←</a>}
                    <span class="orders-page-current">@currentPage / @pageCount</span>
                    @if(currentPage<pageCount){<a asp-action="Orders" asp-route-page="@(currentPage+1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus" asp-route-dateFrom="@dateFrom" asp-route-dateTo="@dateTo">→</a>}
                </nav>
            }
            <form class="admin-page-size" asp-action="Orders" method="get"><input type="hidden" name="search" value="@search"/><input type="hidden" name="status" value="@selectedStatus"/><input type="hidden" name="paymentStatus" value="@selectedPaymentStatus"/><input type="hidden" name="dateFrom" value="@dateFrom"/><input type="hidden" name="dateTo" value="@dateTo"/><label for="orders-page-size">Rows</label><select id="orders-page-size" name="pageSize" onchange="this.form.submit()"><option value="5" selected="@(pageSize==5)">5</option><option value="10" selected="@(pageSize==10)">10</option><option value="15" selected="@(pageSize==15)">15</option><option value="50" selected="@(pageSize==50)">50</option><option value="100" selected="@(pageSize==100)">100</option><option value="0" selected="@(pageSize==0)">All</option></select></form>
        </div>
    </section>

    <details class="orders-delhivery-panel">
        <summary><span><strong>Delhivery pickup management</strong><small>Schedule warehouse pickup for generated AWBs</small></span><span class="orders-awb-count">@Model.Count(o=>!string.IsNullOrWhiteSpace(o.ShippingWaybill)) AWB(s) on this page</span></summary>
        <form asp-action="CreateDelhiveryPickupRequest" method="post" class="orders-pickup-form">
            @Html.AntiForgeryToken()
            <label>Pickup date<input type="date" name="pickupDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required/></label>
            <label>Pickup time<input type="time" name="pickupTime" value="10:00" required/></label>
            <label>Expected packages<input type="number" name="expectedPackageCount" value="@Math.Max(1,Model.Count(o=>!string.IsNullOrWhiteSpace(o.ShippingWaybill)))" min="1" max="1000" required/></label>
            <button class="primary" type="submit" @(Model.All(o=>string.IsNullOrWhiteSpace(o.ShippingWaybill))?"disabled":null)>Schedule pickup</button>
            <small>Duplicate active pickup requests may be rejected by Delhivery. Automatic pickup may make manual scheduling unnecessary.</small>
        </form>
    </details>
</div>

<style>
.orders-page{color:#29252a}.orders-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:20px}.orders-heading h1{margin:0;font-size:27px;font-weight:750;letter-spacing:-.6px}.orders-heading p{margin:6px 0 0;color:#817982;font-size:13px}.orders-result-count{padding:8px 12px;border:1px solid #eee7eb;border-radius:9px;background:#fff;color:#716873;font-size:12px;font-weight:650}
.orders-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}.orders-stat{display:flex;align-items:center;gap:13px;min-width:0;padding:17px;border:1px solid #eee9ed;border-radius:13px;background:#fff;box-shadow:0 3px 12px rgba(38,22,31,.035)}.orders-stat-icon{display:grid;place-items:center;flex:0 0 42px;height:42px;border-radius:12px;font-size:22px;font-weight:700}.orders-stat-icon.blue{background:#edf3ff;color:#3268d8}.orders-stat-icon.amber{background:#fff6e5;color:#c58a18}.orders-stat-icon.violet{background:#f2edff;color:#7851c9}.orders-stat-icon.green{background:#eaf8ef;color:#27945a}.orders-stat small,.orders-stat em{display:block;color:#817982;font-size:11px;font-style:normal}.orders-stat strong{display:block;margin:3px 0;font-size:25px;line-height:1.1;color:#28232a}
.orders-filter-panel,.orders-table-card{background:#fff;border:1px solid #eee9ed;border-radius:13px;box-shadow:0 3px 12px rgba(38,22,31,.035);margin-bottom:18px}.orders-filter-panel{padding:17px}.orders-filter-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}.orders-filter-title strong,.orders-filter-title small{display:block}.orders-filter-title small{margin-top:3px;color:#918992;font-size:11px}.orders-filter-title a{color:#771b3c;font-size:12px;font-weight:650;text-decoration:none}.orders-filter-fields{display:grid;grid-template-columns:minmax(210px,2fr) repeat(4,minmax(125px,1fr)) auto;gap:10px;align-items:end}.orders-filter-fields label,.orders-update-form label,.orders-shipment-form label,.orders-pickup-form label{display:grid;gap:6px;color:#625b64;font-size:11px;font-weight:650}.orders-filter-fields input,.orders-filter-fields select,.orders-update-form select,.orders-shipment-form input,.orders-pickup-form input{width:100%;min-width:0;height:38px;padding:0 10px;border:1px solid #e8e1e6;border-radius:8px;background:#fff;color:#383139;font:inherit;font-size:12px}.orders-filter-fields button{height:38px;white-space:nowrap}
.orders-table-card{overflow:visible}.orders-table-heading{padding:17px 18px 13px}.orders-table-heading h2{margin:0;font-size:16px}.orders-table-heading p{margin:4px 0 0;color:#8b838c;font-size:11px}.orders-table-wrap{overflow-x:auto;border-top:1px solid #f0ecef}.orders-modern-table{width:100%;border-collapse:collapse;min-width:850px}.orders-modern-table th{padding:13px 14px;background:#fbfafb;color:#716a73;text-align:left;font-size:10px;font-weight:750;text-transform:uppercase;letter-spacing:.45px;white-space:nowrap}.orders-modern-table td{padding:13px 14px;border-top:1px solid #f1edf0;vertical-align:middle;font-size:12px}.orders-modern-table tbody tr:hover{background:#fdfbfc}.orders-id,.awb-value{color:#3b3039;font-weight:750}.orders-subline{display:block;margin-top:4px;color:#928a93;font-size:10px}.awb-value{font-size:11px;overflow-wrap:anywhere}.awb-missing{color:#aaa1aa;font-size:11px}.order-status{display:inline-flex;padding:5px 9px;border-radius:20px;background:#f2f0f2;color:#6d6570;font-size:10px;font-weight:750;white-space:nowrap}.status-pending{background:#fff4df;color:#a96d0a}.status-confirmed,.status-processing,.status-packed{background:#edf2ff;color:#4569b8}.status-shipped{background:#eaf3ff;color:#2869bd}.status-delivered{background:#e9f7ee;color:#23824c}.status-cancelled{background:#fff0ef;color:#bd4945}.orders-actions{position:relative}.orders-action-menu{position:relative}.orders-action-menu>summary{list-style:none;cursor:pointer;padding:8px 12px;border:1px solid #e8dce2;border-radius:8px;color:#741b3d;font-size:11px;font-weight:700;white-space:nowrap}.orders-action-menu>summary::-webkit-details-marker{display:none}.orders-action-menu[open]>summary{background:#fff7fa}.orders-action-content{position:absolute;z-index:20;right:0;top:38px;width:260px;max-height:65vh;overflow:auto;padding:13px;border:1px solid #eee5e9;border-radius:11px;background:#fff;box-shadow:0 12px 30px rgba(40,20,30,.14)}.orders-update-form{display:grid;gap:9px}.orders-update-form button,.orders-shipment-form button{width:100%;margin-top:3px}.orders-shipment-details{margin-top:12px;padding-top:10px;border-top:1px solid #eee}.orders-shipment-details>summary{cursor:pointer;color:#6e1b3b;font-size:11px;font-weight:700}.orders-shipment-form{display:grid;gap:8px;margin-top:10px}.orders-shipment-form input{height:34px}.orders-cancel-button{width:100%;margin-top:10px;padding:8px;border:1px solid #f1d5d3;border-radius:7px;background:#fff7f6;color:#b3443f;font-size:11px;font-weight:700;cursor:pointer}
.orders-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 17px;color:#827a84;font-size:11px}.orders-pagination .admin-pagination{display:flex;align-items:center;gap:12px}.orders-pagination .admin-pagination a{display:grid;place-items:center;width:29px;height:29px;border:1px solid #e9e3e8;border-radius:7px;color:#6f1939;text-decoration:none}.orders-page-current{font-weight:700;color:#4c424b}.orders-pagination .admin-page-size{display:flex;align-items:center;gap:7px}.orders-pagination .admin-page-size select{padding:5px;border:1px solid #e8e1e6;border-radius:6px}
.orders-delhivery-panel{margin:18px 0;padding:0 16px;border:1px solid #eee5e9;border-radius:12px;background:#fff}.orders-delhivery-panel>summary{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 0;cursor:pointer;list-style:none}.orders-delhivery-panel>summary::-webkit-details-marker{display:none}.orders-delhivery-panel>summary strong,.orders-delhivery-panel>summary small{display:block}.orders-delhivery-panel>summary strong{font-size:13px}.orders-delhivery-panel>summary small{margin-top:3px;color:#8a818a;font-size:11px}.orders-awb-count{color:#761b3c;font-size:11px;font-weight:700}.orders-pickup-form{display:grid;grid-template-columns:repeat(3,minmax(120px,1fr)) auto;gap:10px;align-items:end;padding:0 0 15px}.orders-pickup-form small{grid-column:1/-1;color:#8a818a;font-size:10px}.orders-pickup-form button{height:38px}.admin-alert{padding:12px 16px;border-radius:8px;margin:12px 0}.admin-alert.success{background:#edf7ef}.admin-alert.error{background:#fff0ed}
@@@media(max-width:1050px){.orders-filter-fields{grid-template-columns:repeat(3,minmax(0,1fr))}.orders-search{grid-column:span 2}.orders-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@@media(max-width:650px){.orders-heading{align-items:flex-start;flex-direction:column}.orders-heading h1{font-size:23px}.orders-stats{gap:9px}.orders-stat{padding:12px;gap:9px}.orders-stat-icon{flex-basis:34px;height:34px;font-size:18px}.orders-stat strong{font-size:21px}.orders-filter-panel{padding:13px}.orders-filter-fields{grid-template-columns:1fr 1fr}.orders-search{grid-column:1/-1}.orders-filter-fields button{grid-column:1/-1}.orders-pagination{flex-wrap:wrap}.orders-pagination>span{width:100%}.orders-pickup-form{grid-template-columns:1fr 1fr}.orders-pickup-form button{grid-column:1/-1}.orders-delhivery-panel>summary{align-items:flex-start;flex-direction:column}.orders-action-content{position:fixed;top:20%;left:5%;right:5%;width:auto;max-height:65vh}}
.orders-id-link{display:inline-block;color:#6f1939;font-weight:800;text-decoration:none}.orders-id-link:hover{text-decoration:underline}.orders-action-menu[open]{position:relative}.orders-action-menu[open] .orders-action-content{animation:orders-menu-in .12s ease-out}@@keyframes orders-menu-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}

/* Spacious order-management modal */
.orders-manage-button{padding:9px 13px;border:1px solid #e6d6de;border-radius:8px;background:#fff;color:#741b3d;font-size:11px;font-weight:750;cursor:pointer;white-space:nowrap}.orders-manage-button:hover{background:#fff6f9;border-color:#cda9b8}.orders-manage-dialog{width:min(680px,calc(100vw - 28px));max-width:680px;max-height:min(88vh,820px);padding:0;border:1px solid #eadfe5;border-radius:16px;background:#fff;color:#302832;box-shadow:0 24px 80px rgba(35,18,28,.28);overflow:hidden}.orders-manage-dialog::backdrop{background:rgba(28,17,24,.48);backdrop-filter:blur(3px)}.orders-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;padding:23px 25px 19px;border-bottom:1px solid #f0e9ed;background:#fffafb}.orders-dialog-eyebrow{color:#9b6a7d;font-size:9px;font-weight:800;letter-spacing:1.2px}.orders-dialog-head h2{margin:5px 0 4px;font-size:22px;letter-spacing:-.4px}.orders-dialog-head p{margin:0;color:#8b818a;font-size:12px}.orders-dialog-close{width:34px;height:34px;border:1px solid #eee4e9;border-radius:9px;background:#fff;color:#6f5e68;font-size:23px;line-height:1;cursor:pointer}.orders-dialog-body{max-height:calc(88vh - 145px);overflow-y:auto;padding:20px 25px}.orders-dialog-section{padding:0 0 20px;margin:0 0 19px;border-bottom:1px solid #f0e9ed}.orders-dialog-section h3,.orders-dialog-cancel h3{margin:0 0 13px;font-size:13px;font-weight:800}.orders-dialog-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.orders-dialog-fields .orders-field-wide{grid-column:1/-1}.orders-dialog-fields label{display:grid;gap:6px;color:#625b64;font-size:11px;font-weight:650}.orders-dialog-fields input,.orders-dialog-fields select{width:100%;height:40px;padding:0 11px;border:1px solid #e6dce2;border-radius:8px;background:#fff;color:#332b33;font:inherit;font-size:12px}.orders-update-form,.orders-shipment-form{display:grid;gap:13px}.orders-update-form button,.orders-shipment-form button{min-height:40px}.orders-awb-card{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px;border:1px solid #e9e0e5;border-radius:10px;background:#fcfafb}.orders-awb-card small,.orders-awb-card strong{display:block}.orders-awb-card small{color:#958994;font-size:9px;font-weight:800;letter-spacing:.8px}.orders-awb-card strong{margin-top:5px;color:#641832;font-size:15px;overflow-wrap:anywhere}.orders-shipment-state{padding:6px 10px;border-radius:20px;background:#edf3ff;color:#4167ae;font-size:10px;font-weight:750}.orders-tracking-link{display:inline-block;margin-top:11px;color:#751b3d;font-size:11px;font-weight:750;text-decoration:none}.orders-dialog-note{color:#8b818a;font-size:12px}.orders-dialog-cancel{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:15px;border:1px solid #f0dddd;border-radius:11px;background:#fffafa}.orders-dialog-cancel h3{margin:0 0 5px;color:#9e3434}.orders-dialog-cancel p{max-width:390px;margin:0;color:#817780;font-size:11px;line-height:1.5}.orders-dialog-cancel form{flex:0 0 145px}.orders-dialog-cancel .orders-cancel-button{margin:0;min-height:39px}.orders-cancel-button.is-disabled{opacity:.55;cursor:not-allowed}.orders-dialog-footer{display:flex;justify-content:flex-end;padding:13px 25px;border-top:1px solid #f0e9ed;background:#fff}.orders-dialog-done{padding:9px 18px;border:1px solid #e6dce2;border-radius:8px;background:#fff;color:#655761;font-size:11px;font-weight:700;cursor:pointer}@@media(max-width:600px){.orders-dialog-head{padding:18px}.orders-dialog-body{padding:17px}.orders-dialog-fields{grid-template-columns:1fr}.orders-dialog-fields .orders-field-wide{grid-column:auto}.orders-dialog-cancel{align-items:stretch;flex-direction:column}.orders-dialog-cancel form{flex:auto}.orders-dialog-footer{padding:12px 17px}}
</style>

<script>
document.addEventListener('click',function(event){
    document.querySelectorAll('.orders-action-menu[open]').forEach(function(menu){
        if(!menu.contains(event.target)) menu.open=false;
    });
});
document.addEventListener('keydown',function(event){
    if(event.key==='Escape') document.querySelectorAll('.orders-action-menu[open]').forEach(function(menu){menu.open=false;});
});
document.addEventListener('click',function(event){
    const summary=event.target.closest('.orders-action-menu > summary');
    if(summary){
        const current=summary.parentElement;
        document.querySelectorAll('.orders-action-menu[open]').forEach(function(menu){if(menu!==current)menu.open=false;});
    }
});
</script>
