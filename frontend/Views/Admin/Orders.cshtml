@model List<AdminOrderViewModel>
@{
    var currentPage = (int)ViewBag.CurrentPage;
    var pageCount = (int)ViewBag.PageCount;
    var pageSize = (int)ViewBag.PageSize;
    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedPaymentStatus = ViewBag.SelectedPaymentStatus as string;
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="page-head"><div><h1>Orders</h1><p>@ViewBag.ItemCount matching orders · Page @currentPage of @pageCount</p></div></div>
@if (TempData["DelhiverySuccess"] is string success) { <div class="admin-alert success">@success</div> }
@if (TempData["DelhiveryError"] is string error) { <div class="admin-alert error">@error</div> }
<form class="admin-product-filters" asp-action="Orders" method="get">
    <label>Search<input type="search" name="search" value="@search" placeholder="Order number, customer, email" /></label>
    <label>Order status<select name="status"><option value="">All order statuses</option>@foreach (var value in new[] { "Pending", "Confirmed", "Processing", "Packed", "Shipped", "Delivered", "Cancelled" }) { <option value="@value" selected="@(string.Equals(selectedStatus, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
    <label>Payment status<select name="paymentStatus"><option value="">All payment statuses</option>@foreach (var value in new[] { "Pending", "Paid", "Failed", "Refunded" }) { <option value="@value" selected="@(string.Equals(selectedPaymentStatus, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
    <button class="primary" type="submit">Apply filters</button><a class="admin-filter-clear" asp-action="Orders">Clear</a>
</form>

<section class="dl-unified-panel">
    <div class="dl-unified-heading"><div><h2>Delhivery fulfilment</h2><p>Manage shipment creation and warehouse pickup requests alongside your orders.</p></div><span>@Model.Count(o => !string.IsNullOrWhiteSpace(o.ShippingWaybill)) AWB(s)</span></div>
    <form asp-action="CreateDelhiveryPickupRequest" method="post" class="dl-unified-pickup">
        @Html.AntiForgeryToken()
        <strong>Schedule warehouse pickup</strong>
        <p>Delhivery pickup requests apply to the registered warehouse and can cover multiple ready-to-ship AWBs.</p>
        <label>Pickup date<input type="date" name="pickupDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required /></label>
        <label>Pickup time<input type="time" name="pickupTime" value="10:00" required /></label>
        <label>Expected packages<input type="number" name="expectedPackageCount" value="@Math.Max(1, Model.Count(o => !string.IsNullOrWhiteSpace(o.ShippingWaybill)))" min="1" max="1000" required /></label>
        <button class="primary" type="submit" @(Model.All(o => string.IsNullOrWhiteSpace(o.ShippingWaybill)) ? "disabled" : null)>Check with Delhivery &amp; schedule</button>
        <small>Delhivery rejects a second active pickup request for the same pickup location. If automatic pickup is enabled, manual scheduling is not required.</small>
    </form>
    <div class="dl-unified-list">
    @foreach (var shipmentOrder in Model.OrderByDescending(o => o.CreatedDate))
    {
        <article class="dl-unified-order">
            <div><strong>Order #@shipmentOrder.Id</strong><small>@shipmentOrder.Customer?.Name · @shipmentOrder.Status</small></div>
            <div><strong>@(string.IsNullOrWhiteSpace(shipmentOrder.ShippingWaybill) ? "AWB not created" : shipmentOrder.ShippingStatus)</strong><small>@(string.IsNullOrWhiteSpace(shipmentOrder.ShippingWaybill) ? "Create a shipment below" : "AWB: " + shipmentOrder.ShippingWaybill)</small></div>
            @if (string.IsNullOrWhiteSpace(shipmentOrder.ShippingWaybill) && !string.Equals(shipmentOrder.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            {
                <details><summary>Create Delhivery shipment</summary>
                    <form asp-action="CreateDelhiveryShipment" method="post" class="dl-unified-create">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OrderId" value="@shipmentOrder.Id" />
                        <label>Recipient<input name="RecipientName" value="@shipmentOrder.Customer?.Name" required maxlength="150" /></label>
                        <label>Phone<input name="RecipientPhone" value="@shipmentOrder.Customer?.Mobile" required maxlength="20" /></label>
                        <label class="wide">Address<input name="Address" value="@shipmentOrder.ShippingAddress" required maxlength="500" /></label>
                        <label>City<input name="City" required maxlength="100" /></label>
                        <label>State<input name="State" required maxlength="100" /></label>
                        <label>PIN code<input name="PostalCode" inputmode="numeric" pattern="[0-9]{6}" required maxlength="6" /></label>
                        <label>Weight (grams)<input name="WeightGrams" type="number" min="1" max="100000" value="1000" required /></label>
                        <input type="hidden" name="Country" value="India" />
                        <button class="secondary" type="submit">Create shipment</button>
                    </form>
                </details>
            }
        </article>
    }
    </div>
</section>
<style>
.dl-unified-panel{margin:20px 0;padding:18px;border:1px solid #eadde0;border-radius:14px;background:#fff}
.dl-unified-heading{display:flex;justify-content:space-between;gap:12px;align-items:center}.dl-unified-heading h2{margin:0;color:#6c1531;font-size:18px}.dl-unified-heading p,.dl-unified-pickup p,.dl-unified-pickup small{color:#817777;font-size:12px}.dl-unified-heading span{font-size:12px;font-weight:700;background:#f5eff1;padding:7px 10px;border-radius:20px}
.dl-unified-pickup{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:10px;align-items:end;padding:14px;margin:14px 0;background:#fff9fb;border-radius:10px}.dl-unified-pickup strong,.dl-unified-pickup p,.dl-unified-pickup small{grid-column:1/-1;margin:0}.dl-unified-pickup label,.dl-unified-create label{display:grid;gap:5px;font-size:12px}.dl-unified-pickup input,.dl-unified-create input{width:100%;min-width:0;padding:9px;border:1px solid #e5d9d5;border-radius:7px}.dl-unified-list{display:grid;gap:9px}.dl-unified-order{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:12px;border:1px solid #f0e9e7;border-radius:9px}.dl-unified-order small{display:block;color:#817777;font-size:12px;margin-top:4px}.dl-unified-order details{grid-column:1/-1}.dl-unified-order summary{cursor:pointer;color:#6c1531;font-weight:700}.dl-unified-create{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.dl-unified-create .wide,.dl-unified-create button{grid-column:1/-1}
@@media(max-width:700px){.dl-unified-pickup{grid-template-columns:1fr 1fr}.dl-unified-pickup button{grid-column:1/-1}.dl-unified-create{grid-template-columns:1fr}.dl-unified-create .wide,.dl-unified-create button{grid-column:auto}}
</style>

<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Order status</th><th>Update</th></tr></thead><tbody>
@foreach(var o in Model)
{
    var customerPhone = new string((o.Customer?.Mobile ?? "").Where(char.IsDigit).ToArray());
    if (customerPhone.Length == 10) { customerPhone = "91" + customerPhone; }
    else if (customerPhone.Length == 11 && customerPhone.StartsWith("0")) { customerPhone = "91" + customerPhone[1..]; }
    var customerName = string.IsNullOrWhiteSpace(o.Customer?.Name) ? "Customer" : o.Customer!.Name;
    var whatsappMessage = $"Hello {customerName}, thank you for shopping with UBHAYA FASHIONS! Your order #{o.Id} has been placed successfully. Order total: ₹{o.TotalAmount:N2}. We will keep you updated on your order status.";
    var whatsappUrl = $"https://wa.me/{customerPhone}?text={Uri.EscapeDataString(whatsappMessage)}";
    <tr><td><b>#@o.Id</b><small>@o.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small></td><td>@o.Customer?.Name<small>@o.Customer?.Email</small></td><td>@string.Join(", ",o.Items.Select(i=>$"{i.ProductName} x{i.Quantity}"))</td><td>₹@o.TotalAmount.ToString("N0")</td><td>@o.PaymentStatus</td><td>@o.Status@if(!string.IsNullOrWhiteSpace(o.ShippingWaybill)){<small>AWB: @o.ShippingWaybill</small>}</td><td><form class="order-form" asp-action="UpdateOrder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="page" value="@currentPage"/><input type="hidden" name="pageSize" value="@pageSize"/><input type="hidden" name="search" value="@search"/><input type="hidden" name="filterStatus" value="@selectedStatus"/><input type="hidden" name="filterPaymentStatus" value="@selectedPaymentStatus"/><select name="status"><option selected="@(o.Status=="Pending")">Pending</option><option selected="@(o.Status=="Confirmed")">Confirmed</option><option selected="@(o.Status=="Processing")">Processing</option><option selected="@(o.Status=="Packed")">Packed</option><option selected="@(o.Status=="Shipped")">Shipped</option><option selected="@(o.Status=="Delivered")">Delivered</option><option selected="@(o.Status=="Cancelled")">Cancelled</option></select><select name="paymentStatus"><option selected="@(o.PaymentStatus=="Pending")">Pending</option><option selected="@(o.PaymentStatus=="Paid")">Paid</option><option selected="@(o.PaymentStatus=="Failed")">Failed</option><option selected="@(o.PaymentStatus=="Refunded")">Refunded</option></select><button class="secondary" type="submit">Save</button></form>@if(!string.Equals(o.Status,"Cancelled",StringComparison.OrdinalIgnoreCase) && !string.Equals(o.Status,"Delivered",StringComparison.OrdinalIgnoreCase) && !string.Equals(o.Status,"Shipped",StringComparison.OrdinalIgnoreCase)){<form asp-action="CancelOrder" method="post" onsubmit="return confirm('Cancel order #@o.Id? Delhivery cancellation must be accepted before stock is restored. Any prepaid refund must be processed separately in Razorpay.')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="page" value="@currentPage"/><input type="hidden" name="pageSize" value="@pageSize"/><input type="hidden" name="search" value="@search"/><input type="hidden" name="filterStatus" value="@selectedStatus"/><input type="hidden" name="filterPaymentStatus" value="@selectedPaymentStatus"/><button class="secondary" type="submit">Cancel order</button></form>}</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="inventory-empty">No orders match these filters.</td></tr> }
</tbody></table></div>
<div class="admin-grid-footer">
    @if (pageCount > 1)
    {
        <nav class="admin-pagination" aria-label="Order pages">
            @if (currentPage > 1) { <a asp-action="Orders" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus">← Previous</a> } else { <span class="is-disabled" aria-disabled="true">← Previous</span> }
            <div class="admin-page-numbers">@for (var pageNumber = 1; pageNumber <= pageCount; pageNumber++) { if (pageNumber == currentPage) { <span class="is-current" aria-current="page">@pageNumber</span> } else { <a asp-action="Orders" asp-route-page="@pageNumber" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus" aria-label="Page @pageNumber">@pageNumber</a> } }</div>
            @if (currentPage < pageCount) { <a asp-action="Orders" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus">Next →</a> } else { <span class="is-disabled" aria-disabled="true">Next →</span> }
        </nav>
    }
    <form class="admin-page-size" asp-action="Orders" method="get"><input type="hidden" name="search" value="@search"/><input type="hidden" name="status" value="@selectedStatus"/><input type="hidden" name="paymentStatus" value="@selectedPaymentStatus"/><label for="orders-page-size">Rows per page</label><select id="orders-page-size" name="pageSize" onchange="this.form.submit()"><option value="5" selected="@(pageSize == 5)">5</option><option value="10" selected="@(pageSize == 10)">10</option><option value="15" selected="@(pageSize == 15)">15</option><option value="50" selected="@(pageSize == 50)">50</option><option value="100" selected="@(pageSize == 100)">100</option><option value="0" selected="@(pageSize == 0)">All</option></select></form>
</div>

<style>
.admin-delhivery-create summary{cursor:pointer;font-weight:600;min-width:125px}.admin-delhivery-form{display:grid;gap:8px;min-width:230px;max-width:300px;padding:12px 0}.admin-delhivery-form label{display:grid;gap:4px;font-size:12px}.admin-delhivery-form input{width:100%;min-width:0;padding:7px;border:1px solid #ddd;border-radius:6px}.admin-delhivery-form button{white-space:normal}.admin-alert{padding:12px 16px;border-radius:8px;margin:12px 0}.admin-alert.success{background:#edf7ef}.admin-alert.error{background:#fff0ed}.whatsapp-order-link{display:inline-flex;align-items:center;justify-content:center;padding:8px 10px;border-radius:7px;background:#e9f8ee;color:#176b38;font-weight:600;font-size:12px;text-decoration:none;white-space:nowrap}.whatsapp-order-link:hover{background:#d7f1e0}.whatsapp-missing{color:#777;max-width:120px}
</style>
