@model List<AdminOrderViewModel>
@{ var currentPage = (int)ViewBag.CurrentPage; var pageCount = (int)ViewBag.PageCount; var pageSize = (int)ViewBag.PageSize; var search = ViewBag.Search as string; var selectedStatus = ViewBag.SelectedStatus as string; var selectedPaymentStatus = ViewBag.SelectedPaymentStatus as string; ViewData["Title"] = "Orders"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="page-head"><div><h1>Orders</h1><p>@ViewBag.ItemCount matching orders · Page @currentPage of @pageCount</p></div></div>
@if (TempData["DelhiverySuccess"] is string success) { <div class="admin-alert success">@success</div> }
@if (TempData["DelhiveryError"] is string error) { <div class="admin-alert error">@error</div> }
<form class="admin-product-filters" asp-action="Orders" method="get">
    <label>Search<input type="search" name="search" value="@search" placeholder="Order number, customer, email" /></label>
    <label>Order status<select name="status"><option value="">All order statuses</option>@foreach (var value in new[] { "Pending", "Confirmed", "Processing", "Packed", "Shipped", "Delivered", "Cancelled" }) { <option value="@value" selected="@(string.Equals(selectedStatus, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
    <label>Payment status<select name="paymentStatus"><option value="">All payment statuses</option>@foreach (var value in new[] { "Pending", "Paid", "Failed", "Refunded" }) { <option value="@value" selected="@(string.Equals(selectedPaymentStatus, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label>
    <button class="primary" type="submit">Apply filters</button><a class="admin-filter-clear" asp-action="Orders">Clear</a>
</form>
<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Order status</th><th>Update</th><th>Delhivery</th></tr></thead><tbody>
@foreach(var o in Model)
{
    <tr><td><b>#@o.Id</b><small>@o.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small></td><td>@o.Customer?.Name<small>@o.Customer?.Email</small></td><td>@string.Join(", ",o.Items.Select(i=>$"{i.ProductName} x{i.Quantity}"))</td><td>₹@o.TotalAmount.ToString("N0")</td><td>@o.PaymentStatus</td><td>@o.Status</td><td><form class="order-form" asp-action="UpdateOrder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="page" value="@currentPage"/><input type="hidden" name="pageSize" value="@pageSize"/><input type="hidden" name="search" value="@search"/><input type="hidden" name="filterStatus" value="@selectedStatus"/><input type="hidden" name="filterPaymentStatus" value="@selectedPaymentStatus"/><select name="status"><option selected="@(o.Status=="Pending")">Pending</option><option selected="@(o.Status=="Confirmed")">Confirmed</option><option selected="@(o.Status=="Processing")">Processing</option><option selected="@(o.Status=="Packed")">Packed</option><option selected="@(o.Status=="Shipped")">Shipped</option><option selected="@(o.Status=="Delivered")">Delivered</option><option selected="@(o.Status=="Cancelled")">Cancelled</option></select><select name="paymentStatus"><option selected="@(o.PaymentStatus=="Pending")">Pending</option><option selected="@(o.PaymentStatus=="Paid")">Paid</option><option selected="@(o.PaymentStatus=="Failed")">Failed</option><option selected="@(o.PaymentStatus=="Refunded")">Refunded</option></select><button class="secondary">Save</button></form></td><td>
@if (!string.IsNullOrWhiteSpace(o.ShippingWaybill))
{
    <strong>@o.ShippingStatus</strong><small>AWB: @o.ShippingWaybill</small>
}
else
{
    <details class="admin-delhivery-create">
        <summary>Create shipment</summary>
        <form asp-action="CreateDelhiveryShipment" method="post" class="admin-delhivery-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="OrderId" value="@o.Id" />
            <label>Recipient name<input name="RecipientName" value="@o.Customer?.Name" required maxlength="150" /></label>
            <label>Phone<input name="RecipientPhone" value="@o.Customer?.Mobile" required maxlength="20" /></label>
            <label>Full delivery address<input name="Address" value="@o.ShippingAddress" required maxlength="500" /></label>
            <label>City<input name="City" required maxlength="100" /></label>
            <label>State<input name="State" required maxlength="100" /></label>
            <label>PIN code<input name="PostalCode" inputmode="numeric" pattern="[0-9]{6}" required maxlength="6" /></label>
            <label>Weight (grams)<input name="WeightGrams" type="number" min="1" max="100000" value="500" required /></label>
            <input type="hidden" name="Country" value="India" />
            <button class="secondary" type="submit">Create Delhivery shipment</button>
        </form>
    </details>
}
</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="8" class="inventory-empty">No orders match these filters.</td></tr> }
</tbody></table></div>
<div class="admin-grid-footer">
    @if (pageCount > 1)
    {
        <nav class="admin-pagination" aria-label="Order pages">
            @if (currentPage > 1) { <a asp-action="Orders" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus">← Previous</a> } else { <span class="is-disabled" aria-disabled="true">← Previous</span> }
            <div class="admin-page-numbers">@for (var pageNumber = 1; pageNumber <= pageCount; pageNumber++) { if (pageNumber == currentPage) { <span class="is-current" aria-current="page">@pageNumber</span> } else { <a asp-action="Orders" asp-route-page="@pageNumber" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus" aria-label="Page @pageNumber">@pageNumber</a> } }</div>
            @if (currentPage < pageCount) { <a asp-action="Orders" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-status="@selectedStatus" asp-route-paymentStatus="@selectedPaymentStatus">Next →</a> } else { <span class="is-disabled" aria-disabled="true">Next →</span> }
        </nav>
    }
    <form class="admin-page-size" asp-action="Orders" method="get"><input type="hidden" name="search" value="@search"/><input type="hidden" name="status" value="@selectedStatus"/><input type="hidden" name="paymentStatus" value="@selectedPaymentStatus"/><label for="orders-page-size">Rows per page</label><select id="orders-page-size" name="pageSize" onchange="this.form.submit()"><option value="5" selected="@(pageSize == 5)">5</option><option value="10" selected="@(pageSize == 10)">10</option><option value="15" selected="@(pageSize == 15)">15</option><option value="50" selected="@(pageSize == 50)">50</option><option value="100" selected="@(pageSize == 100)">100</option><option value="0" selected="@(pageSize == 0)">All</option></select></form>
</div>

<style>
.admin-delhivery-create summary{cursor:pointer;font-weight:600;min-width:125px}.admin-delhivery-form{display:grid;gap:8px;min-width:230px;max-width:300px;padding:12px 0}.admin-delhivery-form label{display:grid;gap:4px;font-size:12px}.admin-delhivery-form input{width:100%;min-width:0;padding:7px;border:1px solid #ddd;border-radius:6px}.admin-delhivery-form button{white-space:normal}.admin-alert{padding:12px 16px;border-radius:8px;margin:12px 0}.admin-alert.success{background:#edf7ef}.admin-alert.error{background:#fff0ed}
</style>
