@model AdminDashboardViewModel
@{ ViewData["Title"]="Dashboard"; Layout="~/Views/Shared/_AdminLayout.cshtml"; }
<div class="page-head"><div><h1>Dashboard</h1><p>Overview of your store.</p></div><a class="primary" asp-action="CreateProduct">+ Add product</a></div>
<div class="stats"><div><span>Products</span><strong>@Model.TotalProducts</strong></div><div><span>Orders</span><strong>@Model.TotalOrders</strong></div><div><span>Pending orders</span><strong>@Model.PendingOrders</strong></div><div><span>Low stock</span><strong>@Model.LowStock</strong></div><div><span>Customers</span><strong>@Model.Customers</strong></div><div><span>Revenue</span><strong>₹@Model.Revenue.ToString("N0")</strong></div></div>
<div class="admin-grid"><a class="admin-card" asp-action="Products"><b>Products</b><span>Add, edit, delete and upload images.</span></a><a class="admin-card" asp-action="Inventory"><b>Inventory</b><span>Adjust stock and see stock levels.</span></a><a class="admin-card" asp-action="Orders"><b>Orders</b><span>Update order and payment status.</span></a><a class="admin-card" asp-action="Payments"><b>Payments</b><span>Review payment status against orders.</span></a></div>
