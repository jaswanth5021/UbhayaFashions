@model LadiesDressStore.Web.Models.AdminForgotPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Password Recovery - Ubhaya Fashions</title>
    <link rel="stylesheet" href="~/css/pages/admin/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/app.css" asp-append-version="true" />
</head>
<body class="admin-login-page">
    <div class="admin-login-card">
        <div class="login-logo">UBHAYA <span>FASHIONS</span></div>
        <h1>Reset admin password</h1>
        <p>Enter your admin email. If it belongs to an active admin account, we’ll send a one-time reset link.</p>
        @if (ViewBag.Error is not null) { <div class="alert error">@ViewBag.Error</div> }
        @if (ViewBag.Success is not null) { <div class="alert success">@ViewBag.Success</div> }
        <form asp-controller="Admin" asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <label asp-for="Email">Admin email</label>
            <input asp-for="Email" type="email" required autocomplete="email" />
            <button type="submit">SEND RESET LINK</button>
        </form>
        <a class="back-store" asp-controller="Admin" asp-action="Login">Back to admin login</a>
    </div>
</body>
</html>
