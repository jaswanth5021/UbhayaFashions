@model List<AdminOrderViewModel>
@{
    ViewData["Title"] = "Delhivery Shipments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var search = Context.Request.Query["search"].ToString();
    var orders = Model;
    var manifestedPackageCount = orders.Count(o => !string.IsNullOrWhiteSpace(o.ShippingWaybill));
    var defaultPickupDate = DateTime.Today.ToString("yyyy-MM-dd");
    if (!string.IsNullOrWhiteSpace(search)) {
        orders = orders.Where(o => o.Id.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) || (o.Customer?.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) || (o.Customer?.Mobile?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
    }
}
<div class="page-head"><div><h1>Delhivery shipments</h1><p>Create shipments and review AWB details separately from order management.</p></div><span class="dl-count">@orders.Count orders</span></div>
<form class="admin-product-filters" method="get"><label>Search<input type="search" name="search" value="@search" placeholder="Order number, customer or mobile" /></label><button class="primary" type="submit">Search</button><a class="admin-filter-clear" asp-action="DelhiveryOrders">Clear</a></form>
<form asp-action="CreateDelhiveryPickupRequest" method="post" class="dl-pickup-panel">
    @Html.AntiForgeryToken()
    <div class="dl-pickup-copy"><strong>Schedule Delhivery pickup</strong><span>Submit one pickup request for the packed parcels at your registered pickup warehouse.</span><small>@manifestedPackageCount order(s) currently have an AWB in this list. Confirm the actual number of parcels ready for collection before submitting.</small></div>
    <div class="dl-pickup-fields">
        <label>Pickup date<input type="date" name="pickupDate" value="@defaultPickupDate" min="@defaultPickupDate" max="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required /></label>
        <label>Pickup time<input type="time" name="pickupTime" value="10:00" required /></label>
        <label>Expected packages<input type="number" name="expectedPackageCount" value="@(Math.Max(1, manifestedPackageCount))" min="1" max="1000" required /></label>
        <button class="dl-pickup-submit" type="submit" @(manifestedPackageCount == 0 ? "disabled" : null)>Schedule pickup</button>
    </div>
    <p class="dl-pickup-note">Only submit after parcels are packed and ready. A pickup request is for the registered warehouse and can cover multiple AWBs. Avoid submitting it again if Delhivery has already accepted the request.</p>
</form>
@if (TempData["DelhiverySuccess"] is string successMessage) { <div class="dl-alert dl-alert-success">@successMessage</div> }
@if (TempData["DelhiveryError"] is string errorMessage) { <div class="dl-alert dl-alert-error">@errorMessage</div> }
<div class="dl-list">
@foreach (var o in orders.OrderByDescending(x => x.CreatedDate)) {
    <article class="dl-card">
        <div class="dl-card-head"><div><strong>Order #@o.Id</strong><small>@o.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small></div><span class="dl-order-status">@o.Status</span></div>
        <div class="dl-card-info"><div><small>CUSTOMER</small><strong>@o.Customer?.Name</strong><span>@o.Customer?.Mobile</span></div><div><small>ORDER VALUE</small><strong>₹@o.TotalAmount.ToString("N0")</strong><span>@o.PaymentStatus</span></div><div><small>SHIPMENT</small><strong>@(string.IsNullOrWhiteSpace(o.ShippingWaybill) ? "Not created" : o.ShippingStatus)</strong><span>@(string.IsNullOrWhiteSpace(o.ShippingWaybill) ? "AWB pending" : $"AWB: {o.ShippingWaybill}")</span></div></div>
        @if (!string.IsNullOrWhiteSpace(o.ShippingWaybill)) {
            <div class="dl-created">Shipment already created for this order.</div>
        } else {
            <details class="dl-create"><summary>Create Delhivery shipment</summary>
                <form asp-action="CreateDelhiveryShipment" method="post" class="dl-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderId" value="@o.Id" />
                    <label>Recipient name<input name="RecipientName" value="@o.Customer?.Name" required maxlength="150" /></label>
                    <label>Phone<input name="RecipientPhone" value="@o.Customer?.Mobile" required maxlength="20" /></label>
                    <label class="wide">Full delivery address<input name="Address" value="@o.ShippingAddress" required maxlength="500" /></label>
                    <label>City<input name="City" required maxlength="100" /></label>
                    <label>State<input name="State" required maxlength="100" /></label>
                    <label>PIN code<input name="PostalCode" inputmode="numeric" pattern="[0-9]{6}" required maxlength="6" /></label>
                    <label>Weight (grams)<input name="WeightGrams" type="number" min="1" max="100000" value="1000" required /></label>
                    <input type="hidden" name="Country" value="India" />
                    <button class="dl-submit" type="submit">Create shipment</button>
                </form>
            </details>
        }
    </article>
}
@if (orders.Count == 0) { <div class="inventory-empty">No orders found.</div> }
</div>
<style>
.dl-pickup-panel{margin-top:18px;padding:18px;border:1px solid #e9d9df;border-radius:14px;background:#fffafc}.dl-pickup-copy{display:grid;gap:5px;margin-bottom:14px}.dl-pickup-copy strong{color:#6c1531;font-size:16px}.dl-pickup-copy span,.dl-pickup-copy small,.dl-pickup-note{color:#817777;font-size:12px}.dl-pickup-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:12px;align-items:end}.dl-pickup-fields label{display:grid;gap:5px;font-size:12px;color:#655858}.dl-pickup-fields input{width:100%;min-width:0;padding:10px;border:1px solid #e5d9d5;border-radius:7px}.dl-pickup-submit{background:#6c1531;color:#fff;border:0;border-radius:8px;padding:11px 16px;font-weight:700;cursor:pointer}.dl-pickup-submit:disabled{opacity:.45;cursor:not-allowed}.dl-pickup-note{margin:12px 0 0}.dl-alert{margin-top:14px;padding:11px 14px;border-radius:8px;font-size:13px}.dl-alert-success{background:#edf8f0;color:#176b38}.dl-alert-error{background:#fff0ef;color:#a12b24}.dl-count{background:#f3edf0;color:#6c1531;border-radius:20px;padding:7px 13px;font-size:13px;font-weight:700}.dl-list{display:grid;gap:14px;margin-top:20px}.dl-card{background:#fff;border:1px solid #eee5e2;border-radius:14px;padding:18px;box-shadow:0 4px 18px rgba(40,20,20,.04)}.dl-card-head{display:flex;justify-content:space-between;align-items:start}.dl-card-head strong{color:#6c1531}.dl-card-head small{display:block;color:#8b8181;margin-top:5px}.dl-order-status{background:#f5f0ed;border-radius:20px;padding:5px 10px;font-size:11px}.dl-card-info{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:18px 0;padding:15px 0;border-top:1px solid #f0e9e7;border-bottom:1px solid #f0e9e7}.dl-card-info div{display:grid;gap:4px}.dl-card-info small{font-size:10px;letter-spacing:.08em;color:#968987}.dl-card-info strong{font-size:14px}.dl-card-info span{font-size:12px;color:#817777}.dl-create summary{cursor:pointer;color:#6c1531;font-weight:700}.dl-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.dl-form label{display:grid;gap:5px;font-size:12px;color:#655858}.dl-form input{width:100%;min-width:0;padding:10px;border:1px solid #e5d9d5;border-radius:7px}.dl-form .wide{grid-column:1/-1}.dl-submit{grid-column:1/-1;justify-self:start;background:#6c1531;color:white;border:0;border-radius:8px;padding:11px 18px;font-weight:700;cursor:pointer}.dl-created{font-size:13px;color:#176b38;background:#edf8f0;padding:10px;border-radius:8px}@@media(max-width:650px){.dl-card-info{grid-template-columns:1fr 1fr}.dl-form{grid-template-columns:1fr}.dl-form .wide,.dl-submit{grid-column:auto}.dl-pickup-fields{grid-template-columns:1fr 1fr}.dl-pickup-submit{grid-column:1/-1}}
</style>