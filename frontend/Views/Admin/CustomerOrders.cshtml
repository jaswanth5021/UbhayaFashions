@model AdminCustomerOrdersViewModel
@{
    ViewData["Title"] = $"Customer - {Model.Customer.Name}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var page=(int)ViewBag.CurrentPage;var pageCount=(int)ViewBag.PageCount;var pageSize=(int)ViewBag.PageSize;
}
<div class="customer-orders-page">
    <header class="co-heading"><div><a asp-action="Customers" class="co-back">← Back to customers</a><div class="co-profile"><span class="co-avatar">@((string.IsNullOrWhiteSpace(Model.Customer.Name)?"C":Model.Customer.Name.Trim().Substring(0,1).ToUpperInvariant()))</span><div><span class="co-eyebrow">CUSTOMER PROFILE</span><h1>@Model.Customer.Name</h1><p>@Model.Customer.Email · @(Model.Customer.Mobile??"Phone not provided")</p></div></div></div><span class="co-customer-id">Customer #@Model.Customer.Id</span></header>
    <section class="co-stats"><article><small>Total orders</small><strong>@ViewBag.TotalOrders</strong></article><article><small>Customer lifetime value</small><strong>₹@(((decimal)ViewBag.TotalSpend).ToString("N2"))</strong><em>All recorded orders</em></article><article><small>Last order</small><strong>@(Model.Customer.LastOrderDate?.ToLocalTime().ToString("dd MMM yyyy")??"—")</strong></article><article><small>Customer ID</small><strong>#@Model.Customer.Id</strong></article></section>
    <section class="co-card"><div class="co-card-head"><div><h2>Order history</h2><p>All orders placed by this customer, newest first.</p></div><span>@ViewBag.TotalOrders orders</span></div>
    @if(Model.Orders.Count==0){<div class="co-empty"><strong>No orders yet</strong><span>This customer has not placed any orders.</span></div>}else{
    <div class="co-order-list">@foreach(var order in Model.Orders){<a class="co-order-row" asp-action="OrderDetails" asp-route-id="@order.Id" asp-route-customerId="@Model.Customer.Id"><div class="co-order-main"><strong>Order #@order.Id</strong><small>@order.CreatedDate.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt") · @order.Items.Sum(i=>i.Quantity) item(s)</small></div><div class="co-order-shipping"><strong>@(string.IsNullOrWhiteSpace(order.ShippingWaybill)?"AWB not created":order.ShippingWaybill)</strong><small>@(order.ShippingStatus??"Awaiting shipment")</small></div><div class="co-order-end"><span class="co-order-status">@order.Status</span><strong>₹@order.TotalAmount.ToString("N2")</strong></div><span class="co-view">View order →</span></a>}</div>}
    <footer class="co-pagination"><span>Showing @((Model.Orders.Count==0)?0:(page-1)*pageSize+1)–@((page-1)*pageSize+Model.Orders.Count) of @ViewBag.TotalOrders orders</span><nav class="admin-pagination">@if(pageCount>1){if(page>1){<a asp-action="CustomerOrders" asp-route-id="@Model.Customer.Id" asp-route-page="@(page-1)" asp-route-pageSize="@pageSize">← Previous</a>}else{<span class="is-disabled">← Previous</span>}<span class="is-current">@page / @pageCount</span>@if(page<pageCount){<a asp-action="CustomerOrders" asp-route-id="@Model.Customer.Id" asp-route-page="@(page+1)" asp-route-pageSize="@pageSize">Next →</a>}else{<span class="is-disabled">Next →</span>}}</nav><form asp-action="CustomerOrders" method="get"><input type="hidden" name="id" value="@Model.Customer.Id"/><label>Rows <select name="pageSize" onchange="this.form.submit()"><option value="5" selected="@(pageSize==5)">5</option><option value="10" selected="@(pageSize==10)">10</option><option value="15" selected="@(pageSize==15)">15</option><option value="50" selected="@(pageSize==50)">50</option><option value="100" selected="@(pageSize==100)">100</option><option value="0" selected="@(pageSize==0)">All</option></select></label></form></footer>
    </section>
</div>
<style>
.customer-orders-page{color:#302a30}.co-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:18px;gap:14px}.co-back{display:inline-block;color:#741b3c;text-decoration:none;font-size:11px;font-weight:750;margin-bottom:14px}.co-profile{display:flex;align-items:center;gap:13px}.co-avatar{display:grid;place-items:center;width:54px;height:54px;border-radius:16px;background:#f6eaf0;color:#741b3c;font-size:22px;font-weight:800}.co-eyebrow{font-size:9px;color:#8d5369;font-weight:800;letter-spacing:1.2px}.co-profile h1{margin:3px 0;font-size:25px}.co-profile p{margin:0;color:#8b828b;font-size:11px}.co-customer-id{padding:8px 11px;border:1px solid #eee6eb;border-radius:8px;color:#741b3c;font-size:10px;font-weight:700;background:#fff}.co-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:15px}.co-stats article,.co-card{border:1px solid #eee8ed;border-radius:12px;background:#fff;box-shadow:0 3px 12px rgba(38,22,31,.035)}.co-stats article{padding:15px}.co-stats small,.co-stats em{display:block;color:#8b828b;font-size:10px;font-style:normal}.co-stats strong{display:block;margin:6px 0;font-size:19px}.co-card{overflow:hidden}.co-card-head{display:flex;justify-content:space-between;align-items:center;padding:17px;border-bottom:1px solid #f0ecef}.co-card-head h2{margin:0;font-size:15px}.co-card-head p{margin:4px 0 0;color:#8b828b;font-size:11px}.co-card-head>span{color:#741b3c;font-size:11px;font-weight:700}.co-order-row{display:grid;grid-template-columns:1.2fr 1fr auto auto;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px solid #f0ecef;color:inherit;text-decoration:none;transition:background .15s}.co-order-row:hover{background:#fdf9fb}.co-order-main strong,.co-order-main small,.co-order-shipping strong,.co-order-shipping small{display:block}.co-order-main strong,.co-order-shipping strong{font-size:12px}.co-order-main small,.co-order-shipping small{margin-top:5px;color:#8b828b;font-size:10px}.co-order-end{text-align:right}.co-order-end strong{display:block;margin-top:6px;font-size:12px}.co-order-status{display:inline-block;padding:5px 8px;border-radius:20px;background:#edf2ff;color:#4569b8;font-size:9px;font-weight:750}.co-view{color:#741b3c;font-size:10px;font-weight:750;white-space:nowrap}.co-empty{display:grid;gap:5px;place-items:center;padding:45px;color:#8b828b;font-size:11px}.co-empty strong{color:#39313a;font-size:14px}.co-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:13px 17px;color:#8b828b;font-size:10px}.co-pagination nav{display:flex;align-items:center;gap:8px}.co-pagination nav a,.co-pagination nav .is-current{padding:6px 9px;border:1px solid #eee5ea;border-radius:7px;color:#741b3c;text-decoration:none}.co-pagination nav .is-current{background:#741b3c;color:#fff}.co-pagination nav .is-disabled{color:#b8afb7}.co-pagination form label{display:flex;align-items:center;gap:6px}.co-pagination select{padding:5px;border:1px solid #e8e1e6;border-radius:6px}
@@media(max-width:750px){.co-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.co-order-row{grid-template-columns:1fr auto}.co-order-shipping{grid-column:1}.co-order-end{grid-column:2;grid-row:1;text-align:right}.co-view{grid-column:1/-1}.co-heading{align-items:flex-start;flex-direction:column}}
</style>
