@model LadiesDressStore.Web.Models.AdminResetPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Set Admin Password - Ubhaya Fashions</title>
    <link rel="stylesheet" href="~/css/pages/admin/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/app.css" asp-append-version="true" />
</head>
<body class="admin-login-page">
    <div class="admin-login-card">
        <div class="login-logo">UBHAYA <span>FASHIONS</span></div>
        <h1>Choose a new password</h1>
        <p>Use at least 12 characters for your admin password.</p>
        <form asp-controller="Admin" asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert error"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" autocomplete="new-password" minlength="12" required />
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" minlength="12" required />
            <button type="submit">UPDATE PASSWORD</button>
        </form>
        <a class="back-store" asp-controller="Admin" asp-action="Login">Back to admin login</a>
    </div>
</body>
</html>
