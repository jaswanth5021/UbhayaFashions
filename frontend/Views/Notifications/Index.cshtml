@model LadiesDressStore.Web.Models.NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";
    ViewData["MetaDescription"] = "View updates from Ubhaya Fashions.";
}

<section class="notifications-page">
    <header class="notifications-page-header">
        <div>
            <p class="notifications-eyebrow">YOUR UBHAYA UPDATES</p>
            <h1>Notifications</h1>
            <p>New arrivals and important updates from our collection.</p>
        </div>
        <span class="notifications-total">@Model.Items.Count @(Model.Items.Count == 1 ? "update" : "updates")</span>
    </header>

    @if (ViewBag.Error is string error)
    {
        <div class="notifications-error" role="alert">@error</div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="notifications-empty">
            <span class="notifications-empty-icon" aria-hidden="true">♡</span>
            <h2>You’re all caught up</h2>
            <p>We’ll let you know when something new arrives.</p>
            <a asp-controller="Products" asp-action="Index">Explore the collection</a>
        </div>
    }
    else
    {
        <div class="notifications-list" data-notification-list>
            @foreach (var item in Model.Items)
            {
                <article class="notification-card @(item.ReadDate is null ? "is-unread" : "")" data-notification-id="@item.Id">
                    @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                    {
                        <img class="notification-card-image" src="@item.ProductImageUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="notification-card-mark" aria-hidden="true">✦</span>
                    }
                    <div class="notification-card-content">
                        <div class="notification-card-heading">
                            <h2>@item.Title</h2>
                            <time datetime="@item.CreatedDate.ToString("O")">@item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</time>
                        </div>
                        <p>@item.Message</p>
                        <div class="notification-card-actions">
                            <a href="@item.Link" data-notification-open>View product</a>
                            <button type="button" data-notification-dismiss>Dismiss</button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/customer-notifications.js" asp-append-version="true"></script>
}
