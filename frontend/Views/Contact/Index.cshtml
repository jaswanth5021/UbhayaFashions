@model LadiesDressStore.Web.Models.ContactViewModel
@{
    ViewData["Title"] = "Contact Ubhaya Fashions";
    ViewData["MetaDescription"] = "Contact Ubhaya Fashions about orders, products, or other questions. Send our team a message.";
    var contactPhone = Configuration["Contact:Phone"];
    var phoneLink = string.IsNullOrWhiteSpace(contactPhone)
        ? null
        : "tel:" + new string(contactPhone.Where(character => char.IsDigit(character) || character == '+').ToArray());
}

<div class="contact-page">

    <div class="contact-header">
        <h1>Contact Us</h1>
        <p>We'd love to hear from you. Get in touch with Ubhaya Fashions.</p>
    </div>

    <div class="contact-content">

        @if (TempData["ContactSuccess"] is string contactSuccess)
        {
            <p class="contact-success" role="status">@contactSuccess</p>
        }

        <div class="contact-info">
            <h2>Get in Touch</h2>

            <p>
                Have a question about our products or your order?
                Send us a message and we'll get back to you.
            </p>

            <div class="contact-item">
                <strong>Email</strong>
                <a href="mailto:ubhayafashions@gmail.com">ubhayafashions@gmail.com</a>
            </div>

            <div class="contact-item">
                <strong>Location</strong>
                <span>Hyderabad, Telangana, India</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(contactPhone) && !string.IsNullOrWhiteSpace(phoneLink))
            {
                <div class="contact-item">
                    <strong>Phone</strong>
                    <a href="@phoneLink">@contactPhone</a>
                </div>
            }
        </div>

        <div class="contact-form">

            <h2>Send Us a Message</h2>

            <form asp-controller="Contact"
                  asp-action="Index"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="contact-validation" role="alert"></div>

                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="contact-validation"></span>

                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" />
                <span asp-validation-for="Email" class="contact-validation"></span>

                <label asp-for="Subject"></label>
                <input asp-for="Subject" />
                <span asp-validation-for="Subject" class="contact-validation"></span>

                <label asp-for="Message"></label>
                <textarea asp-for="Message"></textarea>
                <span asp-validation-for="Message" class="contact-validation"></span>

                <button type="submit" class="button">
                    Send Message
                </button>

            </form>

        </div>

    </div>

</div>
