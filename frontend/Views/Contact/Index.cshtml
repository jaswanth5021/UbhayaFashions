@model LadiesDressStore.Web.Models.ContactViewModel
@{
    ViewData["Title"] = "Contact Ubhaya Fashions";
    ViewData["MetaDescription"] = "Contact Ubhaya Fashions about orders, products, or other questions. Send our team a message.";
    var contactPhone = Configuration["Contact:Phone"];
    var phoneLink = string.IsNullOrWhiteSpace(contactPhone)
        ? null
        : "tel:" + new string(contactPhone.Where(character => char.IsDigit(character) || character == '+').ToArray());
}

<div class="contact-page">

    <div class="contact-header">
        <h1>Contact Us</h1>
        <p>We'd love to hear from you. Get in touch with Ubhaya Fashions.</p>
    </div>

    <div class="contact-content">

        @if (TempData["ContactSuccess"] is string contactSuccess)
        {
            <p class="contact-success" role="status" data-app-notification="success">@contactSuccess</p>
        }

        <div class="contact-info">
            <h2>Get in Touch</h2>

            <p>
                Have a question about our products or your order?
                Send us a message and we'll get back to you.
            </p>

            <div class="contact-item">
                <strong>Email</strong>
                <a href="mailto:ubhayafashions@gmail.com">ubhayafashions@gmail.com</a>
            </div>

            <div class="contact-item">
                <strong>Location</strong>
                <span>Hyderabad, Telangana, India</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(contactPhone) && !string.IsNullOrWhiteSpace(phoneLink))
            {
                <div class="contact-item">
                    <strong>Phone</strong>
                    <a href="@phoneLink">@contactPhone</a>
                </div>
            }

            <section class="contact-product-issue-help" aria-labelledby="productIssueHelpHeading">
                <h2 id="productIssueHelpHeading">Reporting a product or delivery issue?</h2>
                <p>For a damaged, defective, missing, or incorrect item, please include the following in your message:</p>
                <ul>
                    <li>Your order number and the email or mobile number used for the order.</li>
                    <li>A short description of the issue and the product name/size.</li>
                    <li><strong>5–6 clear photos</strong> showing the item, the problem, parcel label, and outer packaging.</li>
                    <li>An unboxing video, if you were able to record one. A video is helpful, but please contact us even if you do not have one.</li>
                </ul>
                <p>Please keep the item and its original packaging until our team responds. Do not include full payment-card details or passwords in your message.</p>
                <p>See our <a asp-controller="Home" asp-action="Returns">Returns, Refunds &amp; Product Issues Policy</a> for more information.</p>
            </section>
        </div>

        <div class="contact-form">

            <h2>Send Us a Message</h2>

            <form asp-controller="Contact"
                  asp-action="Index"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="contact-validation" role="alert"></div>

                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="contact-validation"></span>

                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" />
                <span asp-validation-for="Email" class="contact-validation"></span>

                <label asp-for="Subject"></label>
                <input asp-for="Subject" />
                <span asp-validation-for="Subject" class="contact-validation"></span>

                <label asp-for="Message"></label>
                <textarea asp-for="Message"></textarea>
                <span asp-validation-for="Message" class="contact-validation"></span>

                <button type="submit" class="button">
                    Send Message
                </button>

            </form>

            <p class="contact-form-note">Please note: this form currently displays a confirmation message; it does not yet send the message or attachments by email. To share photos or a video, email <a href="mailto:ubhayafashions@gmail.com">ubhayafashions@gmail.com</a> with your order number.</p>

        </div>

    </div>

</div>
