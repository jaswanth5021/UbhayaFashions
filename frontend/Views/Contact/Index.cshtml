@model LadiesDressStore.Web.Models.ContactViewModel
@{
    ViewData["Title"] = "Contact Ubhaya Fashions";
    ViewData["MetaDescription"] = "Contact Ubhaya Fashions about orders, products, or other questions. Send our team a message.";
    var contactPhone = Configuration["Contact:Phone"];
    var phoneLink = string.IsNullOrWhiteSpace(contactPhone)
        ? null
        : "tel:" + new string(contactPhone.Where(character => char.IsDigit(character) || character == '+').ToArray());
}

<div class="contact-page">
    <header class="contact-header">
        <span class="contact-eyebrow">WE’RE HERE TO HELP</span>
        <h1>Contact Us</h1>
        <p>Questions about an order or a product? Our team is here to help you.</p>
    </header>

    @if (TempData["ContactSuccess"] is string contactSuccess)
    {
        <p class="contact-success" role="status" data-app-notification="success">@contactSuccess</p>
    }

    <div class="contact-content">
        <aside class="contact-info">
            <div class="contact-info-intro">
                <span class="contact-info-kicker">UBHAYA FASHIONS</span>
                <h2>Get in touch</h2>
                <p>For order updates, product questions, or support, contact us using the details below.</p>
            </div>

            <div class="contact-item">
                <span class="contact-item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                </span>
                <div><strong>Email us</strong><a href="mailto:ubhayafashions@gmail.com">ubhayafashions@gmail.com</a></div>
            </div>

            <div class="contact-item">
                <span class="contact-item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                </span>
                <div><strong>Our location</strong><span>Hyderabad, Telangana, India</span></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(contactPhone) && !string.IsNullOrWhiteSpace(phoneLink))
            {
                <div class="contact-item">
                    <span class="contact-item-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 3a15 15 0 0 1-7-7l3-2-3-6Z"/></svg>
                    </span>
                    <div><strong>Call us</strong><a href="@phoneLink">@contactPhone</a></div>
                </div>
            }

            <section class="contact-product-issue-help" aria-labelledby="productIssueHelpHeading">
                <div class="contact-issue-title">
                    <span class="contact-issue-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg>
                    </span>
                    <div><span class="contact-issue-kicker">ORDER SUPPORT</span><h2 id="productIssueHelpHeading">Reporting a product or delivery issue?</h2></div>
                </div>
                <p class="contact-issue-description">If an item is damaged, defective, missing, or incorrect, please prepare these details so we can understand the issue.</p>

                <ul class="contact-evidence-list">
                    <li><span aria-hidden="true">01</span><div><strong>Order details</strong><small>Your order number and the email or mobile number used for the order.</small></div></li>
                    <li><span aria-hidden="true">02</span><div><strong>5–6 clear photos</strong><small>The item, the issue, parcel label, and outer packaging.</small></div></li>
                    <li><span aria-hidden="true">03</span><div><strong>Unboxing video, if available</strong><small>A video can help, but you can contact us even if you don’t have one.</small></div></li>
                </ul>

                <div class="contact-issue-footnote">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/></svg>
                    <p>Please keep the item and its original packaging until our team responds. Never include passwords or full payment-card details.</p>
                </div>
                <!-- <a class="contact-policy-link" asp-controller="Home" asp-action="Returns">Read our Returns, Refunds &amp; Product Issues Policy <span aria-hidden="true">→</span></a> -->
            </section>
        </aside>

        <section class="contact-form">
            <div class="contact-form-heading">
                <span class="contact-form-kicker">SEND AN ENQUIRY</span>
                <h2>Send us a message</h2>
                <p>Fill in the details below and tell us how we can help.</p>
            </div>

            <form asp-controller="Contact" asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="contact-validation" role="alert"></div>

                <div class="contact-field">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" autocomplete="name" placeholder="Your full name" />
                    <span asp-validation-for="Name" class="contact-validation"></span>
                </div>

                <div class="contact-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="contact-validation"></span>
                </div>

                <div class="contact-field">
                    <label asp-for="Subject"></label>
                    <input asp-for="Subject" placeholder="How can we help?" />
                    <span asp-validation-for="Subject" class="contact-validation"></span>
                </div>

                <div class="contact-field">
                    <label asp-for="Message"></label>
                    <textarea asp-for="Message" rows="6" placeholder="Please include your order number if your message is about an order."></textarea>
                    <span asp-validation-for="Message" class="contact-validation"></span>
                </div>

                <button type="submit" class="button contact-submit">
                    Send Message <span aria-hidden="true">→</span>
                </button>
            </form>

            <div class="contact-form-note" role="note">
                <span class="contact-note-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/></svg>
                </span>
                <p><strong>Need to send photos or a video?</strong> This form currently displays a confirmation message; it does not send messages or attachments by email. Please email <a href="mailto:ubhayafashions@gmail.com">ubhayafashions@gmail.com</a> with your order number and photos/video.</p>
            </div>
        </section>
    </div>
</div>
