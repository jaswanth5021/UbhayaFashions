@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Checkout";
    var total = Model.Sum(x => x.Price * x.Quantity);
    var itemCount = Model.Sum(x => x.Quantity);
    var savedAddresses = ViewBag.SavedAddresses as List<SavedAddressViewModel> ?? [];
    var cartVariants = ViewBag.CartVariants as Dictionary<int, List<ProductVariantViewModel>> ?? new();
    var checkoutCouponOffers = ViewBag.CheckoutCouponOffers as List<CheckoutCouponOfferViewModel> ?? [];
}

<section class="checkout-screen checkout-four-step">
    <header class="checkout-screen-header">
        <div class="checkout-screen-steps" aria-label="Checkout progress">
            <div class="checkout-screen-step is-active" data-checkout-screen-indicator="1">
                <span>1</span><strong>Cart</strong>
                <svg class="checkout-screen-step-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 1.9-1.4L21 8H6M9 20h.01M18 20h.01" /></svg>
            </div>
            <i></i>
            <div class="checkout-screen-step" data-checkout-screen-indicator="2">
                <span>2</span><strong>Address</strong>
                <svg class="checkout-screen-step-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            </div>
            <i></i>
            <div class="checkout-screen-step" data-checkout-screen-indicator="3">
                <span>3</span><strong>Payment</strong>
                <svg class="checkout-screen-step-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h4" /></svg>
            </div>
            <i></i>
            <div class="checkout-screen-step" data-checkout-screen-indicator="4">
                <span>4</span><strong>Order Review</strong>
                <svg class="checkout-screen-step-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h8M14 2v6h6M14 2l6 6" /><path d="m16 17 2 2 4-5" /></svg>
            </div>
        </div>
    </header>

    @for (var itemIndex = 0; itemIndex < Model.Count; itemIndex++)
    {
        var cartItem = Model[itemIndex];
        <form id="checkout-cart-update-@itemIndex" asp-controller="Cart" asp-action="Update" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@cartItem.ProductId" />
            <input type="hidden" name="currentSize" value="@cartItem.Size" />
            <input type="hidden" name="currentColor" value="@cartItem.Color" />
            <input type="hidden" name="color" value="@cartItem.Color" />
            <input type="hidden" name="returnUrl" value="/Orders/Checkout" />
        </form>
        <form id="checkout-cart-remove-@itemIndex" asp-controller="Cart" asp-action="Remove" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@cartItem.ProductId" />
            <input type="hidden" name="size" value="@cartItem.Size" />
            <input type="hidden" name="color" value="@cartItem.Color" />
            <input type="hidden" name="returnUrl" value="/Orders/Checkout" />
        </form>
    }

    <form asp-controller="Orders" asp-action="Checkout" method="post" id="checkoutScreenForm">
        <input type="hidden" name="CheckoutKey" value="@Guid.NewGuid().ToString("N")" />
        @Html.AntiForgeryToken()
        <input type="hidden" name="ShippingAddress" id="checkoutShippingAddress" />
        <input type="hidden" name="SelectedSavedAddressId" id="checkoutSelectedSavedAddressId" value="0" />
        <input type="hidden" name="Address.AddressLine2" id="checkoutAddressLine2" value="@(savedAddresses.FirstOrDefault()?.AddressLine2 ?? "")" />

        <div class="checkout-screen-layout">
            <section class="checkout-screen-main">

                <!-- STEP 1: CART / ORDER DETAILS -->
                <section class="checkout-screen-panel checkout-step-cart is-visible" data-checkout-screen-step="1">
                    <div class="checkout-screen-title-row">
                        <div>
                            <span>STEP 1</span>
                            <h1>Your Shopping Bag <small>(@itemCount @(itemCount == 1 ? "item" : "items"))</small></h1>
                        </div>
                        <a class="checkout-continue-shopping" asp-controller="Products" asp-action="Index">Continue Shopping</a>
                    </div>

                    <div class="checkout-bag-items">
                        @for (var itemIndex = 0; itemIndex < Model.Count; itemIndex++)
                        {
                            var item = Model[itemIndex];
                            var itemDiscount = item.DiscountPercent;
                            var itemHasDiscount = itemDiscount > 0 && itemDiscount < 100 && item.Price > 0;
                            var itemMrp = itemHasDiscount
                                ? Math.Round(item.Price / (1 - itemDiscount / 100m), 2)
                                : item.Price;
                            var allVariants = cartVariants.GetValueOrDefault(item.ProductId, []);
                            var hasColorVariants = allVariants.Any(variant => !string.IsNullOrWhiteSpace(variant.Color));
                            var availableVariants = allVariants
                                .Where(variant => variant.Stock > 0 &&
                                    (!hasColorVariants || string.Equals(variant.Color, item.Color, StringComparison.OrdinalIgnoreCase)))
                                .OrderBy(variant => variant.Size)
                                .ToList();
                            var selectedVariant = availableVariants.FirstOrDefault(variant =>
                                string.Equals(variant.Size, item.Size, StringComparison.OrdinalIgnoreCase));

                            <article class="checkout-bag-item">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="checkout-bag-image">
                                    <img src="@ImageUrlHelper.Resolve(item.ImageUrl, Configuration["ApiBaseUrl"])" alt="@item.Name" />
                                </a>
                                <div class="checkout-bag-info">
                                    <h2>@item.Name</h2>
                                    <p>@(string.IsNullOrWhiteSpace(item.Color) ? "" : $"Color: {item.Color}")</p>
                                    <div class="checkout-bag-edit-controls">
                                        <label>Size
                                            <select name="size" form="checkout-cart-update-@itemIndex" aria-label="Choose size for @item.Name" onchange="this.form.requestSubmit()">
                                                @if (selectedVariant is null)
                                                {
                                                    <option value="" selected disabled>Select available size</option>
                                                }
                                                @foreach (var variant in availableVariants)
                                                {
                                                    <option value="@variant.Size" selected="@(selectedVariant?.Size == variant.Size ? "selected" : null)">@variant.Size</option>
                                                }
                                            </select>
                                        </label>
                                        <label>Qty
                                            <select name="quantity" form="checkout-cart-update-@itemIndex" aria-label="Choose quantity for @item.Name" disabled="@(selectedVariant is null)" onchange="this.form.requestSubmit()">
                                                @for (var quantity = 1; quantity <= Math.Max(1, selectedVariant?.Stock ?? item.Quantity); quantity++)
                                                {
                                                    <option value="@quantity" selected="@(quantity == item.Quantity ? "selected" : null)">@quantity</option>
                                                }
                                            </select>
                                        </label>
                                        
                                    </div>
                                    @if (selectedVariant is null)
                                    {
                                        <p class="checkout-stock-warning" role="alert">Your selected size is unavailable. Please choose another in-stock size or remove this item.</p>
                                    }
                                    else if (item.Quantity > selectedVariant.Stock)
                                    {
                                        <p class="checkout-stock-warning" role="alert">Your selected quantity exceeds available stock. Reduce the quantity to continue.</p>
                                    }
                                    <div class="checkout-item-price" aria-label="Product price">
                                        @if (itemHasDiscount)
                                        {
                                            <span class="checkout-item-price-original">₹@itemMrp.ToString("N0")</span>
                                            <strong class="checkout-item-price-current">₹@item.Price.ToString("N0")</strong>
                                            <span class="checkout-item-price-discount">@itemDiscount.ToString("0.##")% OFF</span>
                                        }
                                        else
                                        {
                                            <strong class="checkout-item-price-current">₹@item.Price.ToString("N0")</strong>
                                        }
                                    </div>
                                </div>
                <button type="submit"
                                        class="checkout-bag-remove-icon"
                                        form="checkout-cart-remove-@itemIndex"
                                        aria-label="Remove @item.Name from your shopping bag"
                                        title="Remove item">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                                </button>
                            </article>
                        }
                    </div>

                    <p class="checkout-bag-edit-note">Changes to size and quantity are saved automatically. Available sizes and quantities reflect current stock.</p>

                    <div class="checkout-free-shipping">
                        <div>
                            <strong>@(total >= 1000 ? "FREE SHIPPING UNLOCKED" : "Add ₹" + Math.Max(0, 1000 - total).ToString("N0") + " more to unlock FREE SHIPPING")</strong>
                            <span>@(total >= 1000 ? "Your order qualifies for free shipping." : "Free shipping on orders of ₹1,000 or more.")</span>
                        </div>
                        <div class="checkout-shipping-progress">
                            <span style="width:@Math.Min(100, (double)total / 1000 * 100)%"></span>
                        </div>
                        <strong>₹@total.ToString("N0") / ₹1,000</strong>
                    </div>

                    <button type="button" class="checkout-screen-primary" data-checkout-screen-next="2">
                        PROCEED TO ADDRESS
                    </button>
                </section>

                <!-- STEP 2: ADDRESS -->
                <section class="checkout-screen-panel" data-checkout-screen-step="2" hidden>
                    <div class="checkout-screen-title-row">
                        <div>
                            <span>STEP 2</span>
                            <h1>Shipping Address</h1>
                        </div>
                        <span class="checkout-saved-label">Use saved address</span>
                    </div>

                    @if (savedAddresses.Count > 0)
                    {
                        <div class="checkout-screen-saved-list" role="radiogroup" aria-label="Saved shipping addresses">
                            @for (var addressIndex = 0; addressIndex < savedAddresses.Count; addressIndex++)
                            {
                                var address = savedAddresses[addressIndex];
                                var isFirstAddress = addressIndex == 0;

                <label class="checkout-screen-saved-card @(isFirstAddress ? "is-selected" : "")"
                                       data-saved-id="@address.Id"
                                       data-saved-address="@address.FullAddress"
                                       data-saved-line1="@address.AddressLine1"
                                       data-saved-line2="@address.AddressLine2"
                                       data-saved-city="@address.City"
                                       data-saved-state="@address.State"
                                       data-saved-postal-code="@address.PostalCode"
                                       data-saved-country="@address.Country"
                                       data-saved-name="@address.Name"
                                       data-saved-mobile="@address.Mobile">
                                    <input type="radio"
                                           name="SavedShippingAddress"
                                           value="@addressIndex"
                                           class="checkout-saved-address-radio"
                                           @(isFirstAddress ? "checked" : null)
                                           aria-label="Select address for @address.Name" />
                                    <span class="checkout-saved-card-content">
                                        <strong>@address.Name</strong>
                                        <span>@address.FullAddress</span>
                                        @if (!string.IsNullOrWhiteSpace(address.Mobile))
                                        {
                                            <small>@address.Mobile</small>
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                    }

                    <div class="checkout-screen-fields">
                        <label>
                            Full Name
                            <input id="checkoutName" name="Address.Name" type="text" value="@(savedAddresses.FirstOrDefault()?.Name ?? "")" autocomplete="name" required />
                        </label>
                        <label>
                            Phone Number
                            <input id="checkoutPhone" name="Address.Mobile" type="tel" value="@(savedAddresses.FirstOrDefault()?.Mobile ?? "")" autocomplete="tel" required />
                        </label>
                        <label class="full">
                            Address
                            <textarea id="checkoutAddressText" name="Address.AddressLine1" placeholder="House / Flat / Street / Area" required>@(savedAddresses.FirstOrDefault()?.AddressLine1 ?? "")</textarea>
                        </label>
                        <label>
                            Pincode
                            <input id="checkoutPincode" name="Address.PostalCode" type="text" value="@(savedAddresses.FirstOrDefault()?.PostalCode ?? "")" inputmode="numeric" autocomplete="postal-code" />
                        </label>
                        <label>
                            City
                            <input id="checkoutCity" name="Address.City" type="text" value="@(savedAddresses.FirstOrDefault()?.City ?? "")" autocomplete="address-level2" />
                        </label>
                        <label>
                            State
                            <input id="checkoutState" name="Address.State" type="text" value="@(savedAddresses.FirstOrDefault()?.State ?? "Telangana")" autocomplete="address-level1" />
                        </label>
                        <label>
                            Country
                            <select id="checkoutCountry" name="Address.Country">
                                <option selected="@(string.IsNullOrWhiteSpace(savedAddresses.FirstOrDefault()?.Country) || savedAddresses.FirstOrDefault()?.Country == "India")">India</option>
                            </select>
                        </label>
                    </div>

                    <label class="checkout-save-address">
                        <input id="checkoutSaveAddress" type="checkbox" name="SaveAddress" value="true" checked />
                        <span>Save this address for future orders</span>
                    </label>

                    <div class="checkout-screen-actions">
                        <button type="button" class="checkout-screen-back" data-checkout-screen-back="1">← Back to Cart</button>
                        <button type="button" class="checkout-screen-primary" data-checkout-screen-next="3">CONTINUE TO PAYMENT</button>
                    </div>
                </section>

                <!-- STEP 3: PAYMENT -->
                <section class="checkout-screen-panel" data-checkout-screen-step="3" hidden>
                    <div class="checkout-screen-title-row">
                        <div>
                            <span>STEP 3</span>
                            <h1>Payment</h1>
                        </div>
                        <button type="button" class="checkout-screen-back" data-checkout-screen-back="2">← Address</button>
                    </div>

                    <div class="checkout-payment-options">
                        <label class="checkout-payment-option is-selected">
                            <input type="radio" name="PaymentMethod" value="Razorpay" checked />
                            <span class="checkout-radio"></span>
                            <span>
                                <strong>Razorpay Secure Payment</strong>
                                <small>UPI, Credit/Debit Cards, Net Banking & Wallets</small>
                            </span>
                        </label>
                    </div>

                    <section class="checkout-coupon-panel" aria-labelledby="checkoutCouponTitle">
                        <div class="checkout-coupon-heading">
                            <div>
                                <strong id="checkoutCouponTitle">Apply a coupon</strong>
                                <span>Choose an offer available for your cart or enter its code.</span>
                            </div>
                        </div>
                        <div class="checkout-coupon-entry">
                            <label for="checkoutCouponCode">Coupon code</label>
                            <div class="checkout-coupon-input-row">
                                <input id="checkoutCouponCode" type="text" maxlength="40" autocomplete="off" placeholder="Enter coupon code" />
                                <input id="checkoutCouponCodeValue" type="hidden" name="CouponCode" value="" />
                                <button id="checkoutApplyCoupon" type="button">Apply</button>
                            </div>
                        </div>
                        <p id="checkoutCouponMessage" class="checkout-coupon-message" role="status" aria-live="polite"></p>
                        <div class="checkout-coupon-offers">
                            <h2>Active offers for your cart</h2>
                            @if (checkoutCouponOffers.Count > 0)
                            {
                                <div class="checkout-coupon-offer-list">
                                    @foreach (var offer in checkoutCouponOffers)
                                    {
                                        <article class="checkout-coupon-offer"
                                                 data-checkout-coupon-offer
                                                 data-coupon-code="@(offer.Code ?? "")"
                                                 data-coupon-name="@offer.Name"
                                                 data-coupon-discount="@offer.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                 data-coupon-can-apply="@(offer.CanApply ? "true" : "false")"
                                                 data-coupon-automatic="@(offer.IsAutomatic ? "true" : "false")">
                                            <div class="checkout-coupon-offer-heading">
                                                <strong title="@offer.Name">@offer.Name</strong>
                                                <details class="checkout-coupon-terms">
                                                    <summary>T&amp;C <span aria-hidden="true">›</span></summary>
                                                    <div>
                                                        <strong>Offer details</strong>
                                                        <p>@offer.AppliesTo</p>
                                                        @if (!string.IsNullOrWhiteSpace(offer.Terms)) { <p>@offer.Terms</p> }
                                                        @if (offer.EndsAtUtc.HasValue) { <p>Valid until @offer.EndsAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy")</p> }
                                                    </div>
                                                </details>
                                            </div>
                                            <div class="checkout-coupon-offer-main">
                                                <div class="checkout-coupon-offer-value">
                                                    <span class="checkout-coupon-kicker">SPECIAL OFFER</span>
                                                    <strong class="checkout-coupon-discount-text">@offer.DiscountText</strong>
                                                    <span class="checkout-coupon-condition">
                                                        @(offer.FirstOrderOnly ? "First order" : "All eligible orders")
                                                        @if (offer.IsAutomatic) { <text> · Auto applied</text> }
                                                    </span>
                                                </div>
                                                <div class="checkout-coupon-card-actions">
                                                    @if (!string.IsNullOrWhiteSpace(offer.Code))
                                                    {
                                                        <button type="button"
                                                                class="checkout-coupon-use @(offer.CanApply ? "" : "is-unavailable")"
                                                                data-checkout-coupon-use
                                                                aria-label="@(offer.CanApply ? "Use" : "Enter") coupon code @offer.Code"
                                                                title="@(offer.CanApply ? "Select this coupon" : offer.EligibilityMessage)">
                                                            <span>@(offer.CanApply ? "USE CODE" : "ADD CODE")</span><b>@offer.Code</b>
                                                            <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="8" y="8" width="14" height="14" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="checkout-coupon-auto-label" data-checkout-coupon-auto-label>@(offer.CanApply ? "AUTO APPLIED" : "NOT ELIGIBLE")</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!offer.CanApply && !string.IsNullOrWhiteSpace(offer.EligibilityMessage))
                                            {
                                                <p class="checkout-coupon-ineligible">@offer.EligibilityMessage</p>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="checkout-coupon-empty">There are no active coupons available for this cart right now.</p>
                            }
                        </div>
                    </section>

                    <div class="checkout-secure-note">
                        <strong>🔒 Secure Checkout</strong>
                        <span>Your payment is processed securely by Razorpay.</span>
                    </div>

                    @if (Context.RequestServices.GetRequiredService<IHostEnvironment>().IsDevelopment() && Configuration.GetValue<bool>("PaymentTesting:Enabled"))
                    {
                        <div class="checkout-test-payment-panel">
                            <span class="checkout-test-payment-label">TEST MODE</span>
                            <strong>Preview the complete order flow without opening Razorpay</strong>
                            <p>These buttons are for the feature/test environment only.</p>
                            <div class="checkout-test-payment-actions">
                                <button type="button"
                                        class="checkout-test-payment-button success"
                                        data-test-payment="success">
                                    ✓ Simulate Successful Payment
                                </button>
                                <button type="button"
                                        class="checkout-test-payment-button failure"
                                        data-test-payment="failure">
                                    × Simulate Failed Payment
                                </button>
                            </div>
                        </div>
                    }

                    <div class="checkout-screen-actions">
                        <button type="button" class="checkout-screen-back" data-checkout-screen-back="2">← Back to Address</button>
                        <button type="button" class="checkout-screen-primary" data-checkout-screen-next="4">CONTINUE TO ORDER REVIEW</button>
                    </div>
                </section>

                <!-- STEP 4: ORDER REVIEW -->
                <section class="checkout-screen-panel" data-checkout-screen-step="4" hidden>
                    <div class="checkout-screen-title-row">
                        <div>
                            <span>STEP 4</span>
                            <h1>Order Review</h1>
                        </div>
                        <button type="button" class="checkout-screen-back" data-checkout-screen-back="2">← Change Address</button>
                    </div>

                    <div class="checkout-review-address">
                        <span>SHIPPING ADDRESS</span>
                        <strong id="reviewName"></strong>
                        <p id="reviewAddress"></p>
                    </div>

                    <div class="checkout-review-payment">
                        <span>PAYMENT METHOD</span>
                        <strong>Razorpay Secure Payment</strong>
                        <p>UPI, cards, net banking and wallets.</p>
                    </div>

                    <div class="checkout-review-items">
                        <span>ORDER ITEMS</span>
                        @foreach (var item in Model)
                        {
                            <div>
                                <span>@item.Name × @item.Quantity</span>
                                <strong>₹@((item.Price * item.Quantity).ToString("N0"))</strong>
                            </div>
                        }
                    </div>

                    <div class="checkout-review-total">
                        <div id="checkoutReviewCouponDiscount" hidden><span id="checkoutReviewCouponLabel">Coupon discount</span><strong id="checkoutReviewCouponAmount"></strong></div>
                        <div><span>Total Payable</span><strong id="checkoutReviewTotal">₹@total.ToString("N0")</strong></div>
                    </div>

                    <div class="checkout-screen-actions">
                        <button type="button" class="checkout-screen-back" data-checkout-screen-back="3">← Back to Payment</button>
                        <button type="submit" class="checkout-screen-primary">PAY ₹@total.ToString("N0") WITH RAZORPAY</button>
                    </div>
                </section>
            </section>

            <aside class="checkout-screen-summary">
                <h2>Order Summary</h2>
                <div class="checkout-screen-products">
                    @foreach (var item in Model)
                    {
                        var summaryDiscount = item.DiscountPercent;
                        var summaryHasDiscount = summaryDiscount > 0 && summaryDiscount < 100 && item.Price > 0;
                        var summaryMrp = summaryHasDiscount
                            ? Math.Round(item.Price / (1 - summaryDiscount / 100m), 2)
                            : item.Price;
                        <article>
                            <img src="@ImageUrlHelper.Resolve(item.ImageUrl, Configuration["ApiBaseUrl"])" alt="@item.Name" />
                            <div class="checkout-summary-product-info">
                                <strong>@item.Name</strong>
                                <span>Size: @item.Size × @item.Quantity</span>
                                <div class="checkout-item-price" aria-label="Product price">
                                    @if (summaryHasDiscount)
                                    {
                                        <span class="checkout-item-price-original">₹@summaryMrp.ToString("N0")</span>
                                        <strong class="checkout-item-price-current">₹@item.Price.ToString("N0")</strong>
                                        <span class="checkout-item-price-discount">@summaryDiscount.ToString("0.##")% OFF</span>
                                    }
                                    else
                                    {
                                        <strong class="checkout-item-price-current">₹@item.Price.ToString("N0")</strong>
                                    }
                                </div>
                            </div>
                            <b>₹@((item.Price * item.Quantity).ToString("N2"))</b>
                        </article>
                    }
                </div>
                <div class="checkout-screen-total-lines" id="checkoutPaymentPriceBreakdown" aria-label="Order price breakdown" hidden data-subtotal="@total.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div><span>Subtotal</span><strong id="checkoutQuoteSubtotal">₹@total.ToString("N2")</strong></div>
                    <div id="checkoutQuoteCouponDiscount" class="checkout-screen-coupon-line" hidden><span id="checkoutQuoteCouponLabel">Coupon discount</span><strong id="checkoutQuoteCouponAmount"></strong></div>
                    <div><span>Delhivery charges</span><strong id="checkoutQuoteShipping" class="@(total >= 1000m ? "free" : "")">@(total >= 1000m ? "FREE" : "Calculating…")</strong></div>
                    <div class="checkout-screen-total-payable"><span>Total payable</span><strong id="checkoutQuoteTotal">₹@total.ToString("N2")</strong></div>
                    <p id="checkoutQuoteMessage" class="checkout-shipping-disclaimer" role="status" aria-live="polite"></p>
                </div>
                <div class="checkout-screen-trust">
                    <strong>🔒 Secure Checkout</strong>
                    <p>We use Razorpay for secure payments.</p>
                    <div class="checkout-screen-payment-brands">
                        <b>Razorpay</b><span>VISA</span><span>●●</span><span>UPI</span>
                    </div>
                </div>
            </aside>
        </div>
    </form>

    <div class="checkout-mobile-sticky-bar" aria-label="Checkout action">
        <div class="checkout-mobile-sticky-total">
            <span>Total</span>
            <strong>₹@total.ToString("N0")</strong>
        </div>
        <button type="button" class="checkout-mobile-sticky-button" data-mobile-checkout-next>
            <span data-mobile-checkout-label>Continue to Address</span>
            <span aria-hidden="true">→</span>
        </button>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const panels = [...document.querySelectorAll('[data-checkout-screen-step]')];
            const indicators = [...document.querySelectorAll('[data-checkout-screen-indicator]')];
            const shipping = document.getElementById('checkoutShippingAddress');
            const addressText = document.getElementById('checkoutAddressText');
            const name = document.getElementById('checkoutName');
            const phone = document.getElementById('checkoutPhone');
            const pincode = document.getElementById('checkoutPincode');
            const city = document.getElementById('checkoutCity');
            const state = document.getElementById('checkoutState');
            const country = document.getElementById('checkoutCountry');
            const addressLine2 = document.getElementById('checkoutAddressLine2');
            const selectedAddressId = document.getElementById('checkoutSelectedSavedAddressId');
            const saveAddressCheckbox = document.getElementById('checkoutSaveAddress');

            const syncAddress = () => {
                if (!shipping) return;
                shipping.value = [
                    addressText?.value,
                    addressLine2?.value,
                    city?.value,
                    state?.value,
                    pincode?.value,
                    country?.value
                ].map(value => value?.trim()).filter(Boolean).join(', ');
                const reviewName = document.getElementById('reviewName');
                const reviewAddress = document.getElementById('reviewAddress');
                if (reviewName) reviewName.textContent = name?.value.trim() || 'Customer';
                if (reviewAddress) reviewAddress.textContent = shipping.value;
            };

            const quoteBreakdown = document.getElementById('checkoutPaymentPriceBreakdown');
            const quoteShipping = document.getElementById('checkoutQuoteShipping');
            const quoteTotal = document.getElementById('checkoutQuoteTotal');
            const quoteMessage = document.getElementById('checkoutQuoteMessage');
            const couponInput = document.getElementById('checkoutCouponCode');
            const couponCodeValue = document.getElementById('checkoutCouponCodeValue');
            const couponMessage = document.getElementById('checkoutCouponMessage');
            const couponDiscountLine = document.getElementById('checkoutQuoteCouponDiscount');
            const couponDiscountLabel = document.getElementById('checkoutQuoteCouponLabel');
            const couponDiscountAmount = document.getElementById('checkoutQuoteCouponAmount');
            const reviewCouponDiscount = document.getElementById('checkoutReviewCouponDiscount');
            const reviewCouponLabel = document.getElementById('checkoutReviewCouponLabel');
            const reviewCouponAmount = document.getElementById('checkoutReviewCouponAmount');
            const reviewTotal = document.getElementById('checkoutReviewTotal');
            const mobileTotal = document.querySelector('.checkout-mobile-sticky-total strong');
            const reviewPayButton = document.querySelector('#checkoutScreenForm button[type="submit"].checkout-screen-primary');
            const couponOffers = [...document.querySelectorAll('[data-checkout-coupon-offer]')];
            const paymentReviewButton = document.querySelector('[data-checkout-screen-next="4"]');
            let shippingQuoteReady = Number(quoteBreakdown?.dataset.subtotal || 0) >= 1000;

            const automaticCoupon = couponOffers.find(offer => offer.dataset.couponAutomatic === 'true' &&
                offer.dataset.couponCanApply === 'true') || null;
            let appliedCoupon = automaticCoupon;

            const formatMoney = amount => '\u20B9' + Number(amount || 0).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const updateCheckoutTotals = () => {
                const subtotal = Number(quoteBreakdown?.dataset.subtotal || 0);
                const shippingCharge = Number(quoteBreakdown?.dataset.shippingCharge || 0);
                const discount = Number(appliedCoupon?.dataset.couponDiscount || 0);
                const payable = Math.max(0, subtotal - discount) + shippingCharge;
                const couponName = appliedCoupon?.dataset.couponName || '';
                const couponCode = appliedCoupon?.dataset.couponCode || '';
                const discountLabel = couponCode ? 'Coupon (' + couponCode + ')' : 'Automatic offer';

                if (couponDiscountLine) couponDiscountLine.hidden = discount <= 0;
                if (couponDiscountLabel) couponDiscountLabel.textContent = discountLabel;
                if (couponDiscountAmount) couponDiscountAmount.textContent = '\u2212' + formatMoney(discount);
                if (reviewCouponDiscount) reviewCouponDiscount.hidden = discount <= 0;
                if (reviewCouponLabel) reviewCouponLabel.textContent = discountLabel;
                if (reviewCouponAmount) reviewCouponAmount.textContent = '\u2212' + formatMoney(discount);
                if (quoteTotal) quoteTotal.textContent = formatMoney(payable);
                if (reviewTotal) reviewTotal.textContent = formatMoney(payable);
                if (mobileTotal) mobileTotal.textContent = formatMoney(payable).replace(/\.00$/, '');
                if (reviewPayButton) reviewPayButton.textContent = 'PAY ' + formatMoney(payable).replace(/\.00$/, '') + ' WITH RAZORPAY';
                if (couponCodeValue) couponCodeValue.value = couponCode;
                couponOffers.forEach(offer => {
                    offer.classList.toggle('is-applied', offer === appliedCoupon);
                    const autoLabel = offer.querySelector('[data-checkout-coupon-auto-label]');
                    if (autoLabel) autoLabel.textContent = offer === appliedCoupon
                        ? 'AUTO APPLIED'
                        : offer.dataset.couponCanApply === 'true' ? 'AUTO OFFER' : 'NOT ELIGIBLE';
                    const useButton = offer.querySelector('[data-checkout-coupon-use]');
                    const useButtonLabel = useButton?.querySelector('span');
                    if (useButtonLabel) useButtonLabel.textContent = offer === appliedCoupon ? 'APPLIED' : 'USE CODE';
                });

                if (discount > 0 && couponMessage && !couponMessage.dataset.keepMessage) {
                    couponMessage.textContent = couponCode
                        ? 'Coupon ' + couponCode + ' applied. You save ' + formatMoney(discount) + '.'
                        : couponName + ' is applied. You save ' + formatMoney(discount) + '.';
                    couponMessage.classList.add('is-success');
                }
            };

            const applyCoupon = () => {
                const code = couponInput?.value.trim().toUpperCase() || '';
                if (!code) {
                    appliedCoupon = automaticCoupon;
                    if (couponMessage) {
                        couponMessage.textContent = automaticCoupon
                            ? 'The best eligible automatic offer is applied.'
                            : 'Enter a coupon code or choose an offer below.';
                        couponMessage.classList.toggle('is-success', Boolean(automaticCoupon));
                        delete couponMessage.dataset.keepMessage;
                    }
                    updateCheckoutTotals();
                    return Boolean(automaticCoupon);
                }

                const match = couponOffers.find(offer => offer.dataset.couponAutomatic !== 'true' &&
                    (offer.dataset.couponCode || '').toUpperCase() === code);
                if (!match) {
                    if (couponMessage) {
                        couponMessage.textContent = 'That code is not active or eligible for this cart.';
                        couponMessage.classList.remove('is-success');
                        couponMessage.dataset.keepMessage = 'true';
                    }
                    return false;
                }
                if (match.dataset.couponCanApply !== 'true') {
                    if (couponMessage) {
                        couponMessage.textContent = match.querySelector('.checkout-coupon-ineligible')?.textContent.trim() ||
                            'This active coupon is not eligible for your current cart.';
                        couponMessage.classList.remove('is-success');
                        couponMessage.dataset.keepMessage = 'true';
                    }
                    return false;
                }

                appliedCoupon = match;
                if (couponInput) couponInput.value = match.dataset.couponCode || code;
                if (couponMessage) {
                    couponMessage.textContent = 'Coupon ' + (match.dataset.couponCode || code) + ' applied. You save ' + formatMoney(match.dataset.couponDiscount) + '.';
                    couponMessage.classList.add('is-success');
                    delete couponMessage.dataset.keepMessage;
                }
                updateCheckoutTotals();
                return true;
            };

            document.getElementById('checkoutApplyCoupon')?.addEventListener('click', applyCoupon);
            const selectCheckoutOffer = offer => {
                if (!offer || !couponInput) return;
                const code = offer.dataset.couponCode || '';
                if (!code) return;
                couponInput.value = code;
                couponInput.focus();
                applyCoupon();
            };

            // Delegate at document level in capture phase so nested card elements,
            // labels and other handlers cannot swallow the coupon-card click.
            document.addEventListener('click', event => {
                const target = event.target instanceof Element ? event.target : null;
                const terms = target?.closest('.checkout-coupon-terms');
                if (terms) return;

                const offer = target?.closest('[data-checkout-coupon-offer]');
                if (!offer || !document.contains(offer)) return;

                const code = (offer.getAttribute('data-coupon-code') || '').trim();
                if (!code || !couponInput) return;

                event.preventDefault();
                couponInput.value = code.toUpperCase();
                couponInput.dispatchEvent(new Event('input', { bubbles: true }));
                couponInput.focus({ preventScroll: true });

                // Validate eligible offers immediately; for ineligible offers,
                // keep the code in the field and show the minimum-order message.
                applyCoupon();
            }, true);
            couponInput?.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applyCoupon();
                }
            });
            couponInput?.addEventListener('input', () => {
                const currentCode = couponInput.value.trim().toUpperCase();
                if (appliedCoupon && appliedCoupon.dataset.couponAutomatic !== 'true' &&
                    currentCode !== (appliedCoupon.dataset.couponCode || '').toUpperCase()) {
                    appliedCoupon = automaticCoupon;
                    if (couponMessage) {
                        couponMessage.textContent = '';
                        couponMessage.classList.remove('is-success');
                        delete couponMessage.dataset.keepMessage;
                    }
                    updateCheckoutTotals();
                }
            });

            if (automaticCoupon && couponMessage) {
                couponMessage.textContent = automaticCoupon.dataset.couponName + ' is applied automatically.';
                couponMessage.classList.add('is-success');
            }
            updateCheckoutTotals();

            const updateShippingQuote = async () => {
                if (!quoteBreakdown) return;
                const subtotal = Number(quoteBreakdown.dataset.subtotal || 0);
                quoteBreakdown.hidden = false;
                quoteBreakdown.style.display = '';

                if (subtotal >= 1000) {
                    quoteBreakdown.dataset.shippingCharge = '0';
                    quoteShipping.textContent = 'FREE';
                    quoteShipping.classList.add('free');
                    updateCheckoutTotals();
                    quoteTotal.textContent = '₹' + subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    quoteMessage.textContent = 'Free delivery on orders of ₹1,000 or more.';
                    updateCheckoutTotals();
                    shippingQuoteReady = true;
                    if (paymentReviewButton) paymentReviewButton.disabled = false;
                    return;
                }

                shippingQuoteReady = false;
                quoteBreakdown.dataset.shippingCharge = '0';
                updateCheckoutTotals();
                if (paymentReviewButton) paymentReviewButton.disabled = true;
                quoteShipping.textContent = 'Calculating…';
                quoteShipping.classList.remove('free');
                quoteMessage.textContent = 'Checking the delivery charge for your saved delivery PIN code…';

                const pin = pincode?.value.trim() || '';
                try {
                    const response = await fetch('@Url.Action("DeliveryQuote", "Orders")' +
                        '?pincode=' + encodeURIComponent(pin) +
                        '&subtotal=' + encodeURIComponent(subtotal.toString()), {
                            credentials: 'same-origin',
                            headers: { 'Accept': 'application/json' }
                        });
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'Unable to calculate delivery charges.');
                    }

                    const charge = Number(result.shippingCharge || 0);
                    quoteBreakdown.dataset.shippingCharge = charge.toString();
                    const payable = Number(result.total || (subtotal + charge));
                    quoteShipping.textContent = charge > 0
                        ? '₹' + charge.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        : 'FREE';
                    quoteShipping.classList.toggle('free', charge <= 0);
                    updateCheckoutTotals();
                    quoteTotal.textContent = '₹' + payable.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    updateCheckoutTotals();
                    quoteMessage.textContent = 'Delivery charge calculated for PIN code ' + pin + '.';
                    shippingQuoteReady = true;
                    if (paymentReviewButton) paymentReviewButton.disabled = false;
                } catch (error) {
                    quoteShipping.textContent = 'Not available';
                    quoteMessage.textContent = error.message || 'Unable to calculate delivery charges. Please check your PIN code and try again.';
                    shippingQuoteReady = false;
                    if (paymentReviewButton) paymentReviewButton.disabled = true;
                }
            };

            let showStep = step => {
                panels.forEach(panel => {
                    const active = Number(panel.dataset.checkoutScreenStep) === step;
                    panel.hidden = !active;
                    panel.classList.toggle('is-visible', active);
                });

                indicators.forEach(indicator => {
                    const current = Number(indicator.dataset.checkoutScreenIndicator);
                    indicator.classList.toggle('is-active', current === step);
                    indicator.classList.toggle('is-complete', current < step);
                });

                syncAddress();
                if (step === 3) updateShippingQuote();
                else if (quoteBreakdown) {
                    quoteBreakdown.hidden = true;
                    quoteBreakdown.style.display = 'none';
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            const validateNewAddressForSaving = () => {
                if (!saveAddressCheckbox?.checked || Number(selectedAddressId?.value || 0) > 0)
                    return true;

                const missingField = [name, phone, addressText, city, state, pincode]
                    .find(input => !input?.value.trim() || (input === pincode && input.value.trim().length < 5));
                if (!missingField) return true;

                showStep(2);
                alert(missingField === pincode
                    ? 'Enter a valid pincode to save this address.'
                    : 'Complete your address details to save it for future orders.');
                missingField.focus();
                return false;
            };

            const selectSavedAddress = card => {
                addressText.value = card.dataset.savedLine1 || '';
                if (addressLine2) addressLine2.value = card.dataset.savedLine2 || '';
                name.value = card.dataset.savedName || '';
                phone.value = card.dataset.savedMobile || '';
                if (pincode) pincode.value = card.dataset.savedPostalCode || '';
                if (city) city.value = card.dataset.savedCity || '';
                if (state) state.value = card.dataset.savedState || '';
                if (country) country.value = card.dataset.savedCountry || 'India';
                if (selectedAddressId) selectedAddressId.value = card.dataset.savedId || '0';

                document.querySelectorAll('[data-saved-address]').forEach(x => {
                    x.classList.remove('is-selected');
                    const radio = x.querySelector('.checkout-saved-address-radio');
                    if (radio) radio.checked = false;
                });

                card.classList.add('is-selected');
                const selectedRadio = card.querySelector('.checkout-saved-address-radio');
                if (selectedRadio) selectedRadio.checked = true;

                syncAddress();
            };

            document.querySelectorAll('[data-saved-address]').forEach(card => {
                card.addEventListener('click', event => {
                    if (event.target.closest('.checkout-saved-address-radio')) {
                        selectSavedAddress(card);
                        return;
                    }

                    selectSavedAddress(card);
                });
            });

            // Keep the first saved address selected when Step 2 opens.
            const initiallySelectedAddress =
                document.querySelector('.checkout-screen-saved-card.is-selected');
            if (initiallySelectedAddress) {
                selectSavedAddress(initiallySelectedAddress);
            }

            document.querySelectorAll('[data-checkout-screen-next]').forEach(button => {
                button.addEventListener('click', () => {
                    const step = Number(button.dataset.checkoutScreenNext);

                    if (step === 2) {
                        showStep(2);
                        return;
                    }

                    if (step === 3 && !addressText?.value.trim()) {
                        alert('Please enter or select a shipping address.');
                        addressText?.focus();
                        return;
                    }

                    if (step === 3 && !validateNewAddressForSaving())
                        return;

                    if (step === 4 && !shippingQuoteReady) {
                        alert('Please wait until the Delhivery delivery charge is calculated for your PIN code.');
                        return;
                    }

                    syncAddress();
                    showStep(step);
                });
            });

            document.querySelectorAll('[data-checkout-screen-back]').forEach(button => {
                button.addEventListener('click', () => showStep(Number(button.dataset.checkoutScreenBack)));
            });

            const markAddressAsNew = () => {
                if (selectedAddressId) selectedAddressId.value = '0';
                syncAddress();
            };
            [addressText, name, phone, pincode, city, state, country].forEach(input => {
                input?.addEventListener('input', markAddressAsNew);
                input?.addEventListener('change', markAddressAsNew);
            });

            document.querySelector('[data-mobile-checkout-next]')?.addEventListener('click', () => {
                const activePanel = document.querySelector('[data-checkout-screen-step].is-visible');
                const currentStep = Number(activePanel?.dataset.checkoutScreenStep || 1);
                const button = document.querySelector(
                    '[data-checkout-screen-next="' + (currentStep + 1) + '"]'
                );

                if (currentStep < 4) {
                    button?.click();
                    return;
                }

                document.getElementById('checkoutScreenForm')?.requestSubmit();
            });

            const updateMobileCheckoutLabel = () => {
                const activePanel = document.querySelector('[data-checkout-screen-step].is-visible');
                const step = Number(activePanel?.dataset.checkoutScreenStep || 1);
                const label = document.querySelector('[data-mobile-checkout-label]');
                if (!label) return;

                label.textContent = step === 1
                    ? 'Continue to Address'
                    : step === 2
                        ? 'Continue to Payment'
                        : step === 3
                            ? 'Review Order'
                            : 'Pay ' + (reviewTotal?.textContent || '').replace(/\.00$/, '');
            };

            const originalShowStep = showStep;
            showStep = step => {
                originalShowStep(step);
                updateMobileCheckoutLabel();
            };

            document.querySelectorAll('[data-test-payment]').forEach(button => {
                button.addEventListener('click', async () => {
                    const mode = button.dataset.testPayment;
                    const address = addressText?.value.trim() || '';

                    if (!address) {
                        showStep(2);
                        alert('Please enter or select a shipping address first.');
                        addressText?.focus();
                        return;
                    }

                    if (!validateNewAddressForSaving())
                        return;

                    const enteredCoupon = couponInput?.value.trim().toUpperCase() || '';
                    if (enteredCoupon && enteredCoupon !== (couponCodeValue?.value.trim().toUpperCase() || '')) {
                        if (applyCoupon())
                            alert('Coupon applied. Review the updated total, then simulate payment again.');
                        else
                            couponInput?.focus();
                        return;
                    }

                    const form = document.getElementById('checkoutScreenForm');
                    const token = form?.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (!token) return;

                    document.querySelectorAll('[data-test-payment]').forEach(x => x.disabled = true);

                    if (mode === 'failure') {
                        window.location.href =
                            '@Url.Action("Failure", "Orders")' +
                            '?message=' +
                            encodeURIComponent('Test payment failed. No payment was captured and your cart is still available.');
                        return;
                    }

                    try {
                        syncAddress();
                        const formData = new FormData(form);

                        const response = await fetch('@Url.Action("TestPaymentSuccess", "Orders")', {
                            method: 'POST',
                            body: formData,
                            credentials: 'same-origin'
                        });

                        const result = await response.json();

                        if (response.ok && result.success && result.redirectUrl) {
                            window.location.href = result.redirectUrl;
                            return;
                        }

                        alert(result.message || 'Test payment could not be completed.');
                    } catch {
                        alert('Unable to run the test payment. Please try again.');
                    } finally {
                        document.querySelectorAll('[data-test-payment]').forEach(x => x.disabled = false);
                    }
                });
            });

            document.getElementById('checkoutScreenForm')?.addEventListener('submit', event => {
                const enteredCoupon = couponInput?.value.trim().toUpperCase() || '';
                if (enteredCoupon && enteredCoupon !== (couponCodeValue?.value.trim().toUpperCase() || '')) {
                    event.preventDefault();
                    if (applyCoupon())
                        alert('Coupon applied. Review the updated total, then continue to payment.');
                    else
                        couponInput?.focus();
                    return;
                }

                syncAddress();
                if (!shipping?.value.trim()) {
                    event.preventDefault();
                    showStep(2);
                    alert('Please enter your shipping address.');
                }
            });

            showStep(1);
        })();
    </script>
}
