@model LadiesDressStore.Web.Models.PaymentCheckoutViewModel
@{
    ViewData["Title"] = "Secure Payment";
}

<section class="checkout-payment-page" aria-labelledby="paymentTitle">
    <div class="checkout-payment-topline">
        <span class="checkout-payment-shield" aria-hidden="true">&#10003;</span>
        <span>SECURE PAYMENT</span>
    </div>
    <p class="checkout-payment-eyebrow">YOUR ORDER IS ALMOST READY</p>
    <h1 id="paymentTitle">Complete your payment</h1>
    <p class="checkout-payment-order">Order <strong>#@Model.OrderId</strong></p>

    <div class="checkout-payment-amount-card">
        <span>Amount to pay</span>
        <strong>&#8377;@((Model.Amount / 100m).ToString("N2"))</strong>
    </div>

    <p id="payment-message" class="checkout-payment-message">Continue securely with Razorpay. Your order will be confirmed after payment verification.</p>

    <button id="pay-button" class="checkout-payment-pay-button" type="button">
        Pay &#8377;@((Model.Amount / 100m).ToString("N0")) <span aria-hidden="true">&rarr;</span>
    </button>

    <div class="checkout-payment-methods" aria-label="Supported payment methods">
        <span>UPI</span><span>Cards</span><span>Net banking</span><span>Wallets</span>
    </div>
    <p class="checkout-payment-footnote"><span aria-hidden="true">&#10003;</span> Payments are processed securely by Razorpay.</p>
</section>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
(() => {
    const button = document.getElementById('pay-button');
    const message = document.getElementById('payment-message');

    const options = {
        key: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KeyId)),
        amount: @Model.Amount,
        currency: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Currency)),
        name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)),
        description: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Description)),
        order_id: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RazorpayOrderId)),
        theme: {
            color: "#68142e"
        },
        handler: async function (response) {
            button.disabled = true;
            message.textContent = 'Verifying your payment...';

            const formData = new FormData(document.getElementById('paymentVerifyForm'));
            formData.append('OrderId', '@Model.OrderId');
            formData.append('RazorpayOrderId', response.razorpay_order_id || '');
            formData.append('RazorpayPaymentId', response.razorpay_payment_id || '');
            formData.append('RazorpaySignature', response.razorpay_signature || '');

            const verifyResponse = await fetch('@Url.Action("Verify", "Orders")', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            });

            const result = await verifyResponse.json();
            if (verifyResponse.ok && result.success) {
                window.location.href = result.redirectUrl;
                return;
            }

            button.disabled = false;
            message.textContent = result.message || 'Payment verification failed. Please contact support.';
        },
        modal: {
            ondismiss: function () {
                message.textContent = 'Payment window closed. You can try again.';
            }
        }
    };

    button.addEventListener('click', function () {
        const rzp = new Razorpay(options);
        rzp.on('payment.failed', function (response) {
            message.textContent = response.error?.description || 'Payment failed. Please try again.';
        });
        rzp.open();
    });
})();
</script>

<form id="paymentVerifyForm" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SaveAddress" value="@(Model.SaveAddress ? "true" : "false")" />
    <input type="hidden" name="SelectedSavedAddressId" value="@Model.SelectedSavedAddressId" />
    <input type="hidden" name="Address.Name" value="@Model.Address.Name" />
    <input type="hidden" name="Address.Mobile" value="@Model.Address.Mobile" />
    <input type="hidden" name="Address.AddressLine1" value="@Model.Address.AddressLine1" />
    <input type="hidden" name="Address.AddressLine2" value="@Model.Address.AddressLine2" />
    <input type="hidden" name="Address.City" value="@Model.Address.City" />
    <input type="hidden" name="Address.State" value="@Model.Address.State" />
    <input type="hidden" name="Address.PostalCode" value="@Model.Address.PostalCode" />
    <input type="hidden" name="Address.Country" value="@Model.Address.Country" />
</form>
