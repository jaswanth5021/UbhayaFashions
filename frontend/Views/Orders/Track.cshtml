@model LadiesDressStore.Web.Models.OrderTrackingViewModel
@{
    ViewData["Title"] = $"Track Order #{Model.OrderId}";
    var status = string.IsNullOrWhiteSpace(Model.ShippingStatus) || Model.ShippingStatus == "NotCreated"
        ? "Order processing" : Model.ShippingStatus;
    var normalized = status.ToLowerInvariant();
    var delivered = normalized.Contains("deliver") && !normalized.Contains("out for delivery");
    var outForDelivery = normalized.Contains("out for delivery") || normalized.Contains("dispatched");
    var inTransit = normalized.Contains("transit") || outForDelivery || delivered;
    var pickedUp = inTransit || normalized.Contains("picked") || normalized.Contains("pickup");
    var shipmentCreated = !string.IsNullOrWhiteSpace(Model.Waybill);
    var cancelled = normalized.Contains("cancel") || Model.OrderStatus.Contains("cancel", StringComparison.OrdinalIgnoreCase);
    var currentStep = cancelled ? -1 : delivered ? 5 : outForDelivery ? 4 : inTransit ? 3 : pickedUp ? 2 : shipmentCreated ? 1 : 0;

    var orderDate = Model.OrderDate.ToLocalTime();
    var lastUpdate = Model.LastTrackingUpdateUtc?.ToLocalTime();
    var shipmentDate = Model.ShipmentCreatedUtc?.ToLocalTime();
    var expectedDelivery = delivered && lastUpdate.HasValue
        ? lastUpdate.Value
        : (shipmentDate ?? orderDate).AddDays(shipmentDate.HasValue ? 5 : 7);

    var badgeText = cancelled ? "Cancelled" : delivered ? "Delivered" : shipmentCreated ? "Shipped" : "Processing";
    var badgeClass = cancelled ? "is-cancelled" : delivered ? "is-delivered" : shipmentCreated ? "is-shipped" : "is-processing";
    var statusTitle = cancelled ? "Cancelled"
        : delivered ? "Delivered"
        : outForDelivery ? "Out for Delivery"
        : inTransit ? "In Transit"
        : pickedUp ? "Picked Up"
        : shipmentCreated ? "Shipment Created"
        : "Order Processing";
    var statusText = cancelled ? "This shipment is no longer progressing."
        : delivered ? "Your parcel has been delivered to your address."
        : outForDelivery ? "Our courier partner is delivering your parcel today."
        : inTransit ? "Your parcel is in transit to the next facility."
        : pickedUp ? "Your parcel has been picked up from our location."
        : shipmentCreated ? "Your shipment is booked with Delhivery."
        : "We are preparing your order for dispatch.";
    var imageUrl = string.IsNullOrWhiteSpace(Model.FirstItemImageUrl)
        ? null : ImageUrlHelper.Resolve(Model.FirstItemImageUrl, Configuration["ApiBaseUrl"]);
    var itemLabel = Model.ItemCount == 1 ? "1 Item" : $"{Model.ItemCount} Items";

    var steps = new[]
    {
        new { Title = "Order Placed", Note = "Your order has been successfully placed", Icon = "box" },
        new { Title = "Shipment Created", Note = "Shipment booked with Delhivery", Icon = "box" },
        new { Title = "Picked Up", Note = "Parcel picked up from our location", Icon = "box" },
        new { Title = "In Transit", Note = "Parcel is in transit to delivery location", Icon = "truck" },
        new { Title = "Out for Delivery", Note = "Will be out for delivery soon", Icon = "box" },
        new { Title = "Delivered", Note = "Will be delivered to your address", Icon = "home" }
    };
}

<link rel="stylesheet" href="~/css/pages/orders/track.css" asp-append-version="true" />

<div class="track-page">
    <nav class="track-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/></svg>
            Home
        </a>
        <svg class="track-breadcrumb-sep" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        <a asp-controller="Account" asp-action="Profile" asp-route-tab="orders">My Orders</a>
        <svg class="track-breadcrumb-sep" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        <span>Track Order</span>
    </nav>

    <header class="track-hero">
        <div class="track-hero-icon" aria-hidden="true">
            <svg width="76" height="57" viewBox="0 0 64 48">
                <path d="M2 14h8M0 22h10M4 30h6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                <path d="M14 8h28v26H14z" fill="currentColor"/>
                <path d="M42 16h10l8 9v9H42z" fill="currentColor"/>
                <path d="M45 19h6l5 6h-11z" fill="#fff"/>
                <circle cx="24" cy="38" r="6" fill="currentColor" stroke="#fde8f1" stroke-width="3"/>
                <circle cx="50" cy="38" r="6" fill="currentColor" stroke="#fde8f1" stroke-width="3"/>
            </svg>
        </div>
        <div class="track-hero-copy">
            <h1>Track Your Order</h1>
            <p>Enter your order details to check the latest delivery status</p>
        </div>
        <div class="track-hero-art" aria-hidden="true">
            <svg width="200" height="140" viewBox="0 0 200 140">
                <path d="M150 30c18-22 40-24 48-20-6 18-24 34-48 36z" fill="#3f7d4e"/>
                <path d="M156 60c22-8 38 0 42 6-16 10-34 10-46 4z" fill="#2f6a3e"/>
                <path d="M20 128c-6-28 4-52 22-60" stroke="#4d8a5a" stroke-width="5" fill="none" stroke-linecap="round"/>
                <path d="M8 78c14-6 30 0 34 10-14 6-30 2-34-10z" fill="#3f7d4e"/>
                <rect x="58" y="46" width="70" height="94" rx="4" fill="#f4a3bf"/>
                <path d="M74 52c0-22 38-22 38 0" stroke="#d9729a" stroke-width="5" fill="none"/>
                <rect x="104" y="60" width="66" height="80" rx="4" fill="#e8628f"/>
                <path d="M118 66c0-20 38-20 38 0" stroke="#c4416f" stroke-width="5" fill="none"/>
            </svg>
        </div>
    </header>

    <section class="track-main-card">
        <form class="track-lookup" asp-controller="Orders" asp-action="Find" method="get" role="search">
            <input type="hidden" name="current" value="@Model.OrderId" />
            <label for="trackOrderId">Enter Order ID</label>
            <div class="track-lookup-row">
                <div class="track-lookup-input">
                    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5z"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v9"/></svg>
                    <input id="trackOrderId" name="orderId" type="text" inputmode="numeric" value="@Model.OrderId" autocomplete="off" placeholder="e.g. 1024" />
                </div>
                <button type="submit">
                    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                    Track Order
                </button>
            </div>
        </form>

        <div class="track-order-summary">
            <div class="track-order-product">
                <a class="track-product-link" href="@Url.Action("Details", "Products", new { id = Model.FirstItemProductId })" aria-label="View @Model.FirstItemName product"><div class="track-order-thumb">
                    @if (imageUrl is not null)
                    {
                        <img src="@imageUrl" alt="@Model.FirstItemName" loading="lazy" />
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5z"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v9"/></svg>
                    }
                </div></a>
                <div class="track-order-info">
                    <div class="track-order-title">
                        <span>Order #@Model.OrderId</span>
                        <span class="track-badge @badgeClass">
                            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/></svg>
                            @badgeText
                        </span>
                    </div>
                    <p><a class="track-product-name-link" href="@Url.Action("Details", "Products", new { id = Model.FirstItemProductId })">@Model.FirstItemName</a></p>
                    <p>Placed on @orderDate.ToString("dd MMM yyyy")</p>
                    <p>@itemLabel &bull; ₹@Model.TotalAmount.ToString("N0")</p>
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="track-order-link">
                        View Order Details
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                </div>
            </div>

            <div class="track-carrier">
                <img class="track-delhivery-logo" src="https://upload.wikimedia.org/wikipedia/commons/2/23/Delhivery_Logo_%282019%29.png" alt="Delhivery" loading="lazy" />
                <div class="track-carrier-meta">
                    <div>
                        <span>AWB Number</span>
                        @if (shipmentCreated)
                        {
                            <strong class="track-awb">
                                <span id="trackAwb">@Model.Waybill</span>
                                <button type="button" class="track-copy" data-copy-target="trackAwb" aria-label="Copy AWB number">
                                    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
                                </button>
                            </strong>
                        }
                        else
                        {
                            <strong class="track-muted">Awaiting shipment</strong>
                        }
                    </div>
                    <div>
                        <span>Courier Partner</span>
                        <strong>Delhivery</strong>
                    </div>
                    <div>
                        <span>@(delivered ? "Delivered On" : "Expected Delivery")</span>
                        <strong class="track-date">
                            @expectedDelivery.ToString("dd MMM yyyy")
                            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/></svg>
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <ol class="track-timeline @(cancelled ? "is-cancelled" : "")" aria-label="Shipment progress">
            @for (var index = 0; index < steps.Length; index++)
            {
                var step = steps[index];
                var stepClass = cancelled ? "is-pending"
                    : index < currentStep ? "is-complete"
                    : index == currentStep ? (index == 5 ? "is-complete" : "is-current")
                    : "is-pending";
                DateTimeOffset? stepDate = index == 0 ? orderDate
                    : index == 1 && shipmentDate.HasValue && index <= currentStep ? shipmentDate
                    : index == currentStep ? lastUpdate
                    : null;
                <li class="track-step @stepClass">
                    <div class="track-step-dot" aria-hidden="true">
                        @if (stepClass == "is-complete")
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24"><path d="m6 12.5 4 4 8-9"/></svg>
                        }
                        else if (step.Icon == "truck")
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                        }
                        else if (step.Icon == "home")
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M4 11.5 12 5l8 6.5"/><path d="M6.5 10v9h11v-9"/><path d="M10 19v-5h4v5"/></svg>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5z"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v9"/></svg>
                        }
                    </div>
                    <strong>@step.Title</strong>
                    @if (stepDate.HasValue)
                    {
                        <span class="track-step-date">@stepDate.Value.ToString("dd MMM yyyy")</span>
                        <span class="track-step-time">@stepDate.Value.ToString("hh:mm tt")</span>
                    }
                    else
                    {
                        <span class="track-step-date">@(stepClass == "is-complete" ? "Completed" : "Pending")</span>
                        <span class="track-step-time">&nbsp;</span>
                    }
                    <p>@step.Note</p>
                </li>
            }
        </ol>

        @if (cancelled)
        {
            <div class="track-alert track-alert-warning">This order or shipment is marked as cancelled. Please contact UBHAYA support if you need help.</div>
        }
    </section>

    <section class="track-bottom-grid">
        <article class="track-info-card track-status-card">
            <header>
                <span class="track-card-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                </span>
                <h2>Current Status</h2>
                @if (shipmentCreated && !delivered && !cancelled)
                {
                    <span class="track-live"><i></i> Live Tracking</span>
                }
            </header>
            <div class="track-status-body">
                <div class="track-status-icon @(delivered ? "is-delivered" : cancelled ? "is-cancelled" : "")" aria-hidden="true">
                    @if (delivered)
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24"><path d="m6 12.5 4 4 8-9"/></svg>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                    }
                </div>
                <div>
                    <h3>@statusTitle</h3>
                    <p>@statusText</p>
                </div>
            </div>
            <div class="track-scan-note">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5" fill="#fff"/></svg>
                <div>
                    @if (lastUpdate.HasValue)
                    {
                        <p>Last update: <strong>@status</strong></p>
                        <p>@lastUpdate.Value.ToString("dd MMM yyyy, hh:mm tt")</p>
                    }
                    else
                    {
                        <p>Last update: <strong>Order received</strong></p>
                        <p>@orderDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                    }
                </div>
            </div>
        </article>

        <article class="track-info-card track-delivery-card">
            <header>
                <span class="track-card-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 22s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5" fill="#fff"/></svg>
                </span>
                <h2>Delivery Information</h2>
            </header>
            <dl class="track-delivery-list">
                <div class="track-delivery-row">
                    <dt>
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                        Delivery to
                    </dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(Model.RecipientName))
                        {
                            <strong>@Model.RecipientName</strong>
                        }
                        <span>@(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "Address not available" : Model.DeliveryAddress)</span>
                    </dd>
                </div>
                <div class="track-delivery-row">
                    <dt>
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
                        Contact
                    </dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.RecipientPhone) ? "—" : Model.RecipientPhone)</dd>
                </div>
                <div class="track-delivery-row">
                    <dt>
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/></svg>
                        @(delivered ? "Delivered On" : "Expected Delivery")
                    </dt>
                    <dd><strong>@expectedDelivery.ToString("dd MMM yyyy")</strong></dd>
                </div>
            </dl>
        </article>
    </section>
</div>

<script>
    document.querySelectorAll(".track-copy").forEach(function (button) {
        button.addEventListener("click", function () {
            var target = document.getElementById(button.dataset.copyTarget);
            if (!target || !navigator.clipboard) return;
            navigator.clipboard.writeText(target.textContent.trim()).then(function () {
                button.classList.add("is-copied");
                setTimeout(function () { button.classList.remove("is-copied"); }, 1500);
            });
        });
    });
</script>
