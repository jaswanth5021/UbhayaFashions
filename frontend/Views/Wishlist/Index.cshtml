@model List<ProductViewModel>
@{
    ViewData["Title"] = "My Wishlist";
}

<section class="wishlist-page">
    <header class="wishlist-header">
        <p class="wishlist-eyebrow">SAVED FOR LATER</p>
        <h1>My Wishlist</h1>
        <p>@Model.Count @(Model.Count == 1 ? "saved style" : "saved styles")</p>
        <nav class="wishlist-navigation" aria-label="Wishlist navigation">
            <a asp-controller="Home" asp-action="Index">Back to homepage</a>
            <a class="wishlist-continue-shopping" asp-controller="Products" asp-action="Index">Continue shopping</a>
        </nav>
    </header>

    @if (TempData["WishlistMessage"] is string message)
    {
        <div class="wishlist-notice" role="status" data-app-notification="success">@message</div>
    }
    @if (TempData["WishlistError"] is string error)
    {
        <div class="wishlist-notice error" role="alert" data-app-notification="warning">@error</div>
    }
    @if (ViewBag.Error is string loadError)
    {
        <div class="wishlist-notice error" role="alert" data-app-notification="warning">@loadError</div>
    }

    @if (Model.Count == 0)
    {
        <div class="wishlist-empty">
            <p>Your wishlist is waiting for something lovely.</p>
            <a class="button" asp-controller="Products" asp-action="Index">Explore the collection</a>
        </div>
    }
    else
    {
        <div class="wishlist-grid">
            @foreach (var product in Model)
            {
                var wishlistDiscount = product.Discount;
                var wishlistHasDiscount = wishlistDiscount > 0 && wishlistDiscount < 100 && product.Price > 0;
                var wishlistOriginalPrice = wishlistHasDiscount
                    ? Math.Round(product.Price / (1 - wishlistDiscount / 100m), 2)
                    : product.Price;
                <article class="wishlist-card">
                    <a class="wishlist-card-image" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@ImageUrlHelper.Resolve(product.ImageUrl, Configuration["ApiBaseUrl"])" alt="@product.Name" />
                        }
                        else
                        {
                            <span>UBHAYA</span>
                        }
                        @if (product.ReviewCount.GetValueOrDefault() > 0 && product.AverageRating.HasValue)
                        {
                            <span class="wishlist-rating-badge" aria-label="@product.AverageRating.Value.ToString("0.0") out of 5 stars from @product.ReviewCount reviews">
                                <strong>@product.AverageRating.Value.ToString("0.0")</strong>
                                <span class="wishlist-rating-star" aria-hidden="true">&#9733;</span>
                                <span class="wishlist-rating-divider" aria-hidden="true">|</span>
                                <span>@product.ReviewCount</span>
                            </span>
                        }
                    </a>
                    <div class="wishlist-card-info">
                        <p>@product.Category</p>
                        <h2><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h2>
                        <div class="wishlist-price" aria-label="Product price">
                            @if (wishlistHasDiscount)
                            {
                                <span class="wishlist-price-original">₹@wishlistOriginalPrice.ToString("N0")</span>
                                <strong class="wishlist-price-current">₹@product.Price.ToString("N0")</strong>
                                <span class="wishlist-price-discount">@wishlistDiscount.ToString("0.##")% OFF</span>
                            }
                            else
                            {
                                <strong class="wishlist-price-current">₹@product.Price.ToString("N0")</strong>
                            }
                        </div>
                        @if (product.Stock < 1)
                        {
                            <span class="wishlist-stock-out">Out of stock</span>
                        }
                        <div class="wishlist-card-actions">
                            <a class="button" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">View product</a>
                        </div>
                        <form class="wishlist-remove-form" asp-controller="Wishlist" asp-action="Toggle" method="post"
                              toolautosubmit
                              toolname="remove_from_wishlist_@product.Id"
                              tooldescription="Remove @product.Name from the shopper's wishlist.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="isWishlisted" value="true" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Wishlist")" />
                            <button class="wishlist-remove" type="submit" aria-label="Remove @product.Name from wishlist" title="Remove from wishlist">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
