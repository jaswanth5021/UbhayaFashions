@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Your cart";
    ViewData["MetaDescription"] = "Review your Ubhaya Fashions cart and continue to checkout.";
    var total = Model.Sum(item => item.Price * item.Quantity);
    var cartVariants = ViewBag.CartVariants as Dictionary<int, List<ProductVariantViewModel>> ?? new();
}

<section class="shopping-cart-page">
    <header class="shopping-cart-header">
        <div>
            <p class="shopping-cart-eyebrow">UBHAYA FASHIONS</p>
            <h1>Your cart</h1>
            <p>Review your selected styles before you continue.</p>
        </div>
        <a class="shopping-cart-continue" asp-controller="Products" asp-action="Index">Continue shopping <span aria-hidden="true">&rarr;</span></a>
    </header>

    @if (TempData["CartMessage"] is string cartMessage)
    {
        <p class="shopping-cart-message success" role="status" data-app-notification="success">@cartMessage</p>
    }
    @if (TempData["CartError"] is string cartError)
    {
        <p class="shopping-cart-message error" role="alert" data-app-notification="warning">@cartError</p>
    }

    @if (Model.Count == 0)
    {
        <div class="shopping-cart-empty">
            <span aria-hidden="true">&#10084;</span>
            <h2>Your cart is waiting for something beautiful</h2>
            <p>Explore the collection and add a style you love.</p>
            <a class="shopping-cart-checkout" asp-controller="Products" asp-action="Index">Explore the collection</a>
        </div>
    }
    else
    {
        <div class="shopping-cart-layout">
            <div class="shopping-cart-items">
                @foreach (var item in Model)
                {
                    var variants = cartVariants.GetValueOrDefault(item.ProductId, [])
                        .Where(variant => variant.Stock > 0)
                        .OrderBy(variant => variant.Size)
                        .ToList();
                    var selectedVariant = variants.FirstOrDefault(variant => string.Equals(item.Size, variant.Size, StringComparison.OrdinalIgnoreCase));

                    <article class="shopping-cart-item">
                        <a class="shopping-cart-image" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
                            <img src="@ImageUrlHelper.Resolve(item.ImageUrl, Configuration["ApiBaseUrl"])" alt="@item.Name" />
                        </a>
                        <div class="shopping-cart-item-info">
                            <p class="shopping-cart-category">UBHAYA COLLECTION</p>
                            <h2><a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">@item.Name</a></h2>
                            <form asp-controller="Cart" asp-action="Update" method="post" class="shopping-cart-update" data-cart-update>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="currentSize" value="@item.Size" />
                                <input type="hidden" name="returnUrl" value="/Cart" />
                                <label>Size
                                    <select name="size" data-cart-size>
                                        @if (variants.Count == 0)
                                        {
                                            <option value="@item.Size" selected>@item.Size</option>
                                        }
                                        else
                                        {
                                            @foreach (var variant in variants)
                                            {
                                                <option value="@variant.Size" data-stock="@variant.Stock" selected="@(string.Equals(item.Size, variant.Size, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@variant.Size</option>
                                            }
                                        }
                                    </select>
                                </label>
                                <label>Quantity
                                    <select name="quantity" data-cart-quantity>
                                        @for (var quantity = 1; quantity <= Math.Max(1, selectedVariant?.Stock ?? item.Quantity); quantity++)
                                        {
                                            <option value="@quantity" selected="@(quantity == item.Quantity ? "selected" : null)">@quantity</option>
                                        }
                                    </select>
                                </label>
                            </form>
                            <form asp-controller="Cart" asp-action="Remove" method="post" class="shopping-cart-remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="size" value="@item.Size" />
                                <button type="submit">Remove item</button>
                            </form>
                        </div>
                        <strong class="shopping-cart-price">&#8377;@((item.Price * item.Quantity).ToString("N0"))</strong>
                    </article>
                }
            </div>

            <aside class="shopping-cart-summary">
                <p class="shopping-cart-eyebrow">ORDER SUMMARY</p>
                <div><span>Subtotal</span><strong>&#8377;@total.ToString("N0")</strong></div>
                <div><span>Shipping</span><strong class="shopping-cart-free">Free</strong></div>
                <div class="shopping-cart-summary-total"><span>Estimated total</span><strong>&#8377;@total.ToString("N0")</strong></div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="shopping-cart-checkout" asp-controller="Orders" asp-action="Checkout">Continue to checkout <span aria-hidden="true">&rarr;</span></a>
                }
                else
                {
                    <a class="shopping-cart-checkout" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Orders/Checkout">Log in to checkout <span aria-hidden="true">&rarr;</span></a>
                }
                <p class="shopping-cart-note">Taxes and shipping are calculated at checkout.</p>
            </aside>
        </div>
    }
</section>
