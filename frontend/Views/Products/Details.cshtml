@model ProductViewModel

@{
    ViewData["Title"] = Model.Name;

    var variants = Model.Variants
        .OrderBy(variant => variant.Size)
        .ToList();

    var standardSizes = new[]
    {
        "S",
        "M",
        "L",
        "XL",
        "XXL",
        "3XL",
        "FREE SIZE"
    };

    var availableSizes = new HashSet<string>(
        variants
            .Where(variant => variant.Stock > 0)
            .Select(variant => variant.Size),
        StringComparer.OrdinalIgnoreCase);

    var startingVariant = variants
        .OrderBy(variant => variant.Price)
        .FirstOrDefault();

    var regularPrice =
        startingVariant is not null &&
        startingVariant.Discount > 0 &&
        startingVariant.Discount < 100
            ? Math.Round(
                startingVariant.Price /
                (1 - startingVariant.Discount / 100),
                2)
            : startingVariant?.Price ?? 0;

    var productColors = (Model.Colors ?? "")
        .Split(new[] { ',', '|', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var galleryItems = new List<(string Url, bool IsVideo)>();

    var relatedProducts =
        ViewBag.RelatedProducts as List<RelatedProductViewModel> ?? [];
    var wishlistedProductIds =
        ViewBag.WishlistedProductIds as HashSet<int> ?? [];
    var productReviews =
        ViewBag.ProductReviews as ProductReviewsViewModel ?? new ProductReviewsViewModel();
    var productReviewsError = ViewBag.ProductReviewsError as string;

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        galleryItems.Add((
            ImageUrlHelper.Resolve(
                Model.ImageUrl,
                Configuration["ApiBaseUrl"]),
            false));
    }

    galleryItems.AddRange(
        (Model.Images ?? [])
            .OrderBy(image => image.SortOrder)
            .Select(image =>
                ImageUrlHelper.Resolve(
                    image.ImageUrl,
                    Configuration["ApiBaseUrl"]))
            .Where(url => !string.IsNullOrWhiteSpace(url))
            .Select(url => (url, false)));

    galleryItems.AddRange(
        (Model.Videos ?? [])
            .OrderBy(video => video.SortOrder)
            .Select(video =>
                ImageUrlHelper.Resolve(
                    video.VideoUrl,
                    Configuration["ApiBaseUrl"]))
            .Where(url => !string.IsNullOrWhiteSpace(url))
            .Select(url => (url, true)));
}

<main class="product-details-page">

    <!-- =====================================================
         PRODUCT GALLERY
         ===================================================== -->

    <section class="product-gallery" aria-label="Product images">

        <div class="product-gallery-main"
             data-product-detail-gallery
             data-gallery-count="@galleryItems.Count">

            @if (galleryItems.Count > 0)
            {
                @if (galleryItems[0].IsVideo)
                {
                    <video id="productMainVideo"
                           src="@galleryItems[0].Url"
                           controls
                           playsinline
                           preload="metadata"
                           aria-label="@Model.Name product video">
                    </video>
                }
                else
                {
                    <img id="productMainImage"
                         src="@galleryItems[0].Url"
                         alt="@Model.Name" />
                }
            }
            else
            {
                <div class="product-gallery-placeholder">
                    UBHAYA FASHIONS
                </div>
            }

            @if (galleryItems.Count > 1)
            {
                <button type="button" class="product-gallery-arrow product-gallery-arrow-prev" data-gallery-prev aria-label="Previous product image">‹</button>
                <button type="button" class="product-gallery-arrow product-gallery-arrow-next" data-gallery-next aria-label="Next product image">›</button>
                <span class="product-gallery-counter" data-gallery-counter aria-live="polite">1/@galleryItems.Count</span>
                <button type="button" class="product-gallery-expand" data-gallery-expand aria-label="Open product image viewer">⤢</button>
            }
        </div>

        @if (galleryItems.Count > 1)
        {
            <div class="product-gallery-thumbnails"
                 aria-label="Choose product image">

                @for (var index = 0; index < galleryItems.Count; index++)
                {
                    var galleryItem = galleryItems[index];

                    <button type="button"
                            class="product-gallery-thumbnail @(index == 0 ? "active" : string.Empty)"
                            data-gallery-media="@galleryItem.Url"
                            data-gallery-type="@(galleryItem.IsVideo ? "video" : "image")"
                            data-gallery-alt="@Model.Name, @(galleryItem.IsVideo ? "video" : "image") @(index + 1)"
                            aria-label="Show @(galleryItem.IsVideo ? "video" : "image") @(index + 1)"
                            aria-pressed="@(index == 0 ? "true" : "false")">

                        @if (galleryItem.IsVideo)
                        {
                            <video src="@galleryItem.Url"
                                   muted
                                   preload="metadata"
                                   aria-hidden="true">
                            </video>

                            <span class="gallery-video-badge"
                                  aria-hidden="true">
                                PLAY
                            </span>
                        }
                        else
                        {
                            <img src="@galleryItem.Url"
                                 alt=""
                                 loading="lazy" />
                        }

                    </button>
                }

            </div>
        }

    </section>


    <!-- =====================================================
         PRODUCT INFORMATION
         ===================================================== -->

    <section class="product-details-info">

        <p class="product-details-category">
            @Model.Category
        </p>

        <div class="product-details-title-row">

            <h1>
                @Model.Name
            </h1>

            <div class="product-details-actions">

                <button type="button"
                        class="product-share-button"
                        id="shareProductButton">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="18" cy="5" r="3" />
                        <circle cx="6" cy="12" r="3" />
                        <circle cx="18" cy="19" r="3" />
                        <path d="m8.7 10.7 6.6-4.4M8.7 13.3l6.6 4.4" />
                    </svg>

                    <span>Share</span>

                </button>


                <form asp-controller="Wishlist"
                      asp-action="Toggle"
                      method="post"
                      class="product-wishlist-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="productId"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="isWishlisted"
                           value="@(ViewBag.IsWishlisted == true ? "true" : "false")" />

                    <input type="hidden"
                           name="returnUrl"
                           value="@Url.Action("Details", "Products", new { id = Model.Id })" />

                    <button type="submit"
                            class="product-wishlist-button @(ViewBag.IsWishlisted == true ? "is-saved" : string.Empty)"
                            aria-label="@(ViewBag.IsWishlisted == true ? "Remove from wishlist" : "Add to wishlist")"
                            title="@(ViewBag.IsWishlisted == true ? "Remove from wishlist" : "Add to wishlist")">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                        </svg>

                    </button>

                </form>

            </div>

        </div>


        <p class="product-share-status"
           id="shareProductStatus"
           role="status"
           aria-live="polite">
        </p>


        @if (TempData["WishlistMessage"] is string wishlistMessage)
        {
            <div class="wishlist-notice"
                 role="status">
                @wishlistMessage
            </div>
        }

        @if (TempData["WishlistError"] is string wishlistError)
        {
            <div class="wishlist-notice error"
                 role="alert">
                @wishlistError
            </div>
        }


        <!-- =====================================================
             PRICE
             ===================================================== -->

        <div class="product-details-pricing">

            <span class="product-details-regular-price"
                  id="productRegularPrice"
                  style="@(Model.Discount > 0 ? null : "display:none")">

                ₹@regularPrice.ToString("N0")

            </span>

            <span class="product-details-price"
                  id="productSalePrice">

                ₹@Model.Price.ToString("N0")

            </span>

            <span class="product-details-sale-badge"
                  id="productSaleBadge"
                  style="@(Model.Discount > 0 ? null : "display:none")">

                -@Model.Discount% SALE

            </span>

        </div>


      <p class="product-tax-note">

    Taxes included.

    <a asp-controller="Shipping"
       asp-action="Index">

        Shipping details

    </a>

</p>

        @if (productReviews.ReviewCount > 0)
        {
            <a class="product-inline-rating"
               href="#productReviews"
               aria-label="View @productReviews.ReviewCount customer reviews">
                <span aria-hidden="true">★★★★★</span>
                <strong>@productReviews.AverageRating.ToString("0.0")</strong>
                <span>(@productReviews.ReviewCount review@(productReviews.ReviewCount == 1 ? "" : "s"))</span>
            </a>
        }


        <!-- =====================================================
             SHIPPING PROMOTIONS
             ===================================================== -->

        @* <div class="product-shipping-promos">

            <p>
                🚚 <strong>Free Shipping</strong> above ₹999
            </p>

            <p>
                🔥 <strong>Most Loved:</strong>
                Buy any 2 &amp; save ₹99
            </p>

            <p>
                💛 <strong>Best Value:</strong>
                Buy any 3 &amp; save ₹199
            </p>

        </div> *@


        @if (TempData["CartError"] is string cartError)
        {
            <div class="product-purchase-warning product-toast"
                 role="alert"
                 aria-live="assertive">

                <span>
                    @cartError
                </span>

                <button type="button"
                        class="product-toast-close"
                        aria-label="Dismiss warning">

                    ×

                </button>

            </div>
        }


        <p class="product-details-description">
            @Model.Description
        </p>


        @if (variants.Count > 0)
        {
            <div class="product-stock-panel"
                 id="productStockPanel"
                 aria-live="polite">

                <div class="product-stock-row">
                    <span id="productStockMessage">Select a size to see availability</span>
                    <span id="productStockCount"></span>
                </div>

                <div class="product-stock-meter"
                     aria-hidden="true">
                    <span id="productStockMeter"></span>
                </div>

                <small id="productStockHint">
                    Select your size to check live availability.
                </small>
            </div>


            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post"
                  class="product-details-form"
                  id="productPurchaseForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="productId"
                       value="@Model.Id" />


                <!-- =================================================
                     SIZE SELECTOR
                     ================================================= -->

                @if (variants.Count > 0)
                {
                    <fieldset class="product-size-fieldset"
                              data-size-required="true">

                        <legend>

                            Size

                            <span id="selectedSizeLabel">
                                Select a size
                            </span>

                            <button type="button" class="product-size-guide-link" data-size-guide-open>
                                Size Guide
                            </button>

                        </legend>


                        <input id="productSize"
                               name="size"
                               type="hidden" />


                        <div class="product-size-options">

                            @foreach (var size in standardSizes)
                            {
                                var isAvailable =
                                    availableSizes.Contains(size);

                                var variant =
                                    variants.FirstOrDefault(item =>
                                        item.Size.Equals(
                                            size,
                                            StringComparison.OrdinalIgnoreCase));


                                <button type="button"
                                        class="product-size-option @(isAvailable ? "available" : "unavailable")"
                                        data-size="@size"
                                        data-price="@((variant?.Price ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-discount="@((variant?.Discount ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-stock="@(variant?.Stock ?? 0)"
                                        aria-pressed="false"
                                        disabled="@(!isAvailable)"
                                        title="@(isAvailable ? size : "Out of stock")">

                                    <span class="product-size-label">
                                        @size
                                    </span>

                                    @if (!isAvailable)
                                    {
                                        <span class="product-size-stock">
                                            Out of stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-size-price">
                                            ₹@variant!.Price.ToString("N0")
                                        </span>
                                    }

                                </button>
                            }

                        </div>


                        <span class="product-size-error"
                              id="productSizeError"
                              role="alert">
                        </span>

                    </fieldset>
                }


                <!-- =================================================
                     COLOR
                     ================================================= -->

                 @* @if (productColors.Count > 0)
                {
                    <fieldset class="product-color-fieldset">
                        <legend>
                            Color
                            <span id="selectedColorLabel">@productColors[0]</span>
                        </legend>

                        <div class="product-color-options" role="radiogroup" aria-label="Choose color">
                            @foreach (var color in productColors)
                            {
                                <button type="button"
                                        class="product-color-option @(color.Equals(productColors[0], StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                        data-color="@color"
                                        aria-label="@color"
                                        aria-pressed="@(color.Equals(productColors[0], StringComparison.OrdinalIgnoreCase) ? "true" : "false")">
                                    <span class="product-color-swatch"
                                          data-color-name="@color"
                                          aria-hidden="true"></span>
                                    <span class="product-color-name">@color</span>
                                </button>
                            }
                        </div>
                    </fieldset>
                } *@


                <!-- =================================================
                     QUANTITY
                     ================================================= -->

                <label for="productQuantity">
                    Quantity
                </label>


                <div class="product-quantity-control">

                    <button type="button"
                            data-quantity-step="-1"
                            aria-label="Decrease quantity">

                        −

                    </button>


                    <input id="productQuantity"
                           type="number"
                           name="quantity"
                           value="1"
                           min="1"
                           max="@Model.Stock"
                           step="1"
                           inputmode="numeric" />


                    <button type="button"
                            data-quantity-step="1"
                            aria-label="Increase quantity">

                        +

                    </button>

                </div>


                <span class="product-quantity-error"
                      id="productQuantityError"
                      role="alert">
                </span>


                <!-- =================================================
                     PURCHASE BUTTONS
                     ================================================= -->

                <div class="product-purchase-buttons">

                    <button class="button product-add-button"
                            type="submit"
                            name="buyNow"
                            value="false">

                        ADD TO CART

                    </button>


                    <button class="button product-buy-button"
                            type="submit"
                            name="buyNow"
                            value="true">

                        BUY IT NOW

                    </button>

                </div>


                <div class="product-checkout-assurances">

                    <p>
                        ✔ Secure checkout
                    </p>

                    <p>
                        ✔ Fast dispatch within 24–48 hours
                    </p>

                </div>

            </form>
        }
        else
        {
            <p class="product-details-out-of-stock">
                OUT OF STOCK
            </p>
        }

    </section>

</main>

<div class="product-mobile-sticky-bar" id="productMobileStickyBar" aria-label="Quick purchase">
    <div class="product-mobile-sticky-price">
        <span>₹<span data-sticky-price>@Model.Price.ToString("N0")</span></span>
        <small data-sticky-stock>Select size</small>
    </div>
    <button type="button" class="product-mobile-sticky-button" data-sticky-add>ADD TO BAG</button>
</div>

<dialog class="product-size-guide" id="productSizeGuide" aria-labelledby="productSizeGuideTitle">
    <div class="product-size-guide-card">
        <div class="product-size-guide-header">
            <div>
                <p>UBHAYA FIT GUIDE</p>
                <h2 id="productSizeGuideTitle">Find your size</h2>
            </div>
            <button type="button" data-size-guide-close aria-label="Close size guide">×</button>
        </div>
        <p class="product-size-guide-intro">Choose the size that normally fits you best. If you prefer a relaxed fit, consider going one size up.</p>
        <div class="product-size-guide-table">
            <div><strong>Size</strong><strong>Suggested fit</strong></div>
            <div><span>S</span><span>Small / regular fit</span></div>
            <div><span>M</span><span>Medium / regular fit</span></div>
            <div><span>L</span><span>Large / regular fit</span></div>
            <div><span>XL</span><span>Extra large / regular fit</span></div>
            <div><span>XXL</span><span>Relaxed fit</span></div>
            <div><span>3XL</span><span>Relaxed fit</span></div>
            <div><span>FREE SIZE</span><span>One-size style</span></div>
        </div>
        <p class="product-size-guide-note">For the most accurate choice, compare your measurements with the garment details shown on the product or contact us before ordering.</p>
    </div>
</dialog>


<!-- =============================================================
     CUSTOMER REVIEWS
     ============================================================= -->

<section class="product-reviews"
         id="productReviews"
         aria-labelledby="productReviewsTitle">

    <div class="product-reviews-inner">

        <div class="product-reviews-heading">
            <div>
                <p class="product-reviews-eyebrow">REAL CUSTOMER FEEDBACK</p>
                <h2 id="productReviewsTitle">Customer Reviews</h2>
            </div>

            @if (productReviews.ReviewCount > 0)
            {
                <div class="product-reviews-score" aria-label="@productReviews.AverageRating out of 5 stars from @productReviews.ReviewCount reviews">
                    <strong>@productReviews.AverageRating.ToString("0.0")</strong>
                    <span class="product-review-stars" aria-hidden="true">★★★★★</span>
                    <small>@productReviews.ReviewCount review@(productReviews.ReviewCount == 1 ? "" : "s")</small>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(productReviewsError))
            {
                <span class="product-review-eligibility-notice">Review options are temporarily unavailable.</span>
            }
            else if (User.Identity?.IsAuthenticated == true && !productReviews.HasReviewed)
            {
                <button class="product-review-button"
                        type="button"
                        id="writeReviewButton"
                        data-can-review="@productReviews.CanReview.ToString().ToLowerInvariant()">
                    Write a review
                </button>
            }
            else if (User.Identity?.IsAuthenticated == true && productReviews.HasReviewed)
            {
                <span class="product-review-eligibility-notice">
                    You have already reviewed this product.
                </span>
            }
            else
            {
                <a class="product-review-button"
                   asp-controller="Account"
                   asp-action="Login"
                   asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}#productReviews")">
                    Write a review
                </a>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(productReviewsError))
        {
            <div class="product-review-notice error" role="alert">
                <span aria-hidden="true">!</span>
                @productReviewsError
            </div>
        }

        @if (TempData["ReviewMessage"] is string reviewMessage)
        {
            <div class="product-review-notice success" role="status">
                <span aria-hidden="true">✓</span>
                @reviewMessage
            </div>
        }

        @if (TempData["ReviewError"] is string reviewError)
        {
            <div class="product-review-notice error" role="alert">
                <span aria-hidden="true">!</span>
                @reviewError
            </div>
        }

        @if (productReviews.ReviewCount > 0)
        {
            <div class="product-reviews-layout">

                <aside class="product-review-summary">
                    <div class="product-review-average">
                        <strong>@productReviews.AverageRating.ToString("0.0")</strong>
                        <span class="product-review-stars" aria-hidden="true">★★★★★</span>
                        <small>Based on @productReviews.ReviewCount review@(productReviews.ReviewCount == 1 ? "" : "s")</small>
                    </div>

                    <div class="product-review-breakdown">
                        @for (var rating = 5; rating >= 1; rating--)
                        {
                            var ratingCount = productReviews.RatingBreakdown.TryGetValue(rating, out var count) ? count : 0;
                            var percentage = productReviews.ReviewCount == 0
                                ? 0
                                : (int)Math.Round(ratingCount * 100d / productReviews.ReviewCount);

                            <div class="product-review-breakdown-row">
                                <span>@rating ★</span>
                                <span class="product-review-breakdown-track">
                                    <span style="width:@percentage%"></span>
                                </span>
                                <small>@percentage%</small>
                            </div>
                        }
                    </div>
                </aside>

                <div class="product-review-list">
            @foreach (var review in productReviews.Reviews)
                    {
                        <article class="product-review-card">
                            <div class="product-review-card-top">
                                <div>
                                    <span class="product-review-card-stars" aria-label="@review.Rating out of 5 stars">
                                        @("★★★★★".Substring(0, review.Rating))
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <h3>@review.Title</h3>
                                    }
                                </div>

                                @if (review.VerifiedPurchase)
                                {
                                    <span class="product-review-verified">✓ Verified Purchase</span>
                                }
                            </div>

                            <p class="product-review-comment">@review.Comment</p>

                            @if (review.Images.Count > 0)
                            {
                                <div class="product-review-images" aria-label="Customer review photos">
                                    @foreach (var imageUrl in review.Images)
                                    {
                                        <a href="@ImageUrlHelper.Resolve(imageUrl, Configuration["ApiBaseUrl"])" target="_blank" rel="noopener">
                                            <img src="@ImageUrlHelper.Resolve(imageUrl, Configuration["ApiBaseUrl"])" alt="Photo shared in a customer review" loading="lazy" />
                                        </a>
                                    }
                                </div>
                            }

                            <div class="product-review-meta">
                                <strong>@review.CustomerName</strong>
                                <span>·</span>
                                <time datetime="@review.CreatedDate.ToString("yyyy-MM-dd")">
                                    @review.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                                </time>
                            </div>
                        </article>
                    }
                </div>

            </div>
        }
        else if (string.IsNullOrWhiteSpace(productReviewsError))
        {
            <div class="product-reviews-empty">
                <div class="product-reviews-empty-icon" aria-hidden="true">★</div>
                <h3>Be the first to write a review</h3>

                @if (User.Identity?.IsAuthenticated == true && productReviews.HasReviewed)
                {
                    <p>Thank you for sharing your experience with this product.</p>
                }
                else if (User.Identity?.IsAuthenticated == true && !productReviews.CanReview)
                {
                    <p>Reviews are available after you purchase this product.</p>
                }
                else
                {
                    <p>Share your experience and help other customers choose the right style.</p>
                }

            </div>
        }

        @if (string.IsNullOrWhiteSpace(productReviewsError) && User.Identity?.IsAuthenticated == true && productReviews.CanReview)
        {
            <form asp-controller="Products"
                  asp-action="SubmitReview"
                  method="post"
                  enctype="multipart/form-data"
                  class="product-review-form"
                  id="productReviewForm"
                  hidden>

                @Html.AntiForgeryToken()

                <input type="hidden" name="productId" value="@Model.Id" />

                <div class="product-review-form-header">
                    <div>
                        <p class="product-reviews-eyebrow">SHARE YOUR EXPERIENCE</p>
                        <h3>Write a review for @Model.Name</h3>
                    </div>
                </div>

                <div class="product-review-form-grid">
                    <div>
                        <label for="reviewRating">Your rating</label>
                        <select id="reviewRating" name="Rating" required>
                            <option value="">Choose a rating</option>
                            <option value="5">★★★★★ — Excellent</option>
                            <option value="4">★★★★ — Good</option>
                            <option value="3">★★★ — Average</option>
                            <option value="2">★★ — Below average</option>
                            <option value="1">★ — Poor</option>
                        </select>
                    </div>

                    <div>
                        <label for="reviewTitle">Review title <span>(optional)</span></label>
                        <input id="reviewTitle"
                               name="Title"
                               type="text"
                               maxlength="100"
                               placeholder="What stood out to you?" />
                    </div>
                </div>

                <label for="reviewBody">Your review <span>(optional)</span></label>
                <textarea id="reviewBody"
                          name="Comment"
                          rows="5"
                          maxlength="2000"
                          placeholder="Tell us about the fit, fabric, quality and overall experience."></textarea>

                <label for="reviewImages">Add photos <span>(optional, up to 5)</span></label>
                <input id="reviewImages" name="Images" type="file" accept="image/jpeg,image/png,image/webp" multiple />
                <p class="product-review-upload-hint">JPG, PNG or WebP. Maximum 5 MB per image.</p>
                <div class="product-review-image-preview" id="reviewImagePreview" aria-live="polite"></div>

                <div class="product-review-form-footer">
                    <p>Only customers who purchased this product can submit a review.</p>
                    <button class="product-review-submit"
                            type="submit">
                        Submit review
                    </button>
                </div>
            </form>
        }

    </div>

</section>


<!-- =============================================================
     YOU MAY ALSO LIKE
     ============================================================= -->

@if (relatedProducts.Count > 0)
{
    <section class="product-bestsellers"
             aria-labelledby="productBestsellersTitle">

        <div class="product-bestsellers-inner">

            <p class="catalog-eyebrow">
                DISCOVER MORE
            </p>

            <h2 id="productBestsellersTitle">
                You may also like
            </h2>


            <div class="product-bestsellers-grid">

                @foreach (var item in relatedProducts)
                {
                    var hasDiscount =
                        item.Discount > 0 &&
                        item.Discount < 100;

                    var originalPrice =
                        hasDiscount
                            ? item.Price /
                              (1 - item.Discount / 100)
                            : item.Price;


                    <article class="product-bestseller-card">
                    <a class="product-bestseller-link"
                       asp-action="Details"
                       asp-route-id="@item.Id">

                        <div class="product-bestseller-image-wrap">

                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@ImageUrlHelper.Resolve(item.ImageUrl, Configuration["ApiBaseUrl"])"
                                     alt="@item.Name"
                                     loading="lazy"
                                     onerror="this.hidden=true; this.nextElementSibling.hidden=false" />
                                <div class="product-bestseller-image-fallback" hidden>
                                    UBHAYA
                                </div>
                            }
                            else
                            {
                                <div class="product-bestseller-image-fallback">
                                    UBHAYA
                                </div>
                            }


                            @if (item.Discount > 0 && item.Discount < 100)
                            {
                                <span class="product-bestseller-discount">
                                    -@item.Discount% OFF
                                </span>
                            }

                        </div>

                    </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var isRelatedWishlisted = wishlistedProductIds.Contains(item.Id);
                            <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="product-related-wishlist-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="isWishlisted" value="@isRelatedWishlisted.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Products", new { id = Model.Id })" />
                                <button type="submit" class="product-related-wishlist @(isRelatedWishlisted ? "is-saved" : string.Empty)" aria-label="@(isRelatedWishlisted ? "Remove from wishlist" : "Add to wishlist")" title="@(isRelatedWishlisted ? "Remove from wishlist" : "Add to wishlist")" aria-pressed="@isRelatedWishlisted.ToString().ToLowerInvariant()">
                                    <span aria-hidden="true">♡</span>
                                </button>
                            </form>
                        }


                    <a class="product-bestseller-link" asp-action="Details" asp-route-id="@item.Id">
                        <span class="product-bestseller-category">
                            @item.Category
                        </span>


                        <h3>
                            @item.Name
                        </h3>


                        <div class="product-bestseller-pricing">

                            <span class="product-bestseller-price">
                                ₹@item.Price.ToString("N0")
                            </span>


                            @if (hasDiscount)
                            {
                                <span class="product-bestseller-original-price">
                                    ₹@Math.Round(originalPrice).ToString("N0")
                                </span>
                            }

                        </div>
                    </a>

                    </article>
                }

            </div>

        </div>

    </section>
}


<!-- =============================================================
     IMAGE ZOOM
     ============================================================= -->

<dialog class="product-image-zoom"
        id="productImageZoom"
        aria-label="Product image viewer">

    <div class="product-image-zoom-toolbar">

        <button type="button"
                id="zoomOutButton"
                aria-label="Zoom out">
            −
        </button>

        <button type="button"
                id="zoomResetButton">
            Reset
        </button>

        <button type="button"
                id="zoomInButton"
                aria-label="Zoom in">
            +
        </button>

        <button type="button"
                id="closeZoomButton"
                class="product-image-zoom-close"
                aria-label="Close image viewer">
            ×
        </button>

    </div>


    <div class="product-image-zoom-stage">

        <img id="productZoomImage"
             alt="" />

    </div>

</dialog>


<script>

    /* =========================================================
       PRODUCT DETAIL GALLERY
       ========================================================= */

    (() => {
        const gallery = document.querySelector("[data-product-detail-gallery]");
        if (!gallery) return;
        const thumbnails = Array.from(document.querySelectorAll(".product-gallery-thumbnail"));
        const counter = gallery.querySelector("[data-gallery-counter]");
        let currentIndex = 0;
        let touchStartX = 0;

        const render = index => {
            if (!thumbnails.length) return;
            currentIndex = (index + thumbnails.length) % thumbnails.length;
            thumbnails[currentIndex].click();
            if (counter) counter.textContent = (currentIndex + 1) + "/" + thumbnails.length;
        };

        gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => render(currentIndex - 1));
        gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => render(currentIndex + 1));

        gallery.addEventListener("touchstart", event => {
            touchStartX = event.changedTouches[0]?.screenX ?? 0;
        }, { passive: true });

        gallery.addEventListener("touchend", event => {
            const endX = event.changedTouches[0]?.screenX ?? 0;
            const delta = endX - touchStartX;
            if (Math.abs(delta) < 45) return;
            render(currentIndex + (delta < 0 ? 1 : -1));
        }, { passive: true });

        gallery.querySelector("[data-gallery-expand]")?.addEventListener("click", () => {
            document.querySelector(".product-gallery-main img")?.click();
        });
    })();


    /* =========================================================
       IMAGE ZOOM
       ========================================================= */

    (() => {

        const dialog =
            document.getElementById("productImageZoom");

        const zoomImage =
            document.getElementById("productZoomImage");

        let zoom = 1;


        const applyZoom = () => {

            zoomImage.style.transform =
                `scale(${zoom})`;

        };


        const setZoom = value => {

            zoom =
                Math.min(
                    4,
                    Math.max(1, value)
                );

            applyZoom();

        };


        document
            .querySelector(".product-gallery-main")
            ?.addEventListener(
                "click",
                event => {

                    const image =
                        event.target.closest("img");

                    if (!image)
                        return;


                    zoomImage.src =
                        image.currentSrc ||
                        image.src;

                    zoomImage.alt =
                        image.alt;


                    setZoom(1);

                    dialog.showModal();

                });


        document
            .getElementById("zoomInButton")
            ?.addEventListener(
                "click",
                () => setZoom(zoom + .5)
            );


        document
            .getElementById("zoomOutButton")
            ?.addEventListener(
                "click",
                () => setZoom(zoom - .5)
            );


        document
            .getElementById("zoomResetButton")
            ?.addEventListener(
                "click",
                () => setZoom(1)
            );


        document
            .getElementById("closeZoomButton")
            ?.addEventListener(
                "click",
                () => dialog.close()
            );


        dialog?.addEventListener(
            "click",
            event => {

                if (event.target === dialog)
                    dialog.close();

            });

    })();


    /* =========================================================
       SHARE PRODUCT
       ========================================================= */

    document
        .getElementById("shareProductButton")
        ?.addEventListener(
            "click",
            async () => {

                const button =
                    document.getElementById(
                        "shareProductButton"
                    );

                const status =
                    document.getElementById(
                        "shareProductStatus"
                    );


                const shareData = {

                    title:
                        document
                            .querySelector(
                                ".product-details-title-row h1"
                            )
                            .textContent
                            .trim(),

                    url:
                        window.location.href

                };


                if (navigator.share) {

                    try {

                        await navigator.share(
                            shareData
                        );

                        return;

                    }
                    catch (error) {

                        if (
                            error.name ===
                            "AbortError"
                        ) {
                            return;
                        }

                    }

                }


                try {

                    await navigator.clipboard
                        .writeText(
                            shareData.url
                        );

                }
                catch {

                    const input =
                        document.createElement(
                            "textarea"
                        );

                    input.value =
                        shareData.url;

                    input.style.position =
                        "fixed";

                    input.style.opacity =
                        "0";

                    document.body.appendChild(
                        input
                    );

                    input.select();

                    document.execCommand(
                        "copy"
                    );

                    input.remove();

                }


                status.textContent =
                    "Product link copied.";

                button
                    .querySelector("span")
                    .textContent =
                    "Copied";


                setTimeout(
                    () => {

                        button
                            .querySelector("span")
                            .textContent =
                            "Share";

                    },
                    2200
                );

            });


    /* =========================================================
       VIDEO HOVER PLAYBACK
       ========================================================= */

    const enableHoverPlayback =
        video => {

            video.addEventListener(
                "pointerenter",
                () => {

                    video.muted = true;

                    video
                        .play()
                        .catch(() => {});

                });


            video.addEventListener(
                "pointerleave",
                () => video.pause()
            );

        };


    document
        .querySelectorAll(
            ".product-gallery video"
        )
        .forEach(
            enableHoverPlayback
        );


    /* =========================================================
       REVIEW FORM
       ========================================================= */

    document
        .getElementById("writeReviewButton")
        ?.addEventListener(
            "click",
            () => {

                const reviewButton =
                    document.getElementById(
                        "writeReviewButton"
                    );

                const reviewForm =
                    document.getElementById(
                        "productReviewForm"
                    );

                if (
                    reviewButton?.dataset.canReview !== "true"
                ) {
                    let notice =
                        document.getElementById(
                            "reviewEligibilityNotice"
                        );

                    if (!notice) {
                        notice =
                            document.createElement("div");
                        notice.id =
                            "reviewEligibilityNotice";
                        notice.className =
                            "product-review-eligibility-notice";
                        notice.textContent =
                            "You can review this product after purchasing it.";
                        reviewButton
                            .closest(".product-reviews-heading")
                            ?.after(notice);
                    }

                    notice.hidden = false;
                    notice.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                    return;
                }

                if (!reviewForm) return;

                reviewForm.hidden =
                    !reviewForm.hidden;

                if (!reviewForm.hidden) {

                    reviewForm.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    document
                        .getElementById(
                            "reviewRating"
                        )
                        ?.focus();

                }

            });

    document.getElementById("reviewImages")?.addEventListener("change", event => {
        const input = event.currentTarget;
        const preview = document.getElementById("reviewImagePreview");
        if (!input || !preview) return;
        if (input.files.length > 5) {
            input.value = "";
            preview.textContent = "Please choose no more than five images.";
            return;
        }
        preview.replaceChildren();
        Array.from(input.files).forEach(file => {
            const image = document.createElement("img");
            image.alt = file.name;
            image.src = URL.createObjectURL(file);
            preview.append(image);
        });
    });


    /* =========================================================
       PRODUCT TOAST
       ========================================================= */

    const showProductToast =
        message => {

            let toast =
                document.querySelector(
                    ".product-toast"
                );


            if (!toast) {

                toast =
                    document.createElement(
                        "div"
                    );

                toast.className =
                    "product-purchase-warning product-toast";

                toast.setAttribute(
                    "role",
                    "alert"
                );

                toast.setAttribute(
                    "aria-live",
                    "assertive"
                );


                toast.innerHTML =
                    '<span></span>' +
                    '<button type="button" ' +
                    'class="product-toast-close" ' +
                    'aria-label="Dismiss warning">' +
                    '×' +
                    '</button>';


                document.body.appendChild(
                    toast
                );

            }


            toast
                .querySelector("span")
                .textContent =
                message;


            toast.classList.add(
                "is-visible"
            );


            clearTimeout(
                toast.dismissTimer
            );


            toast.dismissTimer =
                setTimeout(
                    () =>
                        toast.classList
                            .remove(
                                "is-visible"
                            ),
                    6000
                );

        };


    document
        .querySelectorAll(
            ".product-toast"
        )
        .forEach(
            toast => {

                toast.classList.add(
                    "is-visible"
                );


                toast
                    .querySelector(
                        ".product-toast-close"
                    )
                    ?.addEventListener(
                        "click",
                        () =>
                            toast.classList
                                .remove(
                                    "is-visible"
                                )
                    );


                setTimeout(
                    () =>
                        toast.classList
                            .remove(
                                "is-visible"
                            ),
                    6000
                );

            });


    document.addEventListener(
        "click",
        event => {

            if (
                event.target.closest(
                    ".product-toast-close"
                )
            ) {

                event.target
                    .closest(
                        ".product-toast"
                    )
                    ?.classList
                    .remove(
                        "is-visible"
                    );

            }

        });


    /* =========================================================
       PRODUCT GALLERY
       ========================================================= */

    document
        .querySelectorAll(
            ".product-gallery-thumbnail"
        )
        .forEach(
            thumbnail => {

                thumbnail.addEventListener(
                    "click",
                    () => {

                        const galleryMain =
                            document.querySelector(
                                ".product-gallery-main"
                            );


                        const mediaUrl =
                            thumbnail.dataset
                                .galleryMedia;


                        if (
                            thumbnail.dataset
                                .galleryType ===
                            "video"
                        ) {

                            galleryMain.innerHTML =
                                "";


                            const video =
                                document.createElement(
                                    "video"
                                );


                            video.id =
                                "productMainVideo";

                            video.src =
                                mediaUrl;

                            video.controls =
                                true;

                            video.playsInline =
                                true;

                            video.preload =
                                "metadata";

                            video.muted =
                                true;

                            video.setAttribute(
                                "aria-label",
                                thumbnail.dataset
                                    .galleryAlt
                            );


                            enableHoverPlayback(
                                video
                            );


                            galleryMain.appendChild(
                                video
                            );

                        }
                        else {

                            galleryMain.innerHTML =
                                "";


                            const image =
                                document.createElement(
                                    "img"
                                );


                            image.id =
                                "productMainImage";

                            image.src =
                                mediaUrl;

                            image.alt =
                                thumbnail.dataset
                                    .galleryAlt;


                            galleryMain.appendChild(
                                image
                            );

                        }


                        document
                            .querySelectorAll(
                                ".product-gallery-thumbnail"
                            )
                            .forEach(
                                item => {

                                    const active =
                                        item ===
                                        thumbnail;


                                    item.classList.toggle(
                                        "active",
                                        active
                                    );


                                    item.setAttribute(
                                        "aria-pressed",
                                        active
                                            ? "true"
                                            : "false"
                                    );

                                });

                    });

            });


    /* =========================================================
       COLOR SELECTION
       ========================================================= */

    (() => {
        const buttons = document.querySelectorAll(".product-color-option");
        const label = document.getElementById("selectedColorLabel");

        buttons.forEach(button => {
            button.addEventListener("click", () => {
                buttons.forEach(item => {
                    const selected = item === button;
                    item.classList.toggle("selected", selected);
                    item.setAttribute("aria-pressed", selected ? "true" : "false");
                });

                if (label) {
                    label.textContent = button.dataset.color || "";
                }
            });
        });

        document.querySelectorAll(".product-color-swatch").forEach(swatch => {
            const name = (swatch.dataset.colorName || "").toLowerCase();
            const palette = {
                red: "#c73b4d", maroon: "#68142e", burgundy: "#68142e",
                pink: "#ec4f8a", rose: "#d98c9b", blue: "#2d75b6",
                navy: "#183b63", green: "#5d8069", teal: "#2b8b87",
                yellow: "#e4bd43", mustard: "#c89d2e", orange: "#d97836",
                brown: "#7a513b", beige: "#dfc5a7", cream: "#f3e4c8",
                white: "#ffffff", black: "#171717", grey: "#8f8f8f",
                gray: "#8f8f8f", purple: "#7a55a8"
            };

            const key = Object.keys(palette).find(color => name.includes(color));
            swatch.style.backgroundColor = key ? palette[key] : "#c8b7b0";
        });
    })();


    /* =========================================================
       SIZE GUIDE
       ========================================================= */

    (() => {
        const dialog = document.getElementById("productSizeGuide");
        const openButton = document.querySelector("[data-size-guide-open]");
        const closeButton = dialog?.querySelector("[data-size-guide-close]");
        openButton?.addEventListener("click", () => dialog?.showModal());
        closeButton?.addEventListener("click", () => dialog?.close());
        dialog?.addEventListener("click", event => {
            if (event.target === dialog) dialog.close();
        });
    })();


    /* =========================================================
       SIZE SELECTION
       ========================================================= */

    document
        .querySelectorAll(
            ".product-size-option.available"
        )
        .forEach(
            option => {

                option.addEventListener(
                    "click",
                    () => {

                        /* -----------------------------------------
                           Selected size
                           ----------------------------------------- */

                        document.getElementById(
                            "productSize"
                        ).value =
                            option.dataset.size;


                        document.getElementById(
                            "selectedSizeLabel"
                        ).textContent =
                            option.dataset.size;


                        document.getElementById(
                            "productSizeError"
                        ).textContent =
                            "";


                        /* -----------------------------------------
                           Get selected variant information
                           ----------------------------------------- */

                        const price =
                            Number(
                                option.dataset.price
                            );


                        const discount =
                            Number(
                                option.dataset.discount
                            );


                        const stock =
                            Number(
                                option.dataset.stock
                            );


                        /* -----------------------------------------
                           Calculate regular price
                           ----------------------------------------- */

                        const regularPrice =
                            discount > 0 &&
                            discount < 100

                                ? price /
                                  (1 -
                                   discount / 100)

                                : price;


                        /* -----------------------------------------
                           Currency formatting
                           ----------------------------------------- */

                        const formatPrice =
                            value =>
                                new Intl.NumberFormat(
                                    "en-IN",
                                    {
                                        style:
                                            "currency",

                                        currency:
                                            "INR",

                                        maximumFractionDigits:
                                            0
                                    }
                                ).format(value);


                        /* -----------------------------------------
                           Update sale price
                           ----------------------------------------- */

                        document.getElementById(
                            "productSalePrice"
                        ).textContent =
                            formatPrice(price);


                        /* -----------------------------------------
                           Update regular price
                           ----------------------------------------- */

                        const regularPriceElement =
                            document.getElementById(
                                "productRegularPrice"
                            );


                        if (regularPriceElement) {

                            regularPriceElement
                                .textContent =
                                formatPrice(
                                    regularPrice
                                );


                            regularPriceElement
                                .style.display =
                                discount > 0
                                    ? "inline"
                                    : "none";

                        }


                        /* -----------------------------------------
                           Update sale badge
                           ----------------------------------------- */

                        const saleBadge =
                            document.getElementById(
                                "productSaleBadge"
                            );


                        if (saleBadge) {

                            saleBadge.textContent =
                                `-${discount}% SALE`;


                            saleBadge.style.display =
                                discount > 0
                                    ? "inline-block"
                                    : "none";

                        }


                        /* -----------------------------------------
                           UPDATE STOCK MESSAGE

                           Stock 1:
                           Hurry! Only 1 left in stock

                           Stock 2+:
                           Size M is available
                           ----------------------------------------- */

                        const stockMessage =
                            document.getElementById(
                                "productStockMessage"
                            );


                        const stockCount = document.getElementById("productStockCount");
                        const stockMeter = document.getElementById("productStockMeter");
                        const stockHint = document.getElementById("productStockHint");

                        if (stockMessage) {
                            if (stock <= 0) {
                                stockMessage.textContent = "Out of stock";
                                stockMessage.classList.add("is-out");
                            } else if (stock <= 3) {
                                stockMessage.textContent = `Hurry! Only ${stock} left`;
                                stockMessage.classList.remove("is-out");
                            } else {
                                stockMessage.textContent = `Size ${option.dataset.size} is available`;
                                stockMessage.classList.remove("is-out");
                            }
                        }

                        if (stockCount) {
                            stockCount.textContent =
                                stock > 0 ? `${stock} available` : "Unavailable";
                        }

                        if (stockMeter) {
                            const percentage = stock <= 0
                                ? 0
                                : Math.min(100, Math.max(12, stock <= 3 ? stock * 25 : 100));
                            stockMeter.style.width = percentage + "%";
                        }

                        if (stockHint) {
                            stockHint.textContent =
                                stock <= 0
                                    ? "Please choose another size."
                                    : stock <= 3
                                        ? "Popular size — order soon before it sells out."
                                        : "Available to order now."; 
                        }


                        /* -----------------------------------------
                           Update quantity maximum
                           ----------------------------------------- */

                        if (quantityInput) {

                            quantityInput.max =
                                stock;


                            quantityInput.value =
                                Math.min(
                                    Number(
                                        quantityInput.value
                                    ) || 1,
                                    stock
                                );

                        }


                        /* -----------------------------------------
                           Mark selected size
                           ----------------------------------------- */

                        const stickyPrice = document.querySelector("[data-sticky-price]");
                        if (stickyPrice) {
                            stickyPrice.textContent = price.toLocaleString("en-IN", { maximumFractionDigits: 0 });
                        }

                        const stickyStock = document.querySelector("[data-sticky-stock]");
                        if (stickyStock) {
                            stickyStock.textContent = stock === 1 ? "Only 1 left" : (stock + " available");
                        }

                        document
                            .querySelectorAll(
                                ".product-size-option"
                            )
                            .forEach(
                                item => {

                                    const selected =
                                        item === option;


                                    item.classList.toggle(
                                        "selected",
                                        selected
                                    );


                                    item.setAttribute(
                                        "aria-pressed",
                                        selected
                                            ? "true"
                                            : "false"
                                    );

                                });

                    });

            });


    /* =========================================================
       MOBILE STICKY ADD TO BAG
       ========================================================= */

    (() => {
        const stickyButton = document.querySelector("[data-sticky-add]");
        const form = document.getElementById("productPurchaseForm");
        if (!stickyButton || !form) return;

        stickyButton.addEventListener("click", () => {
            const size = document.getElementById("productSize");
            const sizeFieldset = document.querySelector(".product-size-fieldset");
            if (sizeFieldset && !size?.value) {
                document.getElementById("productSizeError").textContent = "Please select an available size.";
                sizeFieldset.scrollIntoView({ behavior: "smooth", block: "center" });
                return;
            }
            form.querySelector('[name="buyNow"][value="false"]')?.click();
        });
    })();


    /* =========================================================
       QUANTITY
       ========================================================= */

    const quantityInput =
        document.getElementById(
            "productQuantity"
        );


    quantityInput
        ?.addEventListener(
            "input",
            () => {

                document.getElementById(
                    "productQuantityError"
                ).textContent =
                    "";

            });


    document
        .querySelectorAll(
            "[data-quantity-step]"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        const minimum =
                            Number(
                                quantityInput.min
                            ) || 1;


                        const maximum =
                            Number(
                                quantityInput.max
                            ) ||
                            Number.MAX_SAFE_INTEGER;


                        const next =
                            Number(
                                quantityInput.value ||
                                minimum
                            ) +
                            Number(
                                button.dataset
                                    .quantityStep
                            );


                        quantityInput.value =
                            Math.max(
                                minimum,
                                Math.min(
                                    maximum,
                                    next
                                )
                            );

                    });

            });


    /* =========================================================
       PURCHASE FORM VALIDATION
       ========================================================= */

    document
        .getElementById(
            "productPurchaseForm"
        )
        ?.addEventListener(
            "submit",
            event => {

                const sizeFieldset =
                    document.querySelector(
                        ".product-size-fieldset[data-size-required='true']"
                    );


                const errors = [];


                /* -----------------------------------------
                   Size validation
                   ----------------------------------------- */

                if (
                    sizeFieldset &&
                    !document.getElementById(
                        "productSize"
                    ).value
                ) {

                    errors.push(
                        "Please select an available size."
                    );

                }


                /* -----------------------------------------
                   Quantity validation
                   ----------------------------------------- */

                const quantity =
                    Number(
                        quantityInput?.value
                    );


                const quantityError =
                    document.getElementById(
                        "productQuantityError"
                    );


                if (
                    !Number.isInteger(
                        quantity
                    ) ||
                    quantity < 1
                ) {

                    errors.push(
                        "Quantity must be at least 1."
                    );

                }
                else if (
                    quantity >
                    Number(
                        quantityInput.max
                    )
                ) {

                    errors.push(
                        `Only ${quantityInput.max} item(s) are in stock.`
                    );

                }


                /* -----------------------------------------
                   Show validation errors
                   ----------------------------------------- */

                if (errors.length) {

                    event.preventDefault();


                    showProductToast(
                        errors.join(" ")
                    );


                    (
                        sizeFieldset &&
                        !document.getElementById(
                            "productSize"
                        ).value
                            ? sizeFieldset
                            : quantityInput
                    )?.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                }

            });

</script>
