@model ProductViewModel

@{
    ViewData["Title"] = Model.Name;
    var variants = Model.Variants.OrderBy(variant => variant.Size).ToList();
    var standardSizes = new[] { "S", "M", "L", "XL", "XXL", "3XL", "FREE SIZE" };
    var availableSizes = new HashSet<string>(variants.Where(variant => variant.Stock > 0).Select(variant => variant.Size),
        StringComparer.OrdinalIgnoreCase);
    var startingVariant = variants.OrderBy(variant => variant.Price).FirstOrDefault();
    var regularPrice = startingVariant is not null && startingVariant.Discount > 0 && startingVariant.Discount < 100
        ? Math.Round(startingVariant.Price / (1 - startingVariant.Discount / 100), 2)
        : startingVariant?.Price ?? 0;
    var galleryItems = new List<(string Url, bool IsVideo)>();
    var bestSellers = ViewBag.BestSellers as List<ProductViewModel> ?? [];
    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        galleryItems.Add((ImageUrlHelper.Resolve(Model.ImageUrl, Configuration["ApiBaseUrl"]), false));
    }
    galleryItems.AddRange((Model.Images ?? [])
        .OrderBy(image => image.SortOrder)
        .Select(image => ImageUrlHelper.Resolve(image.ImageUrl, Configuration["ApiBaseUrl"]))
        .Where(url => !string.IsNullOrWhiteSpace(url))
        .Select(url => (url, false)));
    galleryItems.AddRange((Model.Videos ?? [])
        .OrderBy(video => video.SortOrder)
        .Select(video => video.VideoUrl)
        .Where(url => !string.IsNullOrWhiteSpace(url))
        .Select(url => (url, true)));
}

<main class="product-details-page">
    <section class="product-gallery" aria-label="Product images">
        <div class="product-gallery-main">
            @if (galleryItems.Count > 0)
            {
                @if (galleryItems[0].IsVideo)
                {
                    <video id="productMainVideo" src="@galleryItems[0].Url" controls playsinline preload="metadata" aria-label="@Model.Name product video"></video>
                }
                else
                {
                    <img id="productMainImage" src="@galleryItems[0].Url" alt="@Model.Name" />
                }
            }
            else
            {
                <div class="product-gallery-placeholder">UBHAYA FASHIONS</div>
            }
        </div>

        @if (galleryItems.Count > 1)
        {
            <div class="product-gallery-thumbnails" aria-label="Choose product image">
                @for (var index = 0; index < galleryItems.Count; index++)
                {
                    var galleryItem = galleryItems[index];
                    <button type="button"
                            class="product-gallery-thumbnail @(index == 0 ? "active" : string.Empty)"
                            data-gallery-media="@galleryItem.Url"
                            data-gallery-type="@(galleryItem.IsVideo ? "video" : "image")"
                            data-gallery-alt="@Model.Name, @(galleryItem.IsVideo ? "video" : "image") @(index + 1)"
                            aria-label="Show @(galleryItem.IsVideo ? "video" : "image") @(index + 1)"
                            aria-pressed="@(index == 0 ? "true" : "false")">
                        @if (galleryItem.IsVideo)
                        {
                            <video src="@galleryItem.Url" muted preload="metadata" aria-hidden="true"></video>
                            <span class="gallery-video-badge" aria-hidden="true">PLAY</span>
                        }
                        else
                        {
                            <img src="@galleryItem.Url" alt="" loading="lazy" />
                        }
                    </button>
                }
            </div>
        }
    </section>

    <section class="product-details-info">
        <p class="product-details-category">@Model.Category</p>
        <div class="product-details-title-row">
            <h1>@Model.Name</h1>
            <div class="product-details-actions">
                <button type="button" class="product-share-button" id="shareProductButton">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.7 10.7 6.6-4.4M8.7 13.3l6.6 4.4"/></svg>
                    <span>Share</span>
                </button>
                <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="product-wishlist-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="isWishlisted" value="@(ViewBag.IsWishlisted == true ? "true" : "false")" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Products", new { id = Model.Id })" />
                    <button type="submit" class="product-wishlist-button @(ViewBag.IsWishlisted == true ? "is-saved" : string.Empty)" aria-label="@(ViewBag.IsWishlisted == true ? "Remove from wishlist" : "Add to wishlist")" title="@(ViewBag.IsWishlisted == true ? "Remove from wishlist" : "Add to wishlist")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" /></svg>
                    </button>
                </form>
            </div>
        </div>
        <p class="product-share-status" id="shareProductStatus" role="status" aria-live="polite"></p>
        @if (TempData["WishlistMessage"] is string wishlistMessage)
        {
            <div class="wishlist-notice" role="status">@wishlistMessage</div>
        }
        @if (TempData["WishlistError"] is string wishlistError)
        {
            <div class="wishlist-notice error" role="alert">@wishlistError</div>
        }

        <div class="product-details-pricing">
            <span class="product-details-regular-price" id="productRegularPrice" style="@(Model.Discount > 0 ? null : "display:none")">₹@regularPrice.ToString("N0")</span>
            <span class="product-details-price" id="productSalePrice">₹@Model.Price.ToString("N0")</span>
            <span class="product-details-sale-badge" id="productSaleBadge" style="@(Model.Discount > 0 ? null : "display:none")">-@Model.Discount% SALE</span>
        </div>
        <p class="product-tax-note">
            Taxes included. <a href="https://theaaram.in/policies/shipping-policy" target="_blank" rel="noopener">Shipping details</a>
        </p>

        <div class="product-shipping-promos">
            <p>🚚 <strong>Free Shipping</strong> above ₹999</p>
            <p>🔥 <strong>Most Loved:</strong> Buy any 2 &amp; save ₹99</p>
            <p>💛 <strong>Best Value:</strong> Buy any 3 &amp; save ₹199</p>
        </div>

        @if (TempData["CartError"] is string cartError)
        {
            <div class="product-purchase-warning product-toast" role="alert" aria-live="assertive">
                <span>@cartError</span>
                <button type="button" class="product-toast-close" aria-label="Dismiss warning">×</button>
            </div>
        }

        <p class="product-details-description">@Model.Description</p>

        @if (Model.Stock > 0)
        {
            <p class="product-details-stock" id="productStockMessage">Select a size to see availability</p>
            <form asp-controller="Cart" asp-action="Add" method="post" class="product-details-form" id="productPurchaseForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />

                @if (variants.Count > 0)
                {
                    <fieldset class="product-size-fieldset" data-size-required="true">
                        <legend>Size <span id="selectedSizeLabel">Select a size</span></legend>
                        <input id="productSize" name="size" type="hidden" />
                        <div class="product-size-options">
                            @foreach (var size in standardSizes)
                            {
                                var isAvailable = availableSizes.Contains(size);
                                var variant = variants.FirstOrDefault(item => item.Size.Equals(size, StringComparison.OrdinalIgnoreCase));
                                <button type="button"
                                        class="product-size-option @(isAvailable ? "available" : "unavailable")"
                                        data-size="@size"
                                        data-price="@((variant?.Price ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-discount="@((variant?.Discount ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-stock="@(variant?.Stock ?? 0)"
                                        aria-pressed="false"
                                        disabled="@(!isAvailable)"
                                    title="@(isAvailable ? size : "Out of stock")">
                                    <span class="product-size-label">@size</span>
                                    @if (!isAvailable)
                                    {
                                        <span class="product-size-stock">Out of stock</span>
                                    }
                                    else
                                    {
                                        <span class="product-size-price">₹@variant!.Price.ToString("N0")</span>
                                    }
                                    @if (!isAvailable)
                                    {
                                        <span aria-hidden="true">×</span>
                                    }
                                </button>
                            }
                        </div>
                        <span class="product-size-error" id="productSizeError" role="alert"></span>
                    </fieldset>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Colors))
                {
                    <p class="product-details-colors"><strong>Color:</strong> @Model.Colors</p>
                }

                <label for="productQuantity">Quantity</label>
                <div class="product-quantity-control">
                    <button type="button" data-quantity-step="-1" aria-label="Decrease quantity">−</button>
                    <input id="productQuantity" type="number" name="quantity" value="1" min="1" max="@Model.Stock" step="1" inputmode="numeric" />
                    <button type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
                </div>
                <span class="product-quantity-error" id="productQuantityError" role="alert"></span>

                <div class="product-purchase-buttons">
                    <button class="button product-add-button" type="submit" name="buyNow" value="false">ADD TO CART</button>
                    <button class="button product-buy-button" type="submit" name="buyNow" value="true">BUY IT NOW</button>
                </div>
                <div class="product-checkout-assurances">
                    <p>✔ Secure checkout</p>
                    <p>✔ Fast dispatch within 24–48 hours</p>
                </div>
            </form>
        }
        else
        {
            <p class="product-details-out-of-stock">OUT OF STOCK</p>
        }
    </section>
</main>

<section class="product-reviews" aria-labelledby="productReviewsTitle">
    <div class="product-reviews-inner">
        <h2 id="productReviewsTitle">Customer Reviews</h2>
        <div class="product-reviews-empty">
            <p>Be the first to write a review</p>
            <button class="product-review-button" type="button" id="writeReviewButton">Write a review</button>
        </div>
        <form class="product-review-form" id="productReviewForm" hidden>
            <h3>Write a review for @Model.Name</h3>
            <label for="reviewRating">Rating</label>
            <select id="reviewRating" name="rating" required>
                <option value="">Choose a rating</option>
                <option value="5">★★★★★ - Excellent</option>
                <option value="4">★★★★ - Good</option>
                <option value="3">★★★ - Average</option>
                <option value="2">★★ - Below average</option>
                <option value="1">★ - Poor</option>
            </select>
            <label for="reviewTitle">Review title</label>
            <input id="reviewTitle" name="title" type="text" maxlength="100" required />
            <label for="reviewBody">Your review</label>
            <textarea id="reviewBody" name="body" rows="5" maxlength="2000" required></textarea>
            <p class="product-review-note">Review submission is not available yet.</p>
        </form>
    </div>
</section>

@if (bestSellers.Count > 0)
{
    <section class="product-bestsellers" aria-labelledby="productBestsellersTitle">
        <div class="product-bestsellers-inner">
            <p class="catalog-eyebrow">CUSTOMER FAVORITES</p>
            <h2 id="productBestsellersTitle">Bestsellers</h2>
            <div class="product-bestsellers-grid">
                @foreach (var item in bestSellers)
                {
                    var hasDiscount = item.Discount > 0 && item.Discount < 100;
                    var originalPrice = hasDiscount ? item.Price / (1 - item.Discount / 100) : item.Price;
                    <a class="product-bestseller-card" asp-action="Details" asp-route-id="@item.Id">
                        <div class="product-bestseller-image-wrap">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@ImageUrlHelper.Resolve(item.ImageUrl, Configuration["ApiBaseUrl"])" alt="@item.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="product-bestseller-image-fallback">UBHAYA</div>
                            }
                            @if (item.Discount > 0)
                            {
                                <span class="product-bestseller-discount">-@item.Discount% OFF</span>
                            }
                        </div>
                        <span class="product-bestseller-category">@item.Category</span>
                        <h3>@item.Name</h3>
                        <div class="product-bestseller-pricing">
                            <span class="product-bestseller-price">₹@item.Price.ToString("N0")</span>
                            @if (hasDiscount)
                            {
                                <span class="product-bestseller-original-price">₹@Math.Round(originalPrice).ToString("N0")</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<dialog class="product-image-zoom" id="productImageZoom" aria-label="Product image viewer">
    <div class="product-image-zoom-toolbar">
        <button type="button" id="zoomOutButton" aria-label="Zoom out">−</button>
        <button type="button" id="zoomResetButton" aria-label="Reset zoom">Reset</button>
        <button type="button" id="zoomInButton" aria-label="Zoom in">+</button>
        <button type="button" id="closeZoomButton" class="product-image-zoom-close" aria-label="Close image viewer">×</button>
    </div>
    <div class="product-image-zoom-stage">
        <img id="productZoomImage" alt="" />
    </div>
</dialog>

<script>
    (() => {
        const dialog = document.getElementById("productImageZoom");
        const zoomImage = document.getElementById("productZoomImage");
        let zoom = 1;
        const applyZoom = () => { zoomImage.style.transform = `scale(${zoom})`; };
        const setZoom = value => { zoom = Math.min(4, Math.max(1, value)); applyZoom(); };

        document.querySelector(".product-gallery-main")?.addEventListener("click", event => {
            const image = event.target.closest("img");
            if (!image) return;
            zoomImage.src = image.currentSrc || image.src;
            zoomImage.alt = image.alt;
            setZoom(1);
            dialog.showModal();
        });
        document.getElementById("zoomInButton").addEventListener("click", () => setZoom(zoom + .5));
        document.getElementById("zoomOutButton").addEventListener("click", () => setZoom(zoom - .5));
        document.getElementById("zoomResetButton").addEventListener("click", () => setZoom(1));
        document.getElementById("closeZoomButton").addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
    })();

    document.getElementById("shareProductButton")?.addEventListener("click", async () => {
        const button = document.getElementById("shareProductButton");
        const status = document.getElementById("shareProductStatus");
        const shareData = { title: document.querySelector(".product-details-title-row h1").textContent.trim(), url: window.location.href };
        if (navigator.share) {
            try {
                await navigator.share(shareData);
                return;
            } catch (error) {
                if (error.name === "AbortError") return;
            }
        }
        try {
            await navigator.clipboard.writeText(shareData.url);
        } catch {
            const input = document.createElement("textarea");
            input.value = shareData.url;
            input.style.position = "fixed";
            input.style.opacity = "0";
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            input.remove();
        }
        status.textContent = "Product link copied.";
        button.querySelector("span").textContent = "Copied";
        setTimeout(() => { button.querySelector("span").textContent = "Share"; }, 2200);
    });

    const enableHoverPlayback = (video) => {
        video.addEventListener("pointerenter", () => {
            video.muted = true;
            video.play().catch(() => {});
        });
        video.addEventListener("pointerleave", () => video.pause());
    };

    document.querySelectorAll(".product-gallery video").forEach(enableHoverPlayback);

    document.getElementById("writeReviewButton")?.addEventListener("click", () => {
        const reviewForm = document.getElementById("productReviewForm");
        reviewForm.hidden = !reviewForm.hidden;
        if (!reviewForm.hidden) {
            reviewForm.scrollIntoView({ behavior: "smooth", block: "center" });
            document.getElementById("reviewRating").focus();
        }
    });

    const showProductToast = (message) => {
        let toast = document.querySelector(".product-toast");
        if (!toast) {
            toast = document.createElement("div");
            toast.className = "product-purchase-warning product-toast";
            toast.setAttribute("role", "alert");
            toast.setAttribute("aria-live", "assertive");
            toast.innerHTML = '<span></span><button type="button" class="product-toast-close" aria-label="Dismiss warning">×</button>';
            document.body.appendChild(toast);
        }
        toast.querySelector("span").textContent = message;
        toast.classList.add("is-visible");
        clearTimeout(toast.dismissTimer);
        toast.dismissTimer = setTimeout(() => toast.classList.remove("is-visible"), 6000);
    };

    document.querySelectorAll(".product-toast").forEach((toast) => {
        toast.classList.add("is-visible");
        toast.querySelector(".product-toast-close")?.addEventListener("click", () => toast.classList.remove("is-visible"));
        setTimeout(() => toast.classList.remove("is-visible"), 6000);
    });
    document.addEventListener("click", (event) => {
        if (event.target.closest(".product-toast-close")) {
            event.target.closest(".product-toast")?.classList.remove("is-visible");
        }
    });

    document.querySelectorAll(".product-gallery-thumbnail").forEach((thumbnail) => {
        thumbnail.addEventListener("click", () => {
            const galleryMain = document.querySelector(".product-gallery-main");
            const mediaUrl = thumbnail.dataset.galleryMedia;
            if (thumbnail.dataset.galleryType === "video") {
                galleryMain.innerHTML = "";
                const video = document.createElement("video");
                video.id = "productMainVideo";
                video.src = mediaUrl;
                video.controls = true;
                video.playsInline = true;
                video.preload = "metadata";
                video.muted = true;
                video.setAttribute("aria-label", thumbnail.dataset.galleryAlt);
                enableHoverPlayback(video);
                galleryMain.appendChild(video);
            } else {
                galleryMain.innerHTML = "";
                const image = document.createElement("img");
                image.id = "productMainImage";
                image.src = mediaUrl;
                image.alt = thumbnail.dataset.galleryAlt;
                galleryMain.appendChild(image);
            }
            document.querySelectorAll(".product-gallery-thumbnail").forEach((item) => {
                const active = item === thumbnail;
                item.classList.toggle("active", active);
                item.setAttribute("aria-pressed", active ? "true" : "false");
            });
        });
    });

    document.querySelectorAll(".product-size-option.available").forEach((option) => {
        option.addEventListener("click", () => {
            document.getElementById("productSize").value = option.dataset.size;
            document.getElementById("selectedSizeLabel").textContent = option.dataset.size;
            document.getElementById("productSizeError").textContent = "";
            const price = Number(option.dataset.price);
            const discount = Number(option.dataset.discount);
            const stock = Number(option.dataset.stock);
            const regularPrice = discount > 0 && discount < 100 ? price / (1 - discount / 100) : price;
            const formatPrice = value => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(value);
            document.getElementById("productSalePrice").textContent = formatPrice(price);
            const regularPriceElement = document.getElementById("productRegularPrice");
            if (regularPriceElement) {
                regularPriceElement.textContent = formatPrice(regularPrice);
                regularPriceElement.style.display = discount > 0 ? "inline" : "none";
            }
            const saleBadge = document.getElementById("productSaleBadge");
            if (saleBadge) {
                saleBadge.textContent = `-${discount}% SALE`;
                saleBadge.style.display = discount > 0 ? "inline-block" : "none";
            }
            const stockMessage = document.getElementById("productStockMessage");
            stockMessage.textContent = `Size ${option.dataset.size} is available`;
            quantityInput.max = stock;
            quantityInput.value = Math.min(Number(quantityInput.value) || 1, stock);
            document.querySelectorAll(".product-size-option").forEach((item) => {
                const selected = item === option;
                item.classList.toggle("selected", selected);
                item.setAttribute("aria-pressed", selected ? "true" : "false");
            });
        });
    });

    const quantityInput = document.getElementById("productQuantity");
    quantityInput?.addEventListener("input", () => {
        document.getElementById("productQuantityError").textContent = "";
    });
    document.querySelectorAll("[data-quantity-step]").forEach((button) => {
        button.addEventListener("click", () => {
            const minimum = Number(quantityInput.min) || 1;
            const maximum = Number(quantityInput.max) || Number.MAX_SAFE_INTEGER;
            const next = Number(quantityInput.value || minimum) + Number(button.dataset.quantityStep);
            quantityInput.value = Math.max(minimum, Math.min(maximum, next));
        });
    });

    document.getElementById("productPurchaseForm")?.addEventListener("submit", (event) => {
        const sizeFieldset = document.querySelector(".product-size-fieldset[data-size-required='true']");
        const errors = [];
        if (sizeFieldset && !document.getElementById("productSize").value) {
            errors.push("Please select an available size.");
        }

        const quantity = Number(quantityInput?.value);
        const quantityError = document.getElementById("productQuantityError");
        if (!Number.isInteger(quantity) || quantity < 1) {
            errors.push("Quantity must be at least 1.");
        } else if (quantity > Number(quantityInput.max)) {
            errors.push(`Only ${quantityInput.max} item(s) are in stock.`);
        }

        if (errors.length) {
            event.preventDefault();
            showProductToast(errors.join(" "));
            (sizeFieldset && !document.getElementById("productSize").value ? sizeFieldset : quantityInput)
                ?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
    });
</script>
