@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["MetaDescription"] = "Learn how Ubhaya Fashions handles information submitted through your account, orders, and contact form.";
}

<section class="policy-page">
    <h1>Privacy Policy</h1>
    <p>Ubhaya Fashions uses the information you provide to manage your account, process orders, provide customer support, and improve the shopping experience.</p>
    <h2>Information you provide</h2>
    <p>This may include your name, email address, phone number, delivery address, and order details when you create an account, place an order, or contact us.</p>
    <h2>How information is used</h2>
    <p>We use this information to fulfill orders, communicate about orders and account requests, and maintain the services you use. We do not publish your personal information on this site.</p>
    <h2>Questions or requests</h2>
    <p>For questions about your information, please use the <a asp-controller="Contact" asp-action="Index">contact form</a>.</p>
</section>
