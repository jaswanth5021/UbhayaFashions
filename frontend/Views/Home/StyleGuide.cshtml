@{
    ViewData["Title"] = "The Ubhaya Style Guide";
    ViewData["MetaDescription"] = "Simple styling ideas for choosing, wearing, and caring for your favourite women's fashion and ethnic wear.";
}

<main class="style-guide-page" style="width:min(100% - 32px, 900px);margin:48px auto 72px;color:#38272d;">
    <a asp-controller="Account" asp-action="Login" style="color:#68142e;text-decoration:none;font-size:13px;">← Back to sign in</a>
    <p style="margin:28px 0 10px;color:#9a6b56;font-size:10px;font-weight:700;letter-spacing:.2em;">THE UBHAYA STYLE JOURNAL</p>
    <h1 style="max-width:760px;margin:0;font:400 clamp(36px,6vw,58px)/1.12 Georgia,'Times New Roman',serif;">Little ways to wear it beautifully.</h1>
    <p style="max-width:700px;margin:18px 0 36px;color:#807174;font-size:16px;line-height:1.8;">Personal style does not need to be complicated. Start with pieces that feel comfortable, choose details that suit the occasion, and wear what makes you feel like yourself.</p>
    <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:18px;">
        <article style="padding:24px;border:1px solid #eadbd6;border-radius:12px;background:#fffdfa;">
            <p style="margin:0 0 10px;color:#9a6b56;font-size:10px;font-weight:700;letter-spacing:.12em;">01 · EVERYDAY</p>
            <h2 style="margin:0 0 12px;font:400 25px/1.2 Georgia,'Times New Roman',serif;">Start with comfort</h2>
            <p style="margin:0;color:#807174;font-size:14px;line-height:1.8;">Choose breathable fabrics and cuts that let you move comfortably. A favourite everyday piece is one you reach for again and again.</p>
        </article>
        <article style="padding:24px;border:1px solid #eadbd6;border-radius:12px;background:#fffdfa;">
            <p style="margin:0 0 10px;color:#9a6b56;font-size:10px;font-weight:700;letter-spacing:.12em;">02 · OCCASION</p>
            <h2 style="margin:0 0 12px;font:400 25px/1.2 Georgia,'Times New Roman',serif;">Let one detail shine</h2>
            <p style="margin:0;color:#807174;font-size:14px;line-height:1.8;">For celebrations, pair a statement outfit with simpler accessories—or keep the outfit understated and add one detail you love.</p>
        </article>
        <article style="padding:24px;border:1px solid #eadbd6;border-radius:12px;background:#fffdfa;">
            <p style="margin:0 0 10px;color:#9a6b56;font-size:10px;font-weight:700;letter-spacing:.12em;">03 · CARE</p>
            <h2 style="margin:0 0 12px;font:400 25px/1.2 Georgia,'Times New Roman',serif;">Care for your favourites</h2>
            <p style="margin:0;color:#807174;font-size:14px;line-height:1.8;">Check each garment's care label, store delicate pieces neatly, and follow the recommended washing instructions to help them last.</p>
        </article>
    </section>
    <p style="margin:32px 0 0;"><a asp-controller="Products" asp-action="Index" style="display:inline-flex;gap:10px;align-items:center;padding:14px 20px;border-radius:6px;background:#68142e;color:white;text-decoration:none;font-size:12px;font-weight:700;">EXPLORE THE COLLECTION <span aria-hidden="true">→</span></a></p>
</main>
