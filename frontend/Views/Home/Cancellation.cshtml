@{ ViewData["Title"] = "Cancellation Policy"; ViewData["MetaDescription"] = "Read the UBHAYA FASHIONS order cancellation policy."; }
<main class="store-policy"><header class="store-policy-hero"><span>UBHAYA FASHIONS · ORDER SUPPORT</span><h1>Cancellation <em>Policy</em></h1><p>How to request cancellation of an order placed through our online store.</p></header><nav class="store-policy-nav"><a asp-action="Privacy">Privacy</a><a asp-action="Terms">Terms</a><a asp-action="Returns">Returns &amp; Refunds</a><a class="active" asp-action="Cancellation">Cancellation</a></nav><div class="store-policy-content">
<section><h2>Request a cancellation</h2><p>Contact UBHAYA FASHIONS as soon as possible with your order number and registered phone number or email address. A cancellation is effective only after our team confirms it.</p></section>
<section><h2>Before dispatch</h2><p>Requests received before an order is processed for dispatch may be reviewed and accepted if fulfilment has not already progressed.</p></section>
<section><h2>After dispatch</h2><p>Once an order has been handed over to the courier, cancellation may no longer be possible. Contact our support team for guidance. Refusing delivery does not automatically guarantee a refund.</p></section>
<section><h2>Refunds for approved cancellations</h2><p>If a cancellation is approved after payment, the eligible amount will be refunded to the original payment method or another appropriate method communicated by our team. Processing times vary by bank and payment provider.</p></section>
<section><h2>Contact us</h2><p>Email <a href="mailto:ubhayafashions@gmail.com">ubhayafashions@gmail.com</a> or use our <a asp-controller="Contact" asp-action="Index">Contact Us</a> page. Include your order number.</p></section></div><p class="store-policy-date">Last updated: 31 October 2026</p></main>