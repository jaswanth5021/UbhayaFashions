@{
    ViewData["Title"] = "About Ubhaya";
    ViewData["MetaDescription"] = "Learn about Ubhaya Fashions and our belief that comfort is the foundation of feeling beautiful.";
}

<section class="about-page">
    <header class="about-hero">
        <div class="about-hero-copy">
            <p class="about-eyebrow"><span></span> OUR STORY <span></span></p>
            <h1>ABOUT <em>UBHAYA</em></h1>
            <p class="about-lead">For too long, women were told to choose — <strong>look beautiful or feel comfortable.</strong></p>
        </div>
        <div class="about-hero-mark" aria-hidden="true">U</div>
        <p class="about-hero-caption">COMFORT, WOVEN INTO EVERY DETAIL</p>
    </header>

    <div class="about-content">
        <aside class="about-belief">
            <span class="about-section-number">01 / OUR BELIEF</span>
            <div class="about-belief-rule"></div>
            <p>Comfort is the foundation of confidence, grace, and power.</p>
            <span class="about-belief-mark" aria-hidden="true">✳</span>
        </aside>

        <section class="about-story" aria-label="Our story">
            <p class="about-emphasis">We refused that choice.</p>
            <p>Ubhaya was born from the belief that comfort is not an option anymore. It is the foundation of everything — of your confidence, your grace, your power.</p>
            <p>When you are truly comfortable, you don't just look beautiful. You feel it. You own it. You radiate it.</p>
            <p>That is why we obsess over every fabric that kisses your skin, every cut that moves with you, every detail that makes you feel effortlessly you.</p>
        </section>
    </div>

    <section class="about-manifesto" aria-label="Our approach">
        <span>OUR APPROACH</span>
        <p>We don't follow trends.<br /><em>We follow feeling.</em></p>
        <i aria-hidden="true"></i>
    </section>

    <section class="about-mission">
        <span>OUR MISSION</span>
        <p>Our mission is simple, and sacred: <strong>To make comfort so beautiful, you never want to take it off.</strong></p>
    </section>

    <footer class="about-signoff">
        <p class="about-welcome">Welcome to Ubhaya.</p>
        <strong>UBHAYA FASHIONS</strong>
        <span>Style for Every You.</span>
    </footer>
</section>
