@{
    ViewData["Title"] = "Page Not Found";
    ViewData["MetaDescription"] = "The page you requested could not be found. Continue shopping at Ubhaya Fashions.";
}

<section class="status-page">
    <p class="status-page-code">404</p>
    <h1>We couldn’t find that page</h1>
    <p>The page may have moved or the link may be out of date.</p>
    <a class="button" asp-controller="Home" asp-action="Index">Return to home</a>
    <a class="button" asp-controller="Products" asp-action="Index">Shop the collection</a>
</section>
