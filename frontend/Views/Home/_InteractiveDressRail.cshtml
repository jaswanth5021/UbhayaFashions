@model List<LadiesDressStore.Web.Models.ProductViewModel>
@{
    var railProducts = new List<LadiesDressStore.Web.Models.ProductViewModel>(); // (Model ?? []).Take(15).ToList();
    var firstProduct = railProducts.FirstOrDefault();
    string ProductImage(LadiesDressStore.Web.Models.ProductViewModel product)
    {
        var image = !string.IsNullOrWhiteSpace(product.ImageUrl)
            ? product.ImageUrl
            : product.Images?.OrderBy(item => item.SortOrder).Select(item => item.ImageUrl).FirstOrDefault(url => !string.IsNullOrWhiteSpace(url));
        return string.IsNullOrWhiteSpace(image) ? "" : ImageUrlHelper.Resolve(image, Configuration["ApiBaseUrl"]);
    }
}
@if (railProducts.Count > 0)
{
    <section class="interactive-dress-rail" data-dress-rail-section aria-labelledby="dressRailTitle">
        <header class="dress-rail-intro">
            <p class="dress-rail-eyebrow">THE UBHAYA EDIT · NEW SEASON, NEW FEEL</p>
            <h2 id="dressRailTitle">A clothing rail you can handle, right on the page.</h2>
        </header>

        <div class="dress-rail-rack" aria-label="Choose a style from the clothing rail">
            <div class="dress-rail-bar" aria-hidden="true"></div>
            <div class="dress-rail-track" data-dress-rail-track tabindex="0">
                @for (var i = 0; i < railProducts.Count; i++)
                {
                    var product = railProducts[i];
                    var imageUrl = ProductImage(product);
                    <button type="button" class="dress-rail-item"
                            data-dress-rail-item data-index="@i"
                            aria-pressed="false"
                            aria-label="View @product.Name">
                        <span class="dress-rail-hook" aria-hidden="true"></span>
                        <span class="dress-rail-thumb">
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl" alt="" loading="lazy" />
                            }
                            else { <span class="dress-rail-empty">UBHAYA</span> }
                        </span>
                    </button>
                }
            </div>
        </div>

        <div class="dress-rail-feature" data-dress-rail-feature aria-live="polite" hidden>
            <div class="dress-rail-feature-image"><img data-dress-rail-feature-image src="" alt="" /></div>
            <div class="dress-rail-feature-copy">
                <p class="dress-rail-feature-kicker">THE UBHAYA EDIT · SELECTED STYLE</p>
                <h3 data-dress-rail-feature-name></h3>
                <p class="dress-rail-feature-description">A handpicked style from the latest Ubhaya collection.</p>
                <p class="dress-rail-feature-price" data-dress-rail-feature-price></p>
                <a data-dress-rail-feature-link href="#" class="dress-rail-shop-link">DISCOVER THIS STYLE <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <p class="dress-rail-hint">Drag the rail or tap a piece to take a closer look</p>

        <script type="application/json" data-dress-rail-data>
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(railProducts.Select((product, index) => new {
                index,
                name = product.Name,
                price = "₹" + product.Price.ToString("N0"),
                image = ProductImage(product),
                url = Url.Action("Details", "Products", new { id = product.Id })
            })))
        </script>
    </section>

    <style>
        .interactive-dress-rail{--rail-ink:#24211e;--rail-muted:#817970;position:relative;isolation:isolate;overflow:hidden;padding:clamp(48px,6vw,78px) 0 54px;background:linear-gradient(180deg,#fff 0%,#fdfcfb 58%,#f7f4ef 100%);color:var(--rail-ink)}
        .interactive-dress-rail:before{content:"";position:absolute;z-index:-1;inset:0;background:radial-gradient(ellipse at 50% 22%,#f4eee6 0,transparent 54%);opacity:.55;pointer-events:none}
        .dress-rail-intro{max-width:900px;margin:0 auto clamp(38px,5vw,62px);padding:0 20px;text-align:center}
        .dress-rail-eyebrow{margin:0 0 12px;color:#90785f;font-size:9px;font-weight:600;letter-spacing:.28em;text-transform:uppercase}
        .dress-rail-intro h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(25px,3vw,39px);font-weight:400;letter-spacing:-.025em;line-height:1.2}
        .dress-rail-rack{position:relative;width:min(1440px,94vw);margin:0 auto;padding-top:22px}
        .dress-rail-bar{position:absolute;top:18px;left:0;right:0;height:4px;border-radius:99px;background:linear-gradient(180deg,#faf8f4 0%,#c8c0b5 36%,#766e65 68%,#e4ded5 100%);box-shadow:0 2px 3px #28201824,0 7px 12px #2820180d}
        .dress-rail-track{position:relative;display:flex;align-items:flex-start;justify-content:flex-start;gap:clamp(16px,2.4vw,38px);width:100%;overflow-x:auto;overflow-y:visible;padding:0 clamp(20px,4vw,58px) 22px;scrollbar-width:none;scroll-behavior:smooth;cursor:grab;touch-action:pan-x;overscroll-behavior-x:contain}
        .dress-rail-track::-webkit-scrollbar{display:none}
        .dress-rail-track.is-dragging{cursor:grabbing;scroll-behavior:auto}
        .dress-rail-item{position:relative;flex:0 0 clamp(84px,9vw,124px);height:clamp(190px,20vw,260px);margin:0;padding:0 2px;border:0;background:transparent;cursor:pointer;opacity:.78;transform:translateY(0) scale(1);transform-origin:50% 0;transition:transform .48s cubic-bezier(.18,.78,.22,1),opacity .3s,filter .3s;filter:saturate(.94);outline:none}
        .dress-rail-item:hover,.dress-rail-item:focus-visible,.dress-rail-item.is-selected{z-index:4;opacity:1;transform:translateY(-31px) scale(1.13);filter:saturate(1.08)}
        .dress-rail-hook{position:relative;display:block;width:2px;height:20px;margin:0 auto;background:linear-gradient(90deg,#9a9186,#f5f0e8 48%,#8b8176);box-shadow:0 0 1px #51483e}
        .dress-rail-hook:before{content:"";position:absolute;left:-4px;top:-8px;width:9px;height:11px;border:1.4px solid #968b7e;border-bottom:0;border-radius:9px 9px 0 0;transform:rotate(7deg)}
        .dress-rail-thumb{position:relative;display:flex;align-items:flex-start;justify-content:center;width:100%;height:calc(100% - 20px);overflow:hidden;background:transparent;border:0;border-radius:0;box-shadow:none}
        .dress-rail-thumb img{display:block;width:100%;height:100%;object-fit:contain;object-position:center top;mix-blend-mode:multiply;filter:drop-shadow(0 8px 7px #33271c16);transition:transform .48s cubic-bezier(.18,.78,.22,1),filter .35s}
        .dress-rail-item:hover .dress-rail-thumb img,.dress-rail-item:focus-visible .dress-rail-thumb img,.dress-rail-item.is-selected .dress-rail-thumb img{transform:scale(1.045);filter:drop-shadow(0 13px 10px #33271c20)}
        .dress-rail-empty{padding-top:30px;color:#a09589;font:10px Georgia,serif;letter-spacing:.2em}
        .dress-rail-feature[hidden]{display:none!important}
        .dress-rail-feature{display:block;max-width:640px;margin:clamp(2px,1vw,12px) auto 0;padding:16px 22px 0;text-align:center;animation:railFeatureIn .42s cubic-bezier(.2,.7,.2,1) both}
        @@keyframes railFeatureIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        .dress-rail-feature-image{display:none}
        .dress-rail-feature-copy{max-width:580px;margin:0 auto}
        .dress-rail-feature-kicker{margin:0 0 9px;color:#9a8066;font-size:8px;font-weight:600;letter-spacing:.24em}
        .dress-rail-feature-copy h3{margin:0 0 8px;font:400 clamp(22px,2.5vw,30px)/1.2 Georgia,"Times New Roman",serif;letter-spacing:-.015em}
        .dress-rail-feature-description{margin:0 auto 10px;max-width:460px;color:#817970;font-size:12px;line-height:1.7}
        .dress-rail-feature-price{margin:0 0 15px;color:#37312b;font-size:13px}
        .dress-rail-shop-link{display:inline-flex;align-items:center;gap:15px;padding:11px 22px;border:1px solid #28231f;border-radius:99px;background:#28231f;color:#fff;text-decoration:none;font-size:9px;font-weight:600;letter-spacing:.13em;transition:background .2s,border-color .2s,transform .2s}
        .dress-rail-shop-link:hover{transform:translateY(-2px);background:#80664e;border-color:#80664e}
        .dress-rail-hint{margin:24px auto 0;padding:0 16px;text-align:center;color:#a0968c;font-size:9px;letter-spacing:.1em}
        @@media(min-width:1100px){.dress-rail-track{gap:clamp(24px,3vw,46px)}}
        @@media(max-width:640px){.interactive-dress-rail{padding:42px 0 38px}.dress-rail-intro{margin-bottom:34px;padding:0 18px}.dress-rail-intro h2{font-size:25px}.dress-rail-rack{width:100%;padding-top:20px}.dress-rail-track{gap:16px;padding:0 22px 18px}.dress-rail-item{flex-basis:88px;height:190px}.dress-rail-item:hover,.dress-rail-item:focus-visible,.dress-rail-item.is-selected{transform:translateY(-17px) scale(1.08)}.dress-rail-feature{padding:12px 18px 0}.dress-rail-hint{margin-top:18px}}
        @@media(prefers-reduced-motion:reduce){.dress-rail-item,.dress-rail-thumb img,.dress-rail-shop-link{transition:none}.dress-rail-feature{animation:none}}
    </style>
}
