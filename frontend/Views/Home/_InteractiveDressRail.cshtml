@model List<LadiesDressStore.Web.Models.ProductViewModel>
@{
    var railProducts = (Model ?? []).Take(15).ToList();
    var firstProduct = railProducts.FirstOrDefault();
    string ProductImage(LadiesDressStore.Web.Models.ProductViewModel product)
    {
        var image = !string.IsNullOrWhiteSpace(product.ImageUrl)
            ? product.ImageUrl
            : product.Images?.OrderBy(item => item.SortOrder).Select(item => item.ImageUrl).FirstOrDefault(url => !string.IsNullOrWhiteSpace(url));
        return string.IsNullOrWhiteSpace(image) ? "" : ImageUrlHelper.Resolve(image, Configuration["ApiBaseUrl"]);
    }
}
@if (railProducts.Count > 0)
{
    <section class="interactive-dress-rail" data-dress-rail-section aria-labelledby="dressRailTitle">
        <header class="dress-rail-intro">
            <p class="dress-rail-eyebrow">THE UBHAYA EDIT · NEW SEASON, NEW FEEL</p>
            <h2 id="dressRailTitle">A clothing rail you can handle, right on the page.</h2>
        </header>

        <div class="dress-rail-rack" aria-label="Choose a style from the clothing rail">
            <div class="dress-rail-bar" aria-hidden="true"></div>
            <div class="dress-rail-track" data-dress-rail-track tabindex="0">
                @for (var i = 0; i < railProducts.Count; i++)
                {
                    var product = railProducts[i];
                    var imageUrl = ProductImage(product);
                    <button type="button" class="dress-rail-item"
                            data-dress-rail-item data-index="@i"
                            aria-pressed="false"
                            aria-label="View @product.Name">
                        <span class="dress-rail-hook" aria-hidden="true"></span>
                        <span class="dress-rail-thumb">
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl" alt="" loading="lazy" />
                            }
                            else { <span class="dress-rail-empty">UBHAYA</span> }
                        </span>
                    </button>
                }
            </div>
        </div>

        <div class="dress-rail-feature" data-dress-rail-feature aria-live="polite" hidden>
            <div class="dress-rail-feature-image"><img data-dress-rail-feature-image src="" alt="" /></div>
            <div class="dress-rail-feature-copy">
                <p class="dress-rail-feature-kicker">THE UBHAYA EDIT · SELECTED STYLE</p>
                <h3 data-dress-rail-feature-name></h3>
                <p class="dress-rail-feature-description">A handpicked style from the latest Ubhaya collection.</p>
                <p class="dress-rail-feature-price" data-dress-rail-feature-price></p>
                <a data-dress-rail-feature-link href="#" class="dress-rail-shop-link">DISCOVER THIS STYLE <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <p class="dress-rail-hint">Drag the rail or tap a piece to take a closer look</p>

        <script type="application/json" data-dress-rail-data>
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(railProducts.Select((product, index) => new {
                index,
                name = product.Name,
                price = "₹" + product.Price.ToString("N0"),
                image = ProductImage(product),
                url = Url.Action("Details", "Products", new { id = product.Id })
            })))
        </script>
    </section>

    <style>
        .interactive-dress-rail{position:relative;padding:58px max(5vw,24px) 42px;background:radial-gradient(ellipse at 50% 0%,#fff 0%,#f8f5f0 62%,#f0ebe3 100%);color:#28231f;overflow:hidden}
        .dress-rail-intro{text-align:center;max-width:900px;margin:0 auto 34px}
        .dress-rail-eyebrow{margin:0 0 10px;font-size:9px;letter-spacing:.25em;color:#927a62}
        .dress-rail-intro h2{margin:0;font-family:Georgia,serif;font-size:clamp(23px,2.5vw,34px);font-weight:400}
        .dress-rail-rack{max-width:1320px;margin:0 auto;position:relative;padding:0 8px 6px}
        .dress-rail-bar{height:5px;position:absolute;top:17px;left:0;right:0;border-radius:8px;background:linear-gradient(180deg,#fff 0%,#c9c1b7 35%,#81786f 60%,#e5dfd7 100%);box-shadow:0 2px 4px #342c2420,0 8px 16px #342c2410}
        .dress-rail-track{position:relative;display:flex;align-items:flex-start;justify-content:center;gap:clamp(12px,2.4vw,34px);overflow-x:auto;overflow-y:visible;padding:0 22px 20px;scrollbar-width:none;scroll-behavior:smooth;cursor:grab;touch-action:pan-x}
        .dress-rail-track::-webkit-scrollbar{display:none}
        .dress-rail-track.is-dragging{cursor:grabbing;scroll-behavior:auto}
        .dress-rail-item{position:relative;isolation:isolate;flex:0 0 clamp(78px,8.5vw,112px);height:174px;margin:0;border:0;background:transparent;padding:0 4px;cursor:pointer;opacity:.82;transform:translateY(0);transform-origin:50% 0;transition:transform .38s cubic-bezier(.2,.75,.25,1),opacity .25s,filter .25s;filter:saturate(.92)}
        .dress-rail-item:hover,.dress-rail-item:focus-visible,.dress-rail-item.is-selected{opacity:1;transform:translateY(-25px) scale(1.09);z-index:5;filter:saturate(1.08);outline:none}
        .dress-rail-hook{position:relative;display:block;width:2px;height:19px;margin:0 auto;background:linear-gradient(90deg,#8a8176,#f5f0e8,#82796f);box-shadow:0 0 1px #51483e}
        .dress-rail-hook:before{content:"";position:absolute;width:10px;height:11px;left:-4px;top:-8px;border:1.5px solid #8e857a;border-bottom:0;border-radius:9px 9px 0 0;transform:rotate(8deg)}
        .dress-rail-thumb{position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:145px;overflow:hidden;background:linear-gradient(145deg,#fff,#f4f0e9);border:1px solid #e5ded4;border-radius:3px 3px 7px 7px;box-shadow:0 7px 16px #30261b18,inset 0 0 0 3px #ffffff80}
        .dress-rail-thumb img{width:100%;height:100%;object-fit:cover;object-position:center 25%;transition:transform .45s ease,filter .3s}
        .dress-rail-item:hover .dress-rail-thumb img{transform:scale(1.1);filter:contrast(1.03)}
        .dress-rail-empty{font:11px Georgia,serif;letter-spacing:.15em;color:#9a8e82}
        .dress-rail-feature[hidden]{display:none!important}
        .dress-rail-feature{max-width:900px;min-height:260px;margin:12px auto 0;display:grid;grid-template-columns:minmax(210px,.92fr) 1fr;align-items:center;gap:clamp(28px,5vw,76px);padding:18px 36px;background:#ffffffb8;border:1px solid #e9e1d7;box-shadow:0 18px 48px #35291c0d;animation:railFeatureIn .38s ease both}
        @@keyframes railFeatureIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
        .dress-rail-feature-image{height:235px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(145deg,#fff,#f8f5f0);border:1px solid #eee8df}
        .dress-rail-feature-image img{width:100%;height:100%;object-fit:contain;transition:opacity .2s,transform .4s}
        .dress-rail-feature-copy{max-width:390px}
        .dress-rail-feature-kicker{margin:0 0 10px;color:#927a62;font-size:9px;letter-spacing:.2em}
        .dress-rail-feature-copy h3{margin:0 0 10px;font:400 clamp(23px,2.4vw,31px) Georgia,serif}
        .dress-rail-feature-description{margin:0 0 15px;color:#81776e;font-size:12px;line-height:1.7}
        .dress-rail-feature-price{margin:0 0 20px;font-size:15px}
        .dress-rail-shop-link{display:inline-flex;align-items:center;gap:16px;padding:12px 22px;background:#28231f;color:#fff;text-decoration:none;border-radius:2px;font-size:9px;letter-spacing:.13em}
        .dress-rail-shop-link:hover{background:#8b6c4e}
        .dress-rail-hint{margin:14px auto 0;text-align:center;color:#91867b;font-size:10px;letter-spacing:.08em}
        @@media(max-width:640px){.interactive-dress-rail{padding:40px 12px 30px}.dress-rail-intro{padding:0 8px;margin-bottom:26px}.dress-rail-intro h2{font-size:23px}.dress-rail-track{justify-content:flex-start;gap:10px;padding-left:14px}.dress-rail-item{flex-basis:76px;height:150px}.dress-rail-thumb{height:124px}.dress-rail-feature{grid-template-columns:1fr;gap:15px;padding:16px;text-align:center}.dress-rail-feature-image{height:220px}.dress-rail-feature-copy{margin:auto}}
        @@media(prefers-reduced-motion:reduce){.dress-rail-track,.dress-rail-item,.dress-rail-thumb img,.dress-rail-feature-image img{scroll-behavior:auto;transition:none;animation:none}}
    </style>
}
