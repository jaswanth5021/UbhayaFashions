                    </summary>
                    <ul class="menu-category-sublist">
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="Dresses">Dresses</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="2-piece sets">2-Piece Sets</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="3-piece sets">3-Piece Sets</a></li>
                    </ul>
                </details>
            </li>
            <li><a asp-controller="Products" asp-action="Index" asp-route-bestSellers="true" class="menu-item"><span class="menu-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18v-3M9 18V9M14 18V6M19 18v-6M4 12l5-4 5 2 5-6"/></svg></span><span class="menu-item-label">Best Sellers</span><span class="menu-item-arrow">›</span></a></li>
            <li><a asp-controller="Products" asp-action="Index" asp-route-sort="discount" class="menu-item"><span class="menu-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10l4 4v10l-4 4H7l-4-4V7l4-4Z"/><path d="M8 8h.01M16 16h.01M9 15l6-6"/></svg></span><span class="menu-item-label">Offers</span><span class="menu-item-arrow">›</span></a></li>
            <li><a asp-controller="Home" asp-action="About" class="menu-item"><span class="menu-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 15c1 1.3 2.4 2 4 2 2.2 0 4-1.3 4-3 0-1.5-1.4-2.4-4-3-2.6-.6-4-1.5-4-3 0-1.7 1.8-3 4-3 1.4 0 2.7.6 3.7 1.7"/></svg></span><span class="menu-item-label">About Ubhaya</span><span class="menu-item-arrow">›</span></a></li>
            <li><a asp-controller="Contact" asp-action="Index" class="menu-item @(sideMenuController == "Contact" ? "is-current" : "")"><span class="menu-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 4.5 9 3l2 4-2 1.5c1 2.2 2.3 3.5 4.5 4.5L15 11l4 2-1.5 2.5C16.8 18 15.8 19 14 19c-4.8 0-9-4.2-9-9 0-1.8 1-2.8 1.5-5.5Z"/></svg></span><span class="menu-item-label">Contact</span><span class="menu-item-arrow">›</span></a></li>
        </ul>
        <a class="menu-help-link" asp-controller="Contact" asp-action="Index">
            <span class="menu-help-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.2a9 9 0 0 1-.9-4A8.4 8.4 0 0 1 12.5 3H13a8.4 8.4 0 0 1 8 8v.5Z"/><path d="M9 9.5a3 3 0 0 1 6 0c0 2-3 2-3 4M12 17h.01"/></svg></span>
            <span><strong>Need a hand?</strong><small>We’re here to help with your order</small></span>
            <span class="menu-help-arrow" aria-hidden="true">&#8250;</span>
        </a>
    </nav>
    <div class="side-menu-footer-note">UBHAYA FASHIONS <i></i> TRADITION MEETS TODAY</div>
</aside>
