            <li>
                <details class="menu-categories-dropdown">
                    <summary class="menu-item">
                        <span class="menu-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l1 4 3 3-4 2 3 7H6l3-7-4-2 3-3 1-4Z"/></svg></span>
