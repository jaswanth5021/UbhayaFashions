<!-- Mobile / slide-out navigation -->
<div class="menu-overlay" id="menuOverlay"></div>

@{ var sideMenuController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home"; }

<aside class="side-menu" id="sideMenu" aria-label="Ubhaya navigation">
    <div class="side-menu-header">
        <button id="menuClose" type="button" class="menu-close" aria-label="Close menu">×</button>
        <a class="side-menu-brand" asp-controller="Home" asp-action="Index" aria-label="Ubhaya Fashions home">
            <img src="~/images/logo.png" alt="UBHAYA FASHIONS" class="side-menu-brand-image" />
        </a>
        <button type="button" class="search-button" aria-label="Search" id="sideMenuSearch">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
        </button>
    </div>

    <div class="side-menu-tagline">TRADITION MEETS TODAY</div>

    <nav class="menu-navigation" aria-label="Mobile menu">
        <div class="menu-section-heading"><span>Explore</span><i></i></div>
        <ul class="menu-list">
            <li><a asp-controller="Products" asp-action="Index" class="menu-item @(sideMenuController == "Products" ? "is-current" : "")"><span class="menu-item-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg></span><span class="menu-item-label">View All Products</span><span class="menu-item-arrow" aria-hidden="true">›</span></a></li>
