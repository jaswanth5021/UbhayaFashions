@{
    var title = ViewData["Title"]?.ToString() ?? "Admin";
    var adminName = string.IsNullOrWhiteSpace(Context.Request.Cookies["admin_name"])
        ? "Administrator"
        : Context.Request.Cookies["admin_name"]!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Manage Ubhaya Fashions store operations." />
    <title>@title - Ubhaya Admin</title>
    <link rel="stylesheet" href="~/css/pages/admin/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/shared/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/shared/api-loader.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <partial name="_ApiLoader" />
    <partial name="_FlashMessages" />
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-controller="Admin" asp-action="Dashboard">UBHAYA <span>ADMIN</span></a>
            <nav aria-label="Admin navigation">
                <a asp-action="Dashboard">Dashboard</a>
                <a asp-action="Products">Products</a>
                <a asp-action="Categories">Categories</a>
                <a asp-action="StorefrontBanner">Homepage banner</a>
                <a asp-action="Inventory">Inventory</a>
                <a asp-action="Orders">Orders</a>
                <a asp-action="Customers">Customers</a>
                <a asp-action="Payments">Payments</a>
                <a asp-action="Logs">Error logs</a>
                @if (string.Equals(Context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value, "admin@ubhaya.com", StringComparison.OrdinalIgnoreCase)) { <a asp-action="AdminAccounts">Admin accounts</a> }
                <a asp-action="ChangePassword">Change password</a>
            </nav>
        </aside>
        <main class="admin-main">
            <header class="admin-top">
                <div class="admin-top-title"><span>UBHAYA FASHIONS</span><strong>Administration</strong></div>
                <div class="admin-user">
                    <span class="admin-user-avatar" aria-hidden="true">@adminName[..1].ToUpperInvariant()</span>
                    <span class="admin-user-name">@adminName</span>
                    <a class="admin-logout" asp-controller="Admin" asp-action="Logout">Logout</a>
                </div>
            </header>
            <div class="admin-content">@RenderBody()</div>
        </main>
    </div>
    <div class="app-notification-stack" id="appNotificationStack" aria-live="polite" aria-relevant="additions" aria-atomic="false"></div>
    <script src="~/js/app-notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
