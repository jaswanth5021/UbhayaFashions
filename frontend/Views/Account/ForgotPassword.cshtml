@model LadiesDressStore.Web.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; ViewData["MetaDescription"] = "Request a password reset for your Ubhaya Fashions account."; }
<div class="auth-card">
    <h1>Reset your password</h1>
    <p>Enter the email address linked to your account and we’ll send a reset link.</p>
    @if (TempData["PasswordResetSent"] is string sent) { <div class="success">@sent</div> }
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <label asp-for="Email">Email address</label>
        <input asp-for="Email" type="email" autocomplete="email" required />
        <span asp-validation-for="Email"></span>
        <button class="button full" type="submit">Send reset link</button>
    </form>
    <p class="center"><a asp-action="Login">Back to login</a></p>
</div>
