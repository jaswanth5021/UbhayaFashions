@model LadiesDressStore.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    ViewData["MetaDescription"] = "Securely reset your Ubhaya Fashions account password.";
    var emailSent = ViewBag.PasswordResetSent is true;
    var resetEmail = ViewBag.ResetEmail as string ?? Model.Email;
    var resendAt = ViewBag.ResendAvailableAt is long value ? value : 0L;
}
<section class="forgot-page">
    <div class="forgot-shell">
        <a class="forgot-brand" asp-controller="Home" asp-action="Index" aria-label="Ubhaya Fashions home">
            <span class="forgot-brand-mark">U</span>
            <span><strong>UBHAYA</strong><small>F A S H I O N S</small></span>
        </a>
        <div class="forgot-card">
            @if (emailSent)
            {
                <div class="forgot-icon success-icon" aria-hidden="true">✓</div>
                <p class="forgot-eyebrow">CHECK YOUR INBOX</p>
                <h1>Check your email</h1>
                <p class="forgot-intro">We've sent a secure password reset link to:</p>
                <div class="forgot-email">@resetEmail</div>
                <div class="forgot-notice" role="status">
                    <strong>Didn't receive the email?</strong>
                    <span>Check your spam folder, or request another link when the timer finishes.</span>
                </div>
                <form asp-action="ForgotPassword" method="post" class="forgot-resend-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Email" value="@resetEmail" />
                    <button class="forgot-submit" id="resendButton" type="submit" disabled>Resend email <span id="resendCountdown"></span></button>
                </form>
                <p class="forgot-footnote">For your security, reset links expire after one hour and can only be used once.</p>
            }
            else
            {
                <div class="forgot-icon" aria-hidden="true">✦</div>
                <p class="forgot-eyebrow">ACCOUNT RECOVERY</p>
                <h1>Reset your password</h1>
                <p class="forgot-intro">Enter the email address associated with your account. We'll send you a secure link to create a new password.</p>
                <div asp-validation-summary="ModelOnly" class="forgot-validation" role="alert"></div>
                <form asp-action="ForgotPassword" method="post" class="forgot-form">
                    @Html.AntiForgeryToken()
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" required />
                    <span asp-validation-for="Email" class="forgot-field-error"></span>
                    <button class="forgot-submit" type="submit">Send reset link <span aria-hidden="true">→</span></button>
                </form>
            }
            <a class="forgot-back" asp-action="Login"><span aria-hidden="true">←</span> Back to sign in</a>
        </div>
        <p class="forgot-security"><span aria-hidden="true">▣</span> Your account security matters to us.</p>
    </div>
</section>

<style>
    .forgot-page{min-height:calc(100vh - 100px);display:grid;place-items:center;padding:52px 18px;background:radial-gradient(circle at 15% 10%,#f3e8e5 0,transparent 32%),linear-gradient(135deg,#fbf8f5,#f5eeea);color:#292421}
    .forgot-shell{width:min(100%,490px)}
    .forgot-brand{display:flex;align-items:center;justify-content:center;gap:11px;margin:0 auto 25px;color:#542b35;text-decoration:none;width:max-content}
    .forgot-brand-mark{display:grid;place-items:center;width:43px;height:43px;border-radius:50%;background:#542b35;color:#f4dfbf;font-family:Georgia,serif;font-size:25px}
    .forgot-brand strong{display:block;font-family:Georgia,serif;font-size:18px;letter-spacing:1.5px}
    .forgot-brand small{display:block;margin-top:2px;font-size:8px;letter-spacing:3px}
    .forgot-card{padding:clamp(28px,6vw,48px);border:1px solid rgba(84,43,53,.09);border-radius:22px;background:rgba(255,255,255,.94);box-shadow:0 22px 65px rgba(57,35,36,.10)}
    .forgot-icon{display:grid;place-items:center;width:48px;height:48px;margin-bottom:22px;border-radius:15px;background:#f6edf0;color:#68142e;font-size:25px}
    .success-icon{background:#edf6ef;color:#287a45}
    .forgot-eyebrow{margin:0 0 9px;color:#9b6d68;font-size:10px;font-weight:800;letter-spacing:2.2px}
    .forgot-card h1{margin:0 0 13px;color:#292421;font-family:Georgia,'Times New Roman',serif;font-size:clamp(29px,5vw,36px);font-weight:500;line-height:1.15}
    .forgot-intro{margin:0 0 25px;color:#746b68;font-size:14px;line-height:1.75}
    .forgot-form label{display:block;margin:0 0 8px;color:#403738;font-size:13px;font-weight:700}
    .forgot-form input{box-sizing:border-box;width:100%;height:52px;padding:0 15px;border:1px solid #ddd2ce;border-radius:10px;background:#fff;color:#292421;font-size:14px;outline:none;transition:border-color .2s,box-shadow .2s}
    .forgot-form input:focus{border-color:#8a465d;box-shadow:0 0 0 4px rgba(104,20,46,.09)}
    .forgot-field-error,.forgot-validation{display:block;margin-top:7px;color:#b42318;font-size:12px}
    .forgot-submit{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:51px;margin-top:19px;border:0;border-radius:10px;background:#542b35;color:#fff;font-size:14px;font-weight:700;cursor:pointer;transition:background .2s,transform .2s}
    .forgot-submit:hover:not(:disabled){background:#68142e;transform:translateY(-1px)}
    .forgot-submit:disabled{background:#c9bfc0;color:#fff;cursor:not-allowed}
    .forgot-email{margin:-9px 0 22px;padding:13px 15px;border:1px solid #eadde0;border-radius:10px;background:#fcf7f8;color:#542b35;font-size:14px;font-weight:700;overflow-wrap:anywhere}
    .forgot-notice{display:grid;gap:5px;padding:15px;border-radius:11px;background:#f8f5f1;color:#665b57;font-size:12px;line-height:1.6}
    .forgot-notice strong{color:#433538;font-size:13px}
    .forgot-resend-form .forgot-submit{margin-top:16px}
    .forgot-footnote{margin:16px 0 0;color:#8a807c;font-size:11px;line-height:1.6;text-align:center}
    .forgot-back{display:flex;align-items:center;justify-content:center;gap:8px;margin:26px auto 0;color:#542b35;font-size:13px;font-weight:700;text-decoration:none}
    .forgot-back:hover{text-decoration:underline}
    .forgot-security{display:flex;justify-content:center;align-items:center;gap:7px;margin:20px 0 0;color:#8a807c;font-size:11px}
    @@media(max-width:480px){.forgot-page{min-height:calc(100vh - 70px);padding:32px 14px}.forgot-card{border-radius:17px}.forgot-brand{margin-bottom:19px}}
</style>
@if (emailSent)
{
<script>
(function () {
    const button = document.getElementById('resendButton');
    const countdown = document.getElementById('resendCountdown');
    if (!button || !countdown) return;
    const storageKey = 'ubhaya-password-reset-resend:' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resetEmail.ToLowerInvariant()));
    const serverDeadline = @resendAt;
    const storedDeadline = Number(sessionStorage.getItem(storageKey)) || 0;
    let deadline = Math.max(serverDeadline, storedDeadline);
    sessionStorage.setItem(storageKey, String(deadline));
    let timer = null;
    const tick = () => {
        const remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
        if (remaining <= 0) {
            button.disabled = false;
            button.innerHTML = 'Resend email <span aria-hidden="true">↻</span>';
            countdown.textContent = '';
            clearInterval(timer);
            return;
        }
        button.disabled = true;
        countdown.textContent = '(' + Math.floor(remaining / 60) + ':' + String(remaining % 60).padStart(2, '0') + ')';
    };
    tick();
    timer = setInterval(tick, 1000);
    button.form.addEventListener('submit', () => sessionStorage.removeItem(storageKey));
})();
</script>
}