@model LadiesDressStore.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    ViewData["MetaDescription"] = "Securely reset your Ubhaya Fashions account password.";
    var emailSent = ViewBag.PasswordResetSent is true;
    var resetEmail = ViewBag.ResetEmail as string ?? Model.Email;
    var resendAt = ViewBag.ResendAvailableAt is long value ? value : 0L;
}

<section class="login-showcase forgot-login-showcase" aria-labelledby="forgotShowcaseTitle">
    <div class="login-showcase-visual">
        <a class="login-showcase-brand" asp-controller="Home" asp-action="Index" aria-label="Ubhaya Fashions home">U</a>
        <div class="login-showcase-quote">
            <h1 id="forgotShowcaseTitle">Feel at home<br />in your style.</h1>
            <p>Thoughtfully chosen. Beautifully you.</p>
            <div class="login-showcase-signature">
                <span>COMFORT</span><i aria-hidden="true"></i><span>GRACE</span><i aria-hidden="true"></i><span>YOU</span>
            </div>
        </div>
        <span class="login-showcase-index" aria-hidden="true">UBHAYA FASHIONS · EST. WITH LOVE</span>
        <div class="login-showcase-benefits" aria-label="Shopping benefits">
            <div class="login-showcase-benefit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
                <span>Free Shipping<br />on orders ₹1,000+</span>
            </div>
            <div class="login-showcase-benefit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 20 5v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
                <span>Secure<br />Payment</span>
            </div>
            <div class="login-showcase-benefit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 3 6.2 6.8 1-4.9 4.8 1.2 6.8-6.1-3.2-6.1 3.2 1.2-6.8-4.9-4.8 6.8-1z"/></svg>
                <span>Premium<br />Quality</span>
            </div>
        </div>
    </div>

    <div class="login-showcase-panel forgot-showcase-panel">
        <div class="login-new-card forgot-login-card">
            @if (emailSent)
            {
                <div class="forgot-status-icon" aria-hidden="true">✓</div>
                <p class="login-new-eyebrow">EMAIL SENT</p>
                <h2>Check your inbox</h2>
                <p class="login-new-intro">We've sent a secure password reset link to the email address below.</p>
                <div class="forgot-login-email">@resetEmail</div>
                <div class="login-new-message is-success forgot-login-notice" role="status">
                    Please check your inbox and spam folder. The reset link is valid for one hour.
                </div>
                <form asp-action="ForgotPassword" method="post" class="forgot-login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Email" value="@resetEmail" />
                    <button type="submit" class="login-new-submit forgot-resend-submit" id="resendButton" disabled>
                        RESEND EMAIL <span id="resendCountdown"></span>
                    </button>
                </form>
                <p class="forgot-login-helper">You can request another link when the timer finishes.</p>
                <p class="forgot-edit-email-prompt">
                    Wrong email address?
                    <button type="button" class="forgot-edit-email-link" id="showEditEmail">Edit email address</button>
                </p>
                <div class="forgot-edit-email-panel" id="editEmailPanel" hidden>
                    <p class="login-new-eyebrow">UPDATE EMAIL ADDRESS</p>
                    <p class="login-new-intro">Enter the correct email address and we'll send a new reset link.</p>
                    <form asp-action="ForgotPassword" method="post" class="login-new-form forgot-login-form">
                        @Html.AntiForgeryToken()
                        <label asp-for="Email">Email address</label>
                        <input asp-for="Email" type="email" value="@resetEmail" autocomplete="email" placeholder="Enter your correct email address" required />
                        <span asp-validation-for="Email" class="login-new-field-error"></span>
                        <button type="submit" class="login-new-submit">SEND TO THIS EMAIL <span aria-hidden="true">→</span></button>
                    </form>
                    <button type="button" class="forgot-edit-email-cancel" id="cancelEditEmail">Cancel</button>
                </div>
            }
            else
            {
                <p class="login-new-eyebrow">ACCOUNT RECOVERY</p>
                <h2>Forgot password?</h2>
                <p class="login-new-intro">No worries. Enter the email address linked to your account and we'll send you a secure reset link.</p>
                @if (ViewBag.ResetRetryAfterSeconds is int retrySeconds && retrySeconds > 0)
                {
                    <div class="login-new-message forgot-rate-warning" role="alert">
                        <strong>Please wait before trying again.</strong>
                        <span>For your security, you can request another reset email in <span id="resetRetryCountdown">@TimeSpan.FromSeconds(retrySeconds).ToString(@"m\:ss")</span>.</span>
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="login-new-message is-error forgot-validation-summary" role="alert"></div>
                <form asp-action="ForgotPassword" method="post" class="login-new-form forgot-login-form">
                    @Html.AntiForgeryToken()
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="Enter your email address" required />
                    <span asp-validation-for="Email" class="login-new-field-error"></span>
                    <button type="submit" class="login-new-submit">SEND RESET LINK <span aria-hidden="true">→</span></button>
                </form>
            }
            <p class="login-new-signup forgot-login-back">
                <a asp-action="Login">← Back to sign in</a>
            </p>
            <div class="login-new-secure"><span aria-hidden="true">✦</span> Your account security matters to us.</div>
        </div>
    </div>
</section>

<style>

    .forgot-edit-email-prompt{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:5px;margin:15px 0 0;color:#807174;font-size:12px}
    .forgot-edit-email-link,.forgot-edit-email-cancel{padding:0;border:0;background:none;color:#68142e;font:inherit;font-weight:700;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
    .forgot-edit-email-panel{margin-top:20px;padding-top:19px;border-top:1px solid #eadfdb}
    .forgot-edit-email-panel[hidden]{display:none!important}
    .forgot-edit-email-panel .login-new-intro{margin-bottom:15px}
    .forgot-edit-email-cancel{display:block;margin:13px auto 0;text-decoration:none}
    .forgot-rate-warning{display:grid;gap:4px;margin-bottom:17px;border-color:#ead7b5;background:#fff8e9;color:#76531d}
    .forgot-rate-warning strong{font-size:13px;color:#684719}
    .forgot-rate-warning span{font-size:12px;line-height:1.55}
    .forgot-validation-summary ul{margin:0;padding-left:18px}
    .forgot-validation-summary li{font-size:12px;line-height:1.5}
    .forgot-login-showcase{min-height:590px}
    .forgot-login-showcase .login-showcase-visual{min-height:590px}
    .forgot-showcase-panel{min-width:0}
    .forgot-login-card{max-width:430px}
    .forgot-login-form{margin-top:4px}
    .forgot-login-form>input{margin-bottom:4px}
    .forgot-login-form .login-new-submit{width:100%;margin-top:18px}
    .forgot-login-email{margin:0 0 17px;padding:13px 14px;border:1px solid #ead7dc;border-radius:6px;background:#fbf5f6;color:#68142e;font-size:13px;font-weight:700;overflow-wrap:anywhere}
    .forgot-login-notice{margin-bottom:17px}
    .forgot-login-helper{margin:12px 0 0;color:#807174;font-size:11px;line-height:1.5;text-align:center}
    .forgot-login-back a{color:#68142e;font-size:12px;font-weight:650;text-decoration:none}
    .forgot-login-back a:hover{text-decoration:underline;text-underline-offset:3px}
    .forgot-resend-submit:disabled{opacity:.68;cursor:not-allowed;transform:none}
    .forgot-status-icon{display:grid;width:42px;height:42px;place-items:center;margin-bottom:19px;border:1px solid #c9dfcd;border-radius:50%;background:#f2faf3;color:#326440;font-size:21px}
    @@media(max-width:1000px){.forgot-login-showcase .login-showcase-visual{min-height:300px}}
    @@media(max-width:600px){.forgot-login-showcase .login-showcase-visual{min-height:310px}}
</style>

@if (emailSent)
{
<script>
(function () {
    const button = document.getElementById('resendButton');
    const countdown = document.getElementById('resendCountdown');
    if (!button || !countdown) return;
    const storageKey = 'ubhaya-password-reset-resend:' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resetEmail.ToLowerInvariant()));
    const serverDeadline = @resendAt;
    const storedDeadline = Number(sessionStorage.getItem(storageKey)) || 0;
    let deadline = Math.max(serverDeadline, storedDeadline);
    sessionStorage.setItem(storageKey, String(deadline));
    let timer = null;
    const tick = () => {
        const remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
        if (remaining <= 0) {
            button.disabled = false;
            button.innerHTML = 'RESEND EMAIL <span aria-hidden="true">↻</span>';
            countdown.textContent = '';
            clearInterval(timer);
            return;
        }
        button.disabled = true;
        countdown.textContent = '(' + Math.floor(remaining / 60) + ':' + String(remaining % 60).padStart(2, '0') + ')';
    };
    tick();
    timer = setInterval(tick, 1000);
    button.form.addEventListener('submit', () => sessionStorage.removeItem(storageKey));
})();
</script>
}
@if (ViewBag.ResetRetryAfterSeconds is int countdownRetrySeconds && countdownRetrySeconds > 0)
{
<script>
(function () {
    const output = document.getElementById('resetRetryCountdown');
    if (!output) return;
    let remaining = @countdownRetrySeconds;
    const timer = setInterval(() => {
        remaining = Math.max(0, remaining - 1);
        output.textContent = Math.floor(remaining / 60) + ':' + String(remaining % 60).padStart(2, '0');
        if (remaining <= 0) clearInterval(timer);
    }, 1000);
})();
</script>
}


@if (emailSent)
{
<script>
(function () {
    const sentState = document.querySelector('.forgot-login-card');
    const panel = document.getElementById('editEmailPanel');
    const showButton = document.getElementById('showEditEmail');
    const cancelButton = document.getElementById('cancelEditEmail');
    if (!sentState || !panel || !showButton || !cancelButton) return;
    const sentElements = Array.from(sentState.children).filter(element => element !== panel);
    const showEditor = () => {
        sentElements.forEach(element => element.hidden = true);
        panel.hidden = false;
        const emailInput = panel.querySelector('input[type="email"]');
        if (emailInput) { emailInput.focus(); emailInput.select(); }
    };
    const showConfirmation = () => {
        panel.hidden = true;
        sentElements.forEach(element => element.hidden = false);
    };
    showButton.addEventListener('click', showEditor);
    cancelButton.addEventListener('click', showConfirmation);
})();
</script>
}
