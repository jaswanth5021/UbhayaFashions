@model LadiesDressStore.Web.Models.SignupViewModel

@{
    ViewData["Title"] = "Create Account";
}

<main class="auth-card signup-card">
    <div class="signup-heading">
        <span class="signup-eyebrow">UBHAYA FASHIONS</span>
        <h1>Create your account</h1>
        <p>Join us for a more personal shopping experience. You can verify your email later from your profile.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="error signup-validation-summary"></div>

    <form asp-action="Signup" method="post" class="signup-form">
        @Html.AntiForgeryToken()

        <div class="signup-field">
            <label asp-for="Name">Full name</label>
            <input asp-for="Name" autocomplete="name" placeholder="Your name" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="signup-field">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" autocomplete="email" placeholder="you@example.com" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="signup-field">
            <label asp-for="Mobile">Mobile number</label>
            <input asp-for="Mobile" type="tel" autocomplete="tel" placeholder="+91 98765 43210" />
            <span asp-validation-for="Mobile"></span>
        </div>

        <div class="signup-field">
            <label asp-for="Age">Age</label>
            <input asp-for="Age" type="number" min="18" max="120" />
            <span asp-validation-for="Age"></span>
        </div>

        <div class="signup-field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
        </div>

        <div class="signup-field">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button class="button full signup-submit" type="submit">Create account</button>
    </form>

    <p class="signup-login">Already have an account? <a asp-action="Login">Log in</a></p>
</main>
