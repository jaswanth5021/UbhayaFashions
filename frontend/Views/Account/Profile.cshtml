@model LadiesDressStore.Web.Models.ProfileViewModel
@using LadiesDressStore.Web.Models
@{
    ViewData["Title"] = "My Profile";
    var addresses = ViewBag.SavedAddresses as List<SavedAddressViewModel> ?? [];
    var activeTab = ViewBag.ActiveTab as string ?? "details";
    var firstLetter = string.IsNullOrWhiteSpace(Model.Name) ? "U" : Model.Name.Trim()[0].ToString().ToUpperInvariant();
}

<div class="profile-page">
    <section class="profile-card profile-account-card">
        <header class="profile-header">
            <div class="profile-avatar">@firstLetter</div>
            <div class="profile-heading">
                <span class="profile-eyebrow">ACCOUNT</span>
                <h1>@(activeTab == "addresses" ? "Your Addresses" : activeTab == "orders" ? "My Orders" : "My Profile")</h1>
                <p>@(activeTab == "addresses" ? "Manage the addresses you use for delivery." : activeTab == "orders" ? "Track your purchases and review your order history." : "Manage your personal information, delivery addresses, and password.")</p>
            </div>
        </header>

        @if (TempData["ProfileSuccess"] is string success) { <div class="profile-success">@success</div> }
        @if (TempData["ProfileError"] is string error) { <div class="profile-error">@error</div> }
        @if (!string.IsNullOrWhiteSpace(ViewBag.Error)) { <div class="profile-error">@ViewBag.Error</div> }

        <nav class="profile-tabs" aria-label="Profile sections">
            <a class="@(activeTab == "details" ? "is-active" : "")" asp-action="Profile" asp-route-tab="details">Personal details</a>
            <a class="@(activeTab == "addresses" ? "is-active" : "")" asp-action="Profile" asp-route-tab="addresses">My addresses</a>
            <a class="@(activeTab == "orders" ? "is-active" : "")" asp-action="Profile" asp-route-tab="orders">My orders</a>
            <a class="@(activeTab == "security" ? "is-active" : "")" asp-action="Profile" asp-route-tab="security">Password &amp; security</a>
        </nav>

        @if (activeTab == "addresses")
        {
            <section class="profile-tab-panel">
                <div class="profile-panel-heading"><h2>Your Addresses</h2><p>Choose an address for your deliveries or add a new one.</p></div>
                @if (!string.IsNullOrWhiteSpace(ViewBag.AddressLoadError))
                {
                    <div class="profile-error">@ViewBag.AddressLoadError</div>
                }
                <div class="profile-address-list">
                    <details class="profile-address-card profile-add-address">
                        <summary><span aria-hidden="true">+</span><strong>Add address</strong></summary>
                        <div class="profile-address-editor">
                            <h3>New address</h3>
                            <form asp-action="SaveAddress" method="post" class="profile-address-form">
                                @Html.AntiForgeryToken()
                                <div class="profile-form-grid">
                                    <label>Name<input name="Name" value="@Model.Name" required maxlength="150" /></label>
                                    <label>Mobile<input name="Mobile" value="@Model.Mobile" required type="tel" /></label>
                                    <label class="profile-field-wide">House / street<input name="AddressLine1" required maxlength="500" /></label>
                                    <label class="profile-field-wide">Area / landmark<input name="AddressLine2" maxlength="500" /></label>
                                    <label>City<input name="City" required /></label>
                                    <label>State<input name="State" required /></label>
                                    <label>PIN code<input name="PostalCode" required /></label>
                                    <label>Country<input name="Country" value="India" required /></label>
                                </div>
                                <label class="profile-default-option"><input type="checkbox" name="IsDefault" value="true" /> Make this my default address</label>
                                <button class="profile-save-button" type="submit">Add address</button>
                            </form>
                        </div>
                    </details>
                    @foreach (var address in addresses)
                    {
                        <article class="profile-address-card">
                            @if (address.IsDefault) { <span class="profile-default-badge">Default</span> }
                            <div class="profile-address-summary">
                                <strong>@address.Name</strong>
                                <span>@address.AddressLine1</span>
                                @if (!string.IsNullOrWhiteSpace(address.AddressLine2)) { <span>@address.AddressLine2</span> }
                                <span>@address.City, @address.State @address.PostalCode</span>
                                <span>@address.Country</span>
                                <span>Phone number: @address.Mobile</span>
                                <span class="profile-delivery-note">Add delivery instructions</span>
                            </div>
                            <div class="profile-address-actions">
                                <details class="profile-edit-address">
                                    <summary>Edit</summary>
                                    <div class="profile-address-editor">
                                        <form asp-action="SaveAddress" method="post" class="profile-address-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@address.Id" />
                                            <div class="profile-form-grid">
                                                <label>Name<input name="Name" value="@address.Name" required maxlength="150" /></label>
                                                <label>Mobile<input name="Mobile" value="@address.Mobile" required type="tel" /></label>
                                                <label class="profile-field-wide">House / street<input name="AddressLine1" value="@address.AddressLine1" required maxlength="500" /></label>
                                                <label class="profile-field-wide">Area / landmark<input name="AddressLine2" value="@address.AddressLine2" maxlength="500" /></label>
                                                <label>City<input name="City" value="@address.City" required /></label>
                                                <label>State<input name="State" value="@address.State" required /></label>
                                                <label>PIN code<input name="PostalCode" value="@address.PostalCode" required /></label>
                                                <label>Country<input name="Country" value="@address.Country" required /></label>
                                            </div>
                                            <label class="profile-default-option"><input type="checkbox" name="IsDefault" value="true" checked="@(address.IsDefault ? "checked" : null)" /> Make this my default address</label>
                                            <button class="profile-save-button" type="submit">Save address</button>
                                        </form>
                                    </div>
                                </details>
                                <span aria-hidden="true">|</span>
                            <form asp-action="DeleteAddress" method="post" class="profile-address-delete">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@address.Id" />
                                <button type="submit">Remove address</button>
                            </form>
                                @if (!address.IsDefault)
                                {
                                    <span aria-hidden="true">|</span>
                                    <form asp-action="SaveAddress" method="post" class="profile-set-default">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@address.Id" />
                                        <input type="hidden" name="Name" value="@address.Name" />
                                        <input type="hidden" name="Mobile" value="@address.Mobile" />
                                        <input type="hidden" name="AddressLine1" value="@address.AddressLine1" />
                                        <input type="hidden" name="AddressLine2" value="@address.AddressLine2" />
                                        <input type="hidden" name="City" value="@address.City" />
                                        <input type="hidden" name="State" value="@address.State" />
                                        <input type="hidden" name="PostalCode" value="@address.PostalCode" />
                                        <input type="hidden" name="Country" value="@address.Country" />
                                        <input type="hidden" name="IsDefault" value="true" />
                                        <button type="submit">Set as Default</button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        else if (activeTab == "orders")
        {
            var orders = ViewBag.MyOrders as List<MyOrderViewModel> ?? [];
            <section class="profile-tab-panel profile-orders-panel">
                <div class="profile-panel-heading"><h2>Order history</h2><p>Review your purchases, order status, and payment details.</p></div>
                @if (!string.IsNullOrWhiteSpace(ViewBag.OrderLoadError))
                {
                    <div class="profile-error">@ViewBag.OrderLoadError</div>
                }
                else if (orders.Count == 0)
                {
                    <div class="profile-orders-empty">
                        <span aria-hidden="true">♡</span>
                        <h3>No orders yet</h3>
                        <p>Once you place an order, its status and details will appear here.</p>
                        <a asp-controller="Products" asp-action="Index" class="profile-orders-shop">Explore the collection</a>
                    </div>
                }
                else
                {
                    <div class="orders-toolbar" aria-label="Order filters and sorting">
                        <div class="orders-filter-tabs" role="group" aria-label="Filter orders">
                            <button type="button" class="orders-filter-tab is-active" data-order-filter="all" aria-pressed="true">All <span>@orders.Count</span></button>
                            <button type="button" class="orders-filter-tab" data-order-filter="paid" aria-pressed="false">Paid</button>
                            <button type="button" class="orders-filter-tab" data-order-filter="pending" aria-pressed="false">Pending</button>
                            <button type="button" class="orders-filter-tab" data-order-filter="processing" aria-pressed="false">Processing</button>
                            <button type="button" class="orders-filter-tab" data-order-filter="delivered" aria-pressed="false">Delivered</button>
                        </div>
                        <label class="orders-sort" for="profileOrdersSort"><span>Sort</span>
                            <select id="profileOrdersSort">
                                <option value="newest">Newest first</option>
                                <option value="oldest">Oldest first</option>
                                <option value="high">Highest amount</option>
                                <option value="low">Lowest amount</option>
                            </select>
                        </label>
                        <span class="profile-orders-match-count" id="profileOrdersMatchCount" aria-live="polite">@orders.Count orders</span>
                    </div>

                    <div class="orders-list profile-orders-list" id="profileOrdersList">
                        @foreach (var order in orders)
                        {
                            var statusClass = (order.Status ?? "").ToLowerInvariant().Replace(" ", "-");
                            var paymentClass = (order.PaymentStatus ?? "").ToLowerInvariant().Replace(" ", "-");
                            var isPaid = string.Equals(order.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
                            <article class="profile-order-card order-card"
                                     data-profile-order-card
                                     data-order-status="@((order.Status ?? "").ToLowerInvariant())"
                                     data-payment-status="@((order.PaymentStatus ?? "").ToLowerInvariant())"
                                     data-order-date="@order.CreatedDate.UtcDateTime.Ticks"
                                     data-order-total="@order.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <header class="profile-order-header">
                                    <div><span>ORDER #@order.Id</span><time datetime="@order.CreatedDate.ToString("O")">@order.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</time></div>
                                    <div class="order-card-heading-right">
                                        <strong class="order-card-total">₹@order.TotalAmount.ToString("N0")</strong>
                                        <button type="button" class="order-view-toggle" data-profile-order-toggle aria-expanded="false">View details <span aria-hidden="true">⌄</span></button>
                                    </div>
                                </header>
                                <div class="profile-order-badges">
                                    <span class="order-status-pill @statusClass">@order.Status</span>
                                    <span class="order-payment-pill @paymentClass">Payment: @order.PaymentStatus</span>
                                </div>
                                <div class="profile-order-details" data-profile-order-details hidden>
                                    <div class="profile-order-items">
                                        @foreach (var item in order.Items)
                                        {
                                            <div class="profile-order-item">
                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                {
                                                    <img src="@ImageUrlHelper.Resolve(item.ImageUrl, Configuration["ApiBaseUrl"])" alt="@item.ProductName" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span class="profile-order-image-placeholder" aria-hidden="true">U</span>
                                                }
                                                <span class="profile-order-item-info"><strong>@item.ProductName</strong><small>Size: @item.Size · Qty: @item.Quantity</small></span>
                                                <div class="order-item-actions">
                                                    <strong class="profile-order-item-price">₹@((item.Price * item.Quantity).ToString("N0"))</strong>
                                                    @if (isPaid)
                                                    {
                                                        <a class="order-review-button" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" asp-fragment="productReviews"><span aria-hidden="true">☆</span> Review</a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <footer class="profile-order-footer">
                                        <span><small>Delivery address</small>@order.ShippingAddress</span>
                                        @if (!string.IsNullOrWhiteSpace(order.RazorpayOrderId)) { <small>Payment reference: @order.RazorpayOrderId</small> }
                                    </footer>
                                </div>
                            </article>
                        }
                    </div>
                    <div class="orders-filter-empty" id="profileOrdersFilterEmpty" hidden>
                        <span aria-hidden="true">⌕</span>
                        <h2>No matching orders</h2>
                        <p>Try another filter to see more of your order history.</p>
                    </div>
                }
            </section>
        }
        else if (activeTab == "security")
        {
            <section class="profile-tab-panel">
                <div class="profile-panel-heading"><h2>Change password</h2><p>Use a unique password with at least 8 characters.</p></div>
                <form asp-action="ChangePassword" method="post" class="profile-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="profile-error"></div>
                    <div class="profile-field"><label for="CurrentPassword">Current password</label><input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required /></div>
                    <div class="profile-field"><label for="NewPassword">New password</label><input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required /></div>
                    <div class="profile-field"><label for="ConfirmPassword">Confirm new password</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required /></div>
                    <button class="profile-save-button" type="submit">Update password</button>
                </form>
                <p class="profile-reset-note">Forgot your current password? <a asp-action="ForgotPassword">Reset it by email</a>.</p>
            </section>
        }
        else
        {
            <section class="profile-tab-panel">
                <div class="profile-panel-heading"><h2>Personal details</h2><p>Keep your account information up to date.</p></div>
                <form asp-action="Profile" method="post" class="profile-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="profile-error"></div>
                    <div class="profile-form-grid">
                        <label class="profile-field">Full name<input asp-for="Name" autocomplete="name" required /></label>
                        <label class="profile-field">Email address<input asp-for="Email" readonly class="profile-readonly" autocomplete="email" /><small class="profile-help">Contact support to change your email address.</small></label>
                        <label class="profile-field">Mobile number<input asp-for="Mobile" type="tel" autocomplete="tel" /></label>
                        <label class="profile-field">Age<input asp-for="Age" type="number" min="18" max="120" /></label>
                        <label class="profile-field">Date of birth<input asp-for="DateOfBirth" type="date" /></label>
                        <label class="profile-field">Gender <select asp-for="Gender"><option value="">Prefer not to say</option><option>Woman</option><option>Man</option><option>Non-binary</option><option>Self-describe</option></select></label>
                    </div>
                    <button class="profile-save-button" type="submit">Save changes</button>
                </form>
                    <div class="profile-email-verification">
                        @if (Model.EmailVerified)
                        {
                            <p><strong>Email verified</strong></p>
                        }
                        else
                        {
                            <p>Your email is not verified yet.</p>
                            <form asp-action="SendEmailVerification" method="post">
                                @Html.AntiForgeryToken()
                                <button class="profile-save-button" type="submit">Send verification code</button>
                            </form>
                            <form asp-action="ConfirmEmailVerification" method="post" class="profile-form" style="margin-top:16px">
                                @Html.AntiForgeryToken()
                                <div class="profile-field"><label for="EmailVerificationCode">6-digit verification code</label><input id="EmailVerificationCode" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required /></div>
                                <button class="profile-save-button" type="submit">Verify email</button>
                            </form>
                        }
                    </div>
            </section>
        }

        <div class="profile-actions">
            <a asp-controller="Home" asp-action="Index" class="profile-shopping-link">← Continue shopping</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="profile-logout-button">Logout</button>
            </form>
        </div>
    </section>
</div>

@if (activeTab == "orders")
{
    <script>
        (() => {
            const list = document.getElementById('profileOrdersList');
            if (!list) return;

            const cards = [...list.querySelectorAll('[data-profile-order-card]')];
            const filterButtons = [...document.querySelectorAll('[data-order-filter]')];
            const sort = document.getElementById('profileOrdersSort');
            const matchCount = document.getElementById('profileOrdersMatchCount');
            const emptyState = document.getElementById('profileOrdersFilterEmpty');
            let activeFilter = 'all';

            const matches = card => {
                const orderStatus = (card.dataset.orderStatus || '').trim().toLowerCase();
                const paymentStatus = (card.dataset.paymentStatus || '').trim().toLowerCase();
                switch (activeFilter) {
                    case 'paid': return paymentStatus === 'paid';
                    case 'pending': return paymentStatus === 'pending' || orderStatus === 'pending';
                    case 'processing': return orderStatus === 'processing';
                    case 'delivered': return orderStatus === 'delivered';
                    default: return true;
                }
            };

            const apply = () => {
                const visible = cards.filter(matches);
                visible.sort((a, b) => {
                    if (sort?.value === 'oldest') return Number(a.dataset.orderDate) - Number(b.dataset.orderDate);
                    if (sort?.value === 'high') return Number(b.dataset.orderTotal) - Number(a.dataset.orderTotal);
                    if (sort?.value === 'low') return Number(a.dataset.orderTotal) - Number(b.dataset.orderTotal);
                    return Number(b.dataset.orderDate) - Number(a.dataset.orderDate);
                });

                visible.forEach(card => list.appendChild(card));
                cards.forEach(card => { card.hidden = !visible.includes(card); });
                if (matchCount) matchCount.textContent = visible.length === 1 ? '1 order' : `${visible.length} orders`;
                if (emptyState) emptyState.hidden = visible.length !== 0;
            };

            filterButtons.forEach(button => button.addEventListener('click', () => {
                activeFilter = button.dataset.orderFilter || 'all';
                filterButtons.forEach(item => {
                    const selected = item === button;
                    item.classList.toggle('is-active', selected);
                    item.setAttribute('aria-pressed', selected ? 'true' : 'false');
                });
                apply();
            }));

            sort?.addEventListener('change', apply);
            list.addEventListener('click', event => {
                const button = event.target.closest('[data-profile-order-toggle]');
                if (!button) return;
                const card = button.closest('[data-profile-order-card]');
                const details = card?.querySelector('[data-profile-order-details]');
                if (!details) return;
                const open = details.hidden;
                details.hidden = !open;
                button.setAttribute('aria-expanded', open ? 'true' : 'false');
                button.innerHTML = open ? 'Hide details <span aria-hidden="true">⌃</span>' : 'View details <span aria-hidden="true">⌄</span>';
            });

            apply();
        })();
    </script>
}
