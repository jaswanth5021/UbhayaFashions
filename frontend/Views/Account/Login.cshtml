@model LadiesDressStore.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">

    <h1>Welcome back</h1>

    <p>
        Login to continue shopping.
    </p>

    @if (TempData["SuccessMessage"] is string loginSuccess)
    {
        <div class="success">@loginSuccess</div>
    }
    @if (TempData["SignupSuccess"] is string signupSuccess)
    {
        <div class="success">@signupSuccess</div>
    }


    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="success">
            @success
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="error">
            @ViewBag.Error
        </div>
    }


    <div asp-validation-summary="ModelOnly"
         class="error">
    </div>


    <form asp-action="Login"
          method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />


        <label asp-for="Identifier">Email or mobile number</label>

        <input asp-for="Identifier" autocomplete="username" placeholder="Email address or mobile number" />

        <span asp-validation-for="Identifier">
        </span>


        <label asp-for="Password">
        </label>

        <input asp-for="Password" autocomplete="current-password" />

        <span asp-validation-for="Password">
        </span>

        <div class="auth-forgot-link"><a asp-action="ForgotPassword">Forgot password?</a></div>


        <button class="button full"
                type="submit">

            Login

        </button>

    </form>


    <div class="divider">
        OR
    </div>


    <a class="social google"
       asp-action="Google">

        Continue with Google

    </a>


    <a class="social facebook"
       asp-action="Facebook">

        Continue with Facebook

    </a>


    <p class="center">

        Don't have an account?

        <a asp-action="Signup">
            Create one
        </a>

    </p>

</div>
