@model LadiesDressStore.Web.Models.VerifySignupEmailViewModel
@{
    ViewData["Title"] = "Verify your email";
}

<div class="auth-card">
    <h1>Verify your email</h1>
    <p>Enter the 6-digit code we sent to <strong>@Model.Email</strong>. The code expires after 10 minutes.</p>

    @if (TempData["SignupCodeSent"] is string sent)
    {
        <div class="success" role="status">@sent</div>
    }
    @if (TempData["SignupCodeError"] is string resendError)
    {
        <div class="error" role="alert">@resendError</div>
    }

    <div asp-validation-summary="ModelOnly" class="error"></div>
    <form asp-action="VerifySignupEmail" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Email" type="hidden" />
        <label asp-for="Code">Verification code</label>
        <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" autofocus required />
        <span asp-validation-for="Code"></span>
        <button class="button full" type="submit">Verify email</button>
    </form>

    <form asp-action="ResendSignupCode" method="post" class="verify-resend-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@Model.Email" />
        <button type="submit">Send a new code</button>
    </form>
</div>
