@model LadiesDressStore.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set a new password";
    ViewData["MetaDescription"] = "Choose a new password for your Ubhaya Fashions account.";
}
<section class="password-reset-page">
    <div class="password-reset-art" aria-hidden="true">
        <div class="password-reset-monogram">U</div>
        <span class="password-reset-kicker">UBHAYA FASHIONS</span>
        <p>Tradition meets today.</p>
        <div class="password-reset-art-line"></div>
        <small>A thoughtful touch to your everyday style</small>
    </div>
    <div class="password-reset-card">
        <div class="password-reset-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 14v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </div>
        <span class="password-reset-eyebrow">ACCOUNT SECURITY</span>
        <h1>Create a new password</h1>
        <p class="password-reset-intro">Choose a strong password to keep your Ubhaya Fashions account safe.</p>
        <div asp-validation-summary="ModelOnly" class="password-reset-validation" role="alert"></div>
        <form asp-action="ResetPassword" method="post" class="password-reset-form">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters" />
            <span asp-validation-for="NewPassword" class="password-reset-field-error"></span>
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required placeholder="Enter your new password again" />
            <span asp-validation-for="ConfirmPassword" class="password-reset-field-error"></span>
            <button type="submit">UPDATE PASSWORD <span aria-hidden="true">→</span></button>
        </form>
        <div class="password-reset-footnote"><span aria-hidden="true">✦</span> Your password is protected and never shown to anyone.</div>
        <a class="password-reset-back" asp-action="Login">← Back to sign in</a>
    </div>
</section>
