# Copy to backend.production.env and set real values on the deployment host only.
ConnectionStrings__DefaultConnection=Server=db;Database=UbhayaFashions;User Id=ubhaya_app;Password=SET_ON_HOST;Encrypt=True;TrustServerCertificate=False
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=UbhayaFashions
Jwt__Audience=UbhayaFashionsCustomers
FrontendUrl=https://YOUR_STORE_DOMAIN
Razorpay__KeyId=SET_LIVE_KEY_ID
Razorpay__KeySecret=SET_LIVE_SECRET
Razorpay__WebhookSecret=SET_WEBHOOK_SECRET
Delhivery__Environment=Production
Delhivery__ApiToken=SET_LIVE_TOKEN
Delhivery__ClientName=SET_REGISTERED_CLIENT
Delhivery__PickupLocationName=SET_REGISTERED_PICKUP
Delhivery__SellerName=SET_SELLER_NAME
Delhivery__SellerAddress=SET_SELLER_ADDRESS
Delhivery__SellerPin=SET_SELLER_PIN
Delhivery__SellerPhone=SET_SELLER_PHONE
Smtp__Host=SET_SMTP_HOST
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=SET_SMTP_USER
Smtp__Password=SET_SMTP_PASSWORD
Smtp__From=SET_SENDER_EMAIL
# Set the actual frontend container/server IP; add another indexed entry for the ingress proxy.
ReverseProxy__KnownProxies__0=SET_FRONTEND_IP
ReverseProxy__KnownProxies__1=SET_INGRESS_IP
