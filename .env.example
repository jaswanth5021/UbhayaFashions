# ==============================================================================
# UBHAYA FASHIONS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual secrets
# NEVER commit the .env file to version control!
#
# Generate strong secrets using:
#   - Database password: openssl rand -base64 32
#   - JWT secret key:    openssl rand -base64 48
# ==============================================================================

# Database Configuration
# Minimum 16 characters, include uppercase, lowercase, numbers, and symbols
DB_PASSWORD=ChangeThisToAStrongRandomPassword123!@#

# JWT Secret Key
# Must be at least 32 characters, recommended 64+ for production
JWT_SECRET_KEY=ChangeThisToALongRandomSecretAtLeast64CharactersForProduction

# Frontend URL (for CORS)
# Set this to your actual domain in production
FRONTEND_URL=https://ubhaya1.duckdns.org

# Razorpay Payment Gateway
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# SMTP Email Configuration (Optional - for order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_ENABLE_SSL=true

# Delhivery Shipping API (Optional)
DELHIVERY_API_KEY=your-delhivery-api-key
DELHIVERY_BASE_URL=https://staging-express.delhivery.com/

# Google OAuth (Optional - for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (Optional - for social login)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
